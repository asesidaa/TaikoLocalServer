@* Access › Sessions: every signed-in Web UI device. Signing one out takes effect on its next request. *@
@inject HttpClient Client
@inject ToastService Toast

<section class="@Css.Card p-5 sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h2 class="font-semibold">@Localizer["Sessions"]</h2>
            <p class="text-sm @Css.Muted">@Localizer["Signed-in Web UI devices, active in the last week."]</p>
        </div>
        <button class="@Css.GhostButton border border-red-500/40 !text-red-600 dark:!text-red-400" disabled="@(sessions is null || sessions.All(s => s.IsCurrent))" @onclick="() => confirmAll = true">
            <Icon Name="logOut" />@Localizer["Sign out everyone else"]
        </button>
    </div>
    @if (sessions is null)
    {
        <div class="mt-4"><Skeleton /></div>
    }
    else
    {
        <ul class="mt-3 divide-y divide-zinc-100 dark:divide-zinc-800">
            @foreach (var s in sessions)
            {
                <li class="flex flex-wrap items-center gap-x-3 gap-y-0.5 py-2.5 text-sm">
                    <Icon Name="laptop" Class="size-4 text-zinc-400" />
                    <span class="font-medium">@s.Name</span>
                    <span class="@Css.Muted" title="@s.UserAgent">@SignInsTab.Device(s.UserAgent) · @s.Ip</span>
                    <span class="ml-auto text-xs @Css.Muted">@string.Format(Localizer["Signed in {0} · active {1}"], s.CreatedAt.ToLocalTime().ToString("g"), s.LastSeenAt.ToLocalTime().ToString("g"))</span>
                    @if (s.IsCurrent)
                    {
                        <span class="rounded-full bg-primary-500/10 px-2 py-0.5 text-[11px] font-medium text-primary-700 dark:text-primary-300" title="@Localizer["Use Log out to end it."]">@Localizer["This device"]</span>
                    }
                    else
                    {
                        <button class="@Css.GhostButton !px-2.5 !py-1 text-xs" @onclick="() => Revoke(s)">@Localizer["Sign out"]</button>
                    }
                </li>
            }
        </ul>
    }
</section>

@if (confirmAll)
{
    <Dialog Title="@Localizer["Sign out everyone else"]" Alert OnClose="() => confirmAll = false">
        <ChildContent>@Localizer["Every other Web UI session ends now. Passwords still work, so people can sign in again."]</ChildContent>
        <Footer>
            <button class="@Css.GhostButton" @onclick="() => confirmAll = false">@Localizer["Cancel"]</button>
            <button class="inline-flex items-center gap-1.5 rounded-xl bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700" @onclick="RevokeOthers">@Localizer["Sign out everyone else"]</button>
        </Footer>
    </Dialog>
}

@code {
    private List<SessionItem>? sessions;
    private bool confirmAll;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load() => sessions = await Client.GetFromJsonAsync<List<SessionItem>>("api/Sessions");

    private async Task Revoke(SessionItem s)
    {
        var res = await Client.DeleteAsync($"api/Sessions/{s.Id}");
        if (!res.IsSuccessStatusCode) { Toast.Show(Localizer["Save Failed"], true); return; }
        await Load();
    }

    private async Task RevokeOthers()
    {
        confirmAll = false;
        var res = await Client.PostAsync("api/Sessions/RevokeOthers", null);
        if (!res.IsSuccessStatusCode) { Toast.Show(Localizer["Save Failed"], true); return; }
        Toast.Show(Localizer["Signed out everyone else"]);
        await Load();
    }
}
