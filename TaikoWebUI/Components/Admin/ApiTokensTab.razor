@* Access › API tokens: admins' tokens for bots, leaderboard sites and scripts. A token acts as the admin who made it,
   limited to its scopes; the secret is shown once. *@
@inject HttpClient Client
@inject IJSRuntime Js
@inject ToastService Toast

<div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-4 text-sm dark:border-zinc-800 dark:bg-zinc-900/50">
    <p>@Localizer["Api Tokens Hint"]</p>
    <p class="mt-1 @Css.Muted">
        @if (list is { Enabled: false })
        {
            @((MarkupString)string.Format(Localizer["Api Tokens Off Hint"], "<code class=\"font-mono text-xs\">\"ApiTokens\": true</code>", "<code class=\"font-mono text-xs\">Host/Configurations/ServerSettings.json</code>"))
        }
        else
        {
            @Localizer["API tokens are on (ServerSettings.ApiTokens)."]
        }
    </p>
</div>

<section class="@Css.Card mt-4 p-5 sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-semibold">@Localizer["API tokens"]</h2>
        <button class="@Css.PrimaryButton" @onclick="OpenCreate"><Icon Name="plus" />@Localizer["New token"]</button>
    </div>
    @if (list is null)
    {
        <div class="mt-4"><Skeleton /></div>
    }
    else if (list.Tokens.Count == 0)
    {
        <p class="mt-4 text-sm @Css.Muted">@Localizer["No tokens yet."]</p>
    }
    else
    {
        <ul class="mt-3 divide-y divide-zinc-100 dark:divide-zinc-800">
            @foreach (var t in list.Tokens.OrderBy(t => !Active(t)).ThenByDescending(t => t.CreatedAt))
            {
                var active = Active(t);
                <li class="flex flex-wrap items-center gap-x-3 gap-y-1.5 py-3 text-sm @(active ? "" : "opacity-60")">
                    <span class="font-medium">@t.Name</span>
                    <span class="font-mono text-xs @Css.Muted">@t.Prefix…</span>
                    <span class="text-xs @Css.Muted">@string.Format(Localizer["by {0}"], t.CreatedByName ?? $"Baid {t.CreatedByBaid}")</span>
                    <span class="flex flex-wrap gap-1">
                        @foreach (var s in t.Scopes)
                        {
                            <span class="rounded-md px-1.5 py-0.5 font-mono text-[11px] @(s.StartsWith("admin:") ? "bg-primary-500/10 text-primary-700 dark:text-primary-300" : "bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300")">@s</span>
                        }
                    </span>
                    <span class="ml-auto flex flex-wrap items-center gap-x-3 text-xs @Css.Muted">
                        <span>@string.Format(Localizer["Created {0}"], t.CreatedAt.ToLocalTime().ToString("d"))</span>
                        <span class="rounded-full px-2 py-0.5 text-[11px] font-medium @(active ? "bg-zinc-100 dark:bg-zinc-800" : "bg-red-500/10 text-red-700 dark:text-red-400")">@ExpiryText(t)</span>
                        <span>@(t.LastUsedAt is { } used ? string.Format(Localizer["Used {0} from {1}"], used.ToLocalTime().ToString("g"), t.LastUsedIp) : Localizer["Never used"])</span>
                    </span>
                    @if (active)
                    {
                        <button class="@Css.GhostButton !px-2.5 !py-1 text-xs !text-red-600 dark:!text-red-400" @onclick="() => revoking = t">@Localizer["Revoke"]</button>
                    }
                    else
                    {
                        <button class="@Css.GhostButton !px-2.5 !py-1 text-xs" @onclick="() => Delete(t)">@Localizer["Remove"]</button>
                    }
                </li>
            }
        </ul>
    }
</section>

@if (creating)
{
    <Dialog Title="@Localizer["New API token"]" Width="max-w-md" OnClose="() => creating = false">
        <ChildContent>
            <label class="mt-3 block"><span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Name"]</span>
                <input class="@Css.Input mt-1.5" maxlength="60" autofocus placeholder="@Localizer["What uses it, e.g. Discord bot"]" value="@name" @oninput="e => name = e.Value?.ToString() ?? string.Empty" /></label>
            <label class="mt-3 block"><span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Expires"]</span>
                <select class="@Css.Input mt-1.5" @bind="days">
                    <option value="30">@Localizer["In 30 days"]</option>
                    <option value="90">@Localizer["In 90 days"]</option>
                    <option value="365">@Localizer["In a year"]</option>
                    <option value="0">@Localizer["Never"]</option>
                </select></label>
            <p class="mt-4 text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Scopes"] <span class="font-normal @Css.Muted">· @Localizer["Give it only what it needs."]</span></p>
            <div class="mt-1.5 space-y-1">
                @foreach (var (scope, description) in ApiScopes.All)
                {
                    <label class="flex cursor-pointer items-start gap-2.5 rounded-lg px-1 py-1 hover:bg-zinc-50 dark:hover:bg-zinc-800/60">
                        <input type="checkbox" class="mt-0.5 size-4 accent-primary-500" checked="@scopes.Contains(scope)" @onchange="e => Toggle(scope, e.Value is true)" />
                        <span><span class="block font-mono text-xs text-zinc-900 dark:text-zinc-100">@scope</span><span class="block text-xs">@Localizer[description]</span></span>
                    </label>
                }
            </div>
        </ChildContent>
        <Footer>
            <button class="@Css.GhostButton" @onclick="() => creating = false">@Localizer["Cancel"]</button>
            <button class="@Css.PrimaryButton" disabled="@(name.Trim().Length == 0 || scopes.Count == 0 || busy)" @onclick="Create">@Localizer["Create token"]</button>
        </Footer>
    </Dialog>
}
@if (created is not null)
{
    <Dialog Title="@string.Format(Localizer["Token for {0}"], created.Token.Name)" Width="max-w-lg" OnClose="() => created = null">
        <ChildContent>
            <p>@Localizer["This is the only time it's shown. Copy it now."]</p>
            <div class="mt-3 flex items-center gap-2">
                <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap rounded-lg bg-zinc-900 px-3 py-2 font-mono text-sm text-zinc-100">@created.Secret</code>
                <button class="@Css.PrimaryButton shrink-0" @onclick="() => Copy(created.Secret)"><Icon Name="copy" />@Localizer["Copy"]</button>
            </div>
            <p class="mt-3 text-xs">@Localizer["For example:"]</p>
            <code class="mt-1 block overflow-x-auto whitespace-nowrap rounded-lg bg-zinc-100 px-3 py-2 font-mono text-xs text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200">curl -H "Authorization: Bearer @created.Secret" @(Nav.BaseUri)api/PlayData/1</code>
        </ChildContent>
        <Footer>
            <button class="@Css.PrimaryButton" @onclick="() => created = null">@Localizer["Done"]</button>
        </Footer>
    </Dialog>
}
@if (revoking is { } doomed)
{
    <Dialog Title="@string.Format(Localizer["Revoke {0}?"], doomed.Name)" Alert OnClose="() => revoking = null">
        <ChildContent>@Localizer["Anything using it stops working immediately."]</ChildContent>
        <Footer>
            <button class="@Css.GhostButton" @onclick="() => revoking = null">@Localizer["Cancel"]</button>
            <button class="inline-flex items-center gap-1.5 rounded-xl bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700" @onclick="() => Delete(doomed)">@Localizer["Revoke"]</button>
        </Footer>
    </Dialog>
}

@code {
    [Inject] private NavigationManager Nav { get; set; } = null!;

    private ApiTokenList? list;
    private bool creating, busy;
    private string name = "";
    private int days = 90;
    private readonly HashSet<string> scopes = [];
    private ApiTokenCreated? created;
    private ApiTokenItem? revoking;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load() => list = await Client.GetFromJsonAsync<ApiTokenList>("api/ApiTokens");

    private static bool Active(ApiTokenItem t) => t.RevokedAt is null && !(t.ExpiresAt <= DateTime.UtcNow);

    private string ExpiryText(ApiTokenItem t) =>
        t.RevokedAt is not null ? Localizer["Revoked"]
        : t.ExpiresAt is { } e ? (e <= DateTime.UtcNow ? Localizer["Expired"] : string.Format(Localizer["Expires {0}"], e.ToLocalTime().ToString("d")))
        : Localizer["Never expires"];

    private void OpenCreate()
    {
        name = "";
        days = 90;
        scopes.Clear();
        creating = true;
    }

    private void Toggle(string scope, bool on)
    {
        if (on) scopes.Add(scope); else scopes.Remove(scope);
    }

    private async Task Create()
    {
        busy = true;
        var res = await Client.PostAsJsonAsync("api/ApiTokens", new CreateApiTokenRequest(name.Trim(), scopes.ToList(), days == 0 ? null : days));
        busy = false;
        if (!res.IsSuccessStatusCode) { Toast.Show(Localizer["Save Failed"], true); return; }
        created = await res.Content.ReadFromJsonAsync<ApiTokenCreated>();
        creating = false;
        await Load();
    }

    private async Task Delete(ApiTokenItem t)
    {
        revoking = null;
        var res = await Client.DeleteAsync($"api/ApiTokens/{t.Id}");
        if (!res.IsSuccessStatusCode) { Toast.Show(Localizer["Save Failed"], true); return; }
        await Load();
    }

    private async Task Copy(string text)
    {
        if (await Js.InvokeAsync<bool>("ui.copy", text)) Toast.Show(Localizer["Copied"]);
    }
}
