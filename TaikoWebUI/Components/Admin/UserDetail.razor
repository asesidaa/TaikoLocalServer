@* User Management › Inspector: everything an admin does to one user. Account and sign-in help are Server mode only. *@
@inject HttpClient Client
@inject AuthService AuthService
@inject ToastService Toast
@inject IJSRuntime Js
@inject GameDataService GameDataService

@{
    var s = User.UserSetting;
    var hex = GameData.Color(s.CardColor);
    var self = AuthService.LoginRequired && AuthService.GetLoggedInBaid() == User.Baid;
}
<div class="overflow-hidden rounded-t-2xl @(CardStyle.IsLight(hex) ? "text-zinc-900" : "text-white")" style="@CardStyle.Background(s.CardColor, s.CardPattern)">
    <div class="flex items-center gap-4 p-5">
        <Avatar Setting="s" Size="64" OnCard />
        <div class="min-w-0 flex-1">
            <p class="font-display truncate text-2xl">@s.MyDonName</p>
            <p class="truncate text-sm opacity-80">@s.Title</p>
        </div>
    </div>
</div>
<div class="grid grid-cols-3 divide-x divide-zinc-100 border-b border-zinc-100 text-center dark:divide-zinc-800 dark:border-zinc-800">
    @foreach (var (k, v) in new[] { (Localizer["User ID"].Value, User.Baid.ToString()), (Localizer["Plays"].Value, User.Plays.ToString("N0")), (Localizer["Last played"].Value, Ago(s.LastPlayDateTime)) })
    {
        <div class="px-2 py-3"><p class="text-xs @Css.Muted">@k</p><p class="mt-0.5 font-semibold tabular-nums">@v</p></div>
    }
</div>
<div class="flex flex-wrap gap-2 px-5 py-4">
    <a href="@($"/Users/{User.Baid}/Profile")" class="@Outline"><Icon Name="profile" />@Localizer["Profile"]</a>
    <a href="@PlayDataPaths.Of(User.Baid, PlayDataPaths.Stats)" class="@Outline"><Icon Name="chart" />@Localizer["Play Data"]</a>
    <a href="@($"/Users/{User.Baid}/QrCode")" class="@Outline"><Icon Name="qr" />@Localizer["QR code"]</a>
</div>

@if (AuthService.LoginRequired)
{
    @Section(Localizer["Account"], @<div>
    <div class="flex items-center justify-between gap-4 text-sm">
        <div>
            <p class="font-medium">@Localizer["Web UI account"]</p>
            <p class="text-xs @Css.Muted">@(User.IsRegistered ? Localizer["Has a password and can sign in."] : Localizer["No password set yet. Send an invite code."])</p>
        </div>
        @if (User.IsRegistered)
        {
            <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-[11px] font-medium text-emerald-700 dark:text-emerald-400">@Localizer["Registered"]</span>
        }
        else
        {
            <span class="rounded-full bg-amber-500/15 px-2 py-0.5 text-[11px] font-medium text-amber-700 dark:text-amber-300">@Localizer["Not registered"]</span>
        }
    </div>
    <div class="mt-3 flex items-center justify-between gap-4 text-sm">
        <div>
            <p class="font-medium">@Localizer["Signed-in devices"]</p>
            <p class="text-xs @Css.Muted">@DevicesText</p>
        </div>
        <button class="@Outline shrink-0 disabled:opacity-40" disabled="@(!(sessions?.Count > 0) || self)" title="@(self ? Localizer["Use Log out for your own devices."] : null)"
                @onclick="SignOutEverywhere"><Icon Name="logOut" />@Localizer["Sign out everywhere"]</button>
    </div>
    <div class="mt-3 flex items-center justify-between gap-4 text-sm">
        <div>
            <p class="font-medium">@Localizer["2-step verification"]</p>
            <p class="text-xs @Css.Muted">@(User.TwoFactor ? Localizer["On. Reset it if they lost their phone and their recovery codes."] : Localizer["Off"])</p>
        </div>
        @if (User.TwoFactor)
        {
            <button class="@Outline shrink-0 disabled:opacity-40" disabled="@self" title="@(self ? Localizer["Turn yours off in Settings › Security."] : null)"
                    @onclick="ResetTwoFactor"><Icon Name="rotate" />@Localizer["Reset"]</button>
        }
    </div>
    </div>)
}

@Section($"{Localizer["Access codes"]} · {User.AccessCodes.Count} / {AuthService.BoundAccessCodeUpperLimit}", @<div>
    <ul class="space-y-2">
        @foreach (var code in User.AccessCodes)
        {
            var last = User.AccessCodes.Count == 1;
            var ban = ActiveBan(code);
            <li class="flex flex-wrap items-center gap-2 rounded-xl border px-3 py-2 @(ban is null ? "border-zinc-200 dark:border-zinc-700" : "border-red-500/30 bg-red-500/5")">
                <Icon Name="@(ban is null ? "card" : "ban")" Class="@(ban is null ? "size-4 text-zinc-400" : "size-4 text-red-500")" />
                <span class="flex flex-1 flex-wrap items-center gap-2">
                    <span class="font-mono text-sm tracking-wide">@(revealed.Contains(code) ? Grouped(code) : Mask(code))</span>
                    @if (ban is not null)
                    {
                        <span class="whitespace-nowrap rounded-full bg-red-500/10 px-2 py-0.5 text-[11px] font-medium text-red-700 dark:text-red-400" title="@ban.Reason">@BanText(ban)</span>
                    }
                </span>
                <button class="@SmallIcon" aria-label="@(revealed.Contains(code) ? Localizer["Hide access code"] : Localizer["Show access code"])" @onclick="() => Toggle(code)">
                    <Icon Name="@(revealed.Contains(code) ? "eyeOff" : "eye")" />
                </button>
                <ActionMenu Label="@Localizer["More actions"]">
                    @if (ban is not null)
                    {
                        <button role="menuitem" class="@Css.MenuItem" @onclick="() => Unban(code)"><Icon Name="ban" Class="size-4" />@Localizer["Unban"]</button>
                    }
                    else
                    {
                        <button role="menuitem" class="@Css.MenuItem text-red-600 dark:text-red-400" @onclick="() => OpenBan(code)"><Icon Name="ban" Class="size-4" />@Localizer["Ban this card"]</button>
                    }
                    <button role="menuitem" class="@Css.MenuItem" disabled="@last" title="@(last ? Localizer["A user needs at least one access code."] : null)"
                            @onclick="() => { moveCode = code; return SearchMove(string.Empty); }"><Icon Name="move" Class="size-4" />@Localizer["Move to another user"]</button>
                    <button role="menuitem" class="@Css.MenuItem text-red-600 dark:text-red-400" disabled="@last" title="@(last ? Localizer["A user needs at least one access code."] : null)"
                            @onclick="() => RemoveCode(code)"><Icon Name="trash" Class="size-4" />@Localizer["Remove access code"]</button>
                </ActionMenu>
            </li>
        }
    </ul>
    @if (User.AccessCodes.Count < AuthService.BoundAccessCodeUpperLimit || !AuthService.LoginRequired)
    {
        <form class="mt-3 flex flex-wrap items-end justify-end gap-2" @onsubmit="BindCode" @onsubmit:preventDefault>
            <div class="min-w-0 flex-1 basis-72"><AccessCodeField @bind-Value="newCode" /></div>
            <button class="@Css.PrimaryButton shrink-0" disabled="@(newCode.Length != 20 || busy)"><Icon Name="plus" />@Localizer["Bind"]</button>
        </form>
    }
</div>)

@if (AuthService.LoginRequired)
{
    @Section(Localizer["Sign-in help"], SignInHelp)
}

@Section(Localizer["Data tools"], @<div class="grid gap-2 sm:grid-cols-2">
    @Tile("music", Localizer["Remove a score"], Localizer["Bad or cheated scores"], OpenScores)
</div>)

@Section(Localizer["Danger zone"], @<div class="divide-y divide-zinc-100 dark:divide-zinc-800">
    @if (AuthService.LoginRequired)
    {
        <div class="flex items-center justify-between gap-4 pb-4">
            <div><p class="text-sm font-medium">@Localizer["Admin role"]</p><p class="text-xs @Css.Muted">@Localizer["Admins can manage every user and the server."]</p></div>
            <button class="@Outline shrink-0 !border-red-500/40 !text-red-600 disabled:opacity-40 dark:!text-red-400" disabled="@self"
                    title="@(self ? Localizer["You can't change your own admin role."] : null)" @onclick="() => confirmAdmin = true">
                <Icon Name="crown" />@(User.IsAdmin ? Localizer["Remove admin"] : Localizer["Make admin"])
            </button>
        </div>
    }
    <div class="flex items-center justify-between gap-4 @(AuthService.LoginRequired ? "pt-4" : "")">
        <div><p class="text-sm font-medium">@Localizer["Delete user"]</p><p class="text-xs @Css.Muted">@Localizer["Delete User Hint"]</p></div>
        <button class="@Danger shrink-0" disabled="@self" title="@(self ? Localizer["You can't delete yourself."] : null)" @onclick="() => { confirmDelete = true; deleteName = string.Empty; }">
            <Icon Name="trash" />@Localizer["Delete"]
        </button>
    </div>
</div>, last: true)

@* ---- Dialogs ---- *@
@if (moveCode is not null)
{
    <Dialog Title="@Localizer["Move access code"]" Width="max-w-md" OnClose="() => moveCode = null">
        <p>@((MarkupString)string.Format(Localizer["Move Code Hint"], Chip(moveCode)))</p>
        <input type="search" autofocus class="@Css.Input mt-3" placeholder="@Localizer["Name or user ID"]" value="@moveQuery" @oninput="e => SearchMove(e.Value?.ToString() ?? string.Empty)" />
        <ul class="mt-2 max-h-72 space-y-0.5 overflow-y-auto">
            @foreach (var u in moveTargets.Where(u => u.Baid != User.Baid))
            {
                var full = AuthService.LoginRequired && u.AccessCodes.Count >= AuthService.BoundAccessCodeUpperLimit;
                <li>
                    <button class="flex w-full items-center gap-3 rounded-xl px-2.5 py-2 text-left text-zinc-900 hover:bg-zinc-100 disabled:opacity-45 disabled:hover:bg-transparent dark:text-zinc-100 dark:hover:bg-zinc-800"
                            disabled="@(full || busy)" @onclick="() => MoveCode(u)">
                        <Avatar Setting="u.UserSetting" Size="32" />
                        <span class="min-w-0 flex-1 truncate">@u.UserSetting.MyDonName <span class="text-xs @Css.Muted">· @Localizer["User ID"] @u.Baid</span></span>
                        @if (full)
                        {
                            <span class="text-xs @Css.Muted">@Localizer["Has the maximum"]</span>
                        }
                    </button>
                </li>
            }
        </ul>
    </Dialog>
}
@if (banCode is not null)
{
    <Dialog Title="@Localizer["Ban this card"]" Alert OnClose="() => banCode = null">
        <ChildContent>
            <p>@((MarkupString)string.Format(Localizer["Ban Card Dialog Hint"], Chip(banCode)))</p>
            <label class="mt-3 block"><span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Reason"]</span>
                <input class="@Css.Input mt-1.5" maxlength="200" autofocus value="@banReason" @oninput="e => banReason = e.Value?.ToString() ?? string.Empty" /></label>
            <label class="mt-3 block"><span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["For"]</span>
                <select class="@Css.Input mt-1.5" @bind="banDays">
                    <option value="1">@Localizer["1 day"]</option>
                    <option value="7">@Localizer["7 days"]</option>
                    <option value="30">@Localizer["30 days"]</option>
                    <option value="0">@Localizer["Permanently"]</option>
                </select></label>
        </ChildContent>
        <Footer>
            <button class="@Css.GhostButton" @onclick="() => banCode = null">@Localizer["Cancel"]</button>
            <button class="@Danger" disabled="@busy" @onclick="BanCard"><Icon Name="ban" />@Localizer["Ban"]</button>
        </Footer>
    </Dialog>
}
@if (invite is not null)
{
    <Dialog Title="@Localizer["Invite code"]" OnClose="() => invite = null">
        <ChildContent>
            <p>@((MarkupString)string.Format(Localizer["Invite Dialog Hint"], Chip(User.AccessCodes.FirstOrDefault() ?? "")))</p>
            <p class="mt-4 text-center font-mono text-3xl font-semibold tracking-[.3em] text-zinc-900 dark:text-zinc-100">@invite</p>
        </ChildContent>
        <Footer>
            <button class="@Css.GhostButton" @onclick="() => invite = null">@Localizer["Close"]</button>
            <button class="@Css.PrimaryButton" @onclick="CopyInvite"><Icon Name="copy" />@Localizer["Copy"]</button>
        </Footer>
    </Dialog>
}
@if (confirmReset)
{
    <Dialog Title="@Localizer["Reset password"]" Alert OnClose="() => confirmReset = false">
        <ChildContent>@string.Format(Localizer["Reset Password Confirm"], s.MyDonName)</ChildContent>
        <Footer>
            <button class="@Css.GhostButton" @onclick="() => confirmReset = false">@Localizer["Cancel"]</button>
            <button class="@Danger" disabled="@busy" @onclick="ResetPassword">@Localizer["Reset password"]</button>
        </Footer>
    </Dialog>
}
@if (confirmAdmin)
{
    <Dialog Title="@(User.IsAdmin ? Localizer["Remove admin"] : Localizer["Make admin"])" Alert OnClose="() => confirmAdmin = false">
        <ChildContent>@string.Format(User.IsAdmin ? Localizer["Remove Admin Confirm"] : Localizer["Make Admin Confirm"], s.MyDonName)</ChildContent>
        <Footer>
            <button class="@Css.GhostButton" @onclick="() => confirmAdmin = false">@Localizer["Cancel"]</button>
            <button class="@Danger" disabled="@busy" @onclick="SetAdmin">@(User.IsAdmin ? Localizer["Remove admin"] : Localizer["Make admin"])</button>
        </Footer>
    </Dialog>
}
@if (confirmDelete)
{
    <Dialog Title="@Localizer["Delete user"]" Alert OnClose="() => confirmDelete = false">
        <ChildContent>
            <p>@string.Format(Localizer["Delete User Confirm"], s.MyDonName)</p>
            <input class="@Css.Input mt-3" autofocus placeholder="@s.MyDonName" value="@deleteName" @oninput="e => deleteName = e.Value?.ToString() ?? string.Empty" />
        </ChildContent>
        <Footer>
            <button class="@Css.GhostButton" @onclick="() => confirmDelete = false">@Localizer["Cancel"]</button>
            <button class="@Danger" disabled="@(deleteName != s.MyDonName || busy)" @onclick="DeleteUser">@Localizer["Delete"]</button>
        </Footer>
    </Dialog>
}
@if (scores is not null)
{
    var q = scoreQuery.Trim();
    var hits = scores.Where(x => q.Length == 0 || x.MusicName.Contains(q, StringComparison.OrdinalIgnoreCase) || x.SongId.ToString() == q).ToList();
    <Dialog Title="@Localizer["Remove a score"]" Width="max-w-lg" OnClose="() => scores = null">
        <p>@Localizer["Remove Score Hint"]</p>
        <input type="search" autofocus class="@Css.Input mt-3" placeholder="@Localizer["Song name or ID"]" value="@scoreQuery" @oninput="e => scoreQuery = e.Value?.ToString() ?? string.Empty" />
        <ul class="mt-2 max-h-80 divide-y divide-zinc-100 overflow-y-auto dark:divide-zinc-800">
            @if (hits.Count == 0)
            {
                <li class="py-6 text-center">@Localizer["No scores match."]</li>
            }
            @foreach (var x in hits.Take(100))
            {
                var key = (x.SongId, x.Difficulty);
                <li class="flex items-center gap-3 py-2 text-zinc-900 dark:text-zinc-100">
                    <span class="min-w-0 flex-1">
                        <span class="block truncate">@x.MusicName</span>
                        <span class="block text-xs @Css.Muted">@DifficultyName(x.Difficulty) · @x.BestScore.ToString("N0") · @(x.PlayCount == 1 ? Localizer["1 play"] : string.Format(Localizer["{0} plays"], x.PlayCount))</span>
                    </span>
                    @if (removing == key)
                    {
                        <button class="@Css.GhostButton !px-3 !py-1.5" @onclick="() => removing = null">@Localizer["Keep"]</button>
                        <button class="@Danger !px-3 !py-1.5" disabled="@busy" @onclick="() => RemoveScore(x)">@Localizer["Remove"]</button>
                    }
                    else
                    {
                        <button class="@SmallIcon hover:!bg-red-500/10 hover:!text-red-600" aria-label="@Localizer["Remove"]" @onclick="() => removing = key"><Icon Name="trash" /></button>
                    }
                </li>
            }
        </ul>
    </Dialog>
}

@code {
    [Parameter, EditorRequired] public User User { get; set; } = null!;
    /// <summary>Something about this user changed on the server: reload the list.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }

    private const string Outline = "inline-flex items-center gap-1.5 rounded-xl border border-zinc-200 px-3 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800";
    private const string Danger = "inline-flex items-center justify-center gap-1.5 rounded-xl bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700 active:scale-[.98] disabled:cursor-not-allowed disabled:opacity-50";
    private const string SmallIcon = "grid size-8 place-items-center rounded-lg text-zinc-400 hover:bg-zinc-100 hover:text-zinc-700 disabled:opacity-40 disabled:hover:bg-transparent dark:hover:bg-zinc-800";

    private readonly HashSet<string> revealed = [];
    private string newCode = "";
    private string? moveCode;
    private string moveQuery = "";
    private List<User> moveTargets = [];
    private int moveRequest;
    private string? invite;
    private bool confirmReset, confirmAdmin, confirmDelete, busy;
    private string deleteName = "";
    private List<SongBestData>? scores;
    private string scoreQuery = "";
    private (uint, Difficulty)? removing;
    private uint shownBaid;
    private List<SessionItem>? sessions;
    private List<BanItem>? bans;
    private List<SignInItem>? failedSignIns;
    private string? banCode;
    private string banReason = "";
    private int banDays = 7;

    // Move's targets: the first 50 matches, searched on the server.
    private async Task SearchMove(string q)
    {
        moveQuery = q;
        var mine = ++moveRequest;
        var result = await Client.GetFromJsonAsync<UsersResponse>($"api/Users?limit=51&searchTerm={Uri.EscapeDataString(q.Trim())}");
        if (mine == moveRequest) moveTargets = result?.Users ?? [];
    }

    protected override void OnParametersSet()
    {
        // Another user picked: start clean.
        if (shownBaid == User.Baid) return;
        shownBaid = User.Baid;
        revealed.Clear();
        newCode = "";
        moveCode = invite = null;
        confirmReset = confirmAdmin = confirmDelete = false;
        scores = null;
        banCode = null;
        sessions = null;
        failedSignIns = null;
        _ = LoadAccess(User.Baid);
    }

    // This user's devices and failed sign-ins (Server mode), and which of their cards are banned.
    private async Task LoadAccess(uint baid)
    {
        bans = await Client.GetFromJsonAsync<List<BanItem>>("api/Bans");
        if (AuthService.LoginRequired)
        {
            var s = await Client.GetFromJsonAsync<List<SessionItem>>($"api/Sessions?baid={baid}");
            var since = DateTime.UtcNow.AddDays(-7);
            var f = (await Client.GetFromJsonAsync<SignInPage>($"api/SignIns?baid={baid}&failed=true&limit=5"))?.Items.Where(x => x.Time > since).ToList();
            if (baid != User.Baid) return;   // another user was picked meanwhile
            sessions = s ?? [];
            failedSignIns = f ?? [];
        }
        StateHasChanged();
    }

    private BanItem? ActiveBan(string code) => bans?.FirstOrDefault(b => b.AccessCode == code && (b.Until is null || b.Until > DateTime.UtcNow));

    private string BanText(BanItem ban) => ban.Until is { } until
        ? string.Format(Localizer["Banned until {0}"], until.ToLocalTime().ToString("d")) : Localizer["Banned"];

    private string DevicesText => sessions is null ? Localizer["Loading..."]
        : sessions.Count == 0 ? Localizer["Not signed in anywhere"]
        : string.Format(Localizer[sessions.Count == 1 ? "1 device · last active {1}" : "{0} devices · last active {1}"],
            sessions.Count, sessions.Max(x => x.LastSeenAt).ToLocalTime().ToString("g"));

    private string FailedText(SignInOutcome r) => r switch
    {
        SignInOutcome.WrongPassword => Localizer["Wrong password"],
        SignInOutcome.NotRegistered => Localizer["Not registered yet"],
        SignInOutcome.AccountLocked => Localizer["Account locked"],
        SignInOutcome.CardBanned => Localizer["Card banned"],
        SignInOutcome.WrongTwoFactorCode => Localizer["Wrong 2-step code"],
        _ => Localizer["Unknown access code"],
    };

    private void OpenBan(string code)
    {
        banCode = code;
        banReason = "";
        banDays = 7;
    }

    private async Task SignOutEverywhere()
    {
        if (await Run(() => Client.PostAsync($"api/Sessions/RevokeOthers?baid={User.Baid}", null), Localizer["Signed out everywhere"]))
            sessions = [];
    }

    private async Task ResetTwoFactor()
    {
        if (await Run(() => Client.DeleteAsync($"api/TwoFactor/{User.Baid}"), Localizer["2-step verification reset"]))
            User.TwoFactor = false;
    }

    private async Task BanCard()
    {
        var code = banCode!;
        if (await Run(() => Client.PostAsJsonAsync("api/Bans", new BanRequest { AccessCode = code, Reason = banReason, Days = banDays == 0 ? null : banDays }), Localizer["Card banned"]))
        {
            banCode = null;
            bans = await Client.GetFromJsonAsync<List<BanItem>>("api/Bans");
        }
    }

    private async Task Unban(string code)
    {
        if (await Run(() => Client.DeleteAsync($"api/Bans/{code}"), Localizer["Unbanned"]))
            bans = await Client.GetFromJsonAsync<List<BanItem>>("api/Bans");
    }

    private RenderFragment Section(string title, RenderFragment body, bool last = false) => __builder =>
    {
        <section class="border-t border-zinc-100 px-5 py-5 dark:border-zinc-800 @(last ? "rounded-b-2xl" : "")">
            <h3 class="text-sm font-semibold">@title</h3>
            <div class="mt-3">@body</div>
        </section>
    };

    private RenderFragment SignInHelp => __builder =>
    {
    <div class="grid gap-2 sm:grid-cols-2">
            @Tile("ticket", Localizer["Invite code"], Localizer["Invite Code Hint"], GenerateInvite)
            @Tile("key", Localizer["Reset password"], Localizer["They register again"], () => confirmReset = true, disabled: !User.IsRegistered)
            <div class="sm:col-span-2">
                <p class="mt-2 text-xs font-medium @Css.Muted">@Localizer["Recent failed sign-ins"]</p>
                @if (failedSignIns?.Count > 0)
                {
                    <ul class="mt-2 space-y-1.5">
                        @foreach (var f in failedSignIns)
                        {
                            <li class="flex items-center gap-2 text-sm">
                                <Icon Name="alert" Class="size-4 text-amber-500" />
                                <span class="flex-1">@FailedText(f.Result)</span>
                                <span class="text-xs @Css.Muted">@f.Time.ToLocalTime().ToString("g") · @f.Ip</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="mt-1 text-sm @Css.Muted">@(failedSignIns is null ? Localizer["Loading..."] : Localizer["None in the last 7 days."])</p>
                }
            </div>
        </div>
    };

    private RenderFragment Tile(string icon, string title, string hint, Func<Task> onClick, bool disabled = false) => __builder =>
    {
        <button disabled="@disabled" @onclick="onClick"
                class="flex flex-col items-start gap-1 rounded-xl border border-zinc-200 p-3 text-left hover:border-primary-500 hover:bg-primary-500/5 disabled:opacity-40 disabled:hover:border-zinc-200 disabled:hover:bg-transparent dark:border-zinc-700">
            <span class="flex items-center gap-2 text-sm font-medium"><Icon Name="@icon" />@title</span>
            <span class="text-xs @Css.Muted">@hint</span>
        </button>
    };

    private RenderFragment Tile(string icon, string title, string hint, Action onClick, bool disabled = false) =>
        Tile(icon, title, hint, () => { onClick(); return Task.CompletedTask; }, disabled);

    private static string Mask(string code) => "•••• " + (code.Length > 4 ? code[^4..] : code);
    private static string Grouped(string code) => string.Join(" ", code.Chunk(4).Select(c => new string(c)));
    // The masked code as a chip in running text: never splits across lines.
    private static string Chip(string code) =>
        $"<span class=\"whitespace-nowrap rounded-md bg-zinc-100 px-1.5 py-0.5 font-mono text-[0.85em] text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300\">••••&nbsp;{System.Net.WebUtility.HtmlEncode(code.Length > 4 ? code[^4..] : code)}</span>";

    private string Ago(DateTime t)
    {
        if (t == default) return Localizer["Never"];
        var days = (int)(DateTime.Now - t).TotalDays;
        return days <= 0 ? Localizer["Today"] : days == 1 ? Localizer["Yesterday"] : days < 30 ? string.Format(Localizer["{0} days ago"], days) : t.ToString("d");
    }

    private string DifficultyName(Difficulty d) => Localizer[GameData.Difficulties.FirstOrDefault(x => x.Value == d).Name ?? d.ToString()];

    private void Toggle(string code)
    {
        if (!revealed.Remove(code)) revealed.Add(code);
    }

    // Runs a request; on success toasts and tells the page, on failure toasts the server's message.
    private async Task<bool> Run(Func<Task<HttpResponseMessage>> send, string done)
    {
        busy = true;
        try
        {
            var res = await send();
            if (!res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadAsStringAsync();
                Toast.Show(body.Contains("Access Code Limit Reached") ? Localizer["That user has the maximum number of access codes."]
                    : (body.Contains("Already Yours") || body.Contains("Another Player")) ? Localizer["That access code is already bound to a user."]
                    : body.Contains("Last Access Code") ? Localizer["A user needs at least one access code."]
                    : Localizer["Save Failed"], true);
                return false;
            }
            Toast.Show(done);
            return true;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task BindCode()
    {
        if (await Run(() => Client.PostAsJsonAsync("api/Cards/BindAccessCode", new BindAccessCodeRequest { AccessCode = newCode, Baid = User.Baid }), Localizer["Access code bound"]))
        {
            newCode = "";
            await OnChanged.InvokeAsync();
        }
    }

    private async Task RemoveCode(string code)
    {
        if (await Run(() => Client.DeleteAsync($"api/Cards/{code}"), Localizer["Access code removed"]))
            await OnChanged.InvokeAsync();
    }

    private async Task MoveCode(User target)
    {
        var code = moveCode!;
        if (await Run(() => Client.PostAsJsonAsync($"api/Cards/{code}/Move", new MoveAccessCodeRequest { ToBaid = target.Baid }),
                string.Format(Localizer["Moved to {0}"], target.UserSetting.MyDonName)))
        {
            moveCode = null;
            await OnChanged.InvokeAsync();
        }
    }

    private async Task GenerateInvite()
    {
        var res = await Client.PostAsJsonAsync("api/Auth/GenerateOtp", new GenerateOtpRequest { Baid = User.Baid });
        if (!res.IsSuccessStatusCode)
        {
            Toast.Show(Localizer["Save Failed"], true);
            return;
        }
        invite = (await res.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>()).GetProperty("otp").GetString();
    }

    private async Task CopyInvite()
    {
        if (await Js.InvokeAsync<bool>("ui.copy", invite)) Toast.Show(Localizer["Copied"]);
    }

    private async Task ResetPassword()
    {
        if (await Run(() => Client.PostAsJsonAsync("api/Auth/ResetPassword", new ResetPasswordRequest { Baid = User.Baid }), Localizer["Password reset"]))
        {
            confirmReset = false;
            await OnChanged.InvokeAsync();
        }
    }

    private async Task SetAdmin()
    {
        if (await Run(() => Client.PutAsJsonAsync($"api/Users/{User.Baid}/Admin", new SetAdminRequest { IsAdmin = !User.IsAdmin }), Localizer["Saved"]))
        {
            confirmAdmin = false;
            await OnChanged.InvokeAsync();
        }
    }

    private async Task DeleteUser()
    {
        if (await Run(() => Client.DeleteAsync($"api/Users/{User.Baid}"), string.Format(Localizer["Deleted {0}"], User.UserSetting.MyDonName)))
        {
            confirmDelete = false;
            await OnDeleted.InvokeAsync();
        }
    }

    private async Task OpenScores()
    {
        scoreQuery = "";
        removing = null;
        var music = await GameDataService.GetMusicDetailDictionary();
        var list = (await Client.GetFromJsonAsync<SongBestResponse>($"api/PlayData/{User.Baid}"))?.SongBestData ?? [];
        foreach (var x in list)
        {
            // Songs without a name in this language fall back to Japanese, then to the ID.
            var name = GameDataService.GetMusicNameBySongId(music, x.SongId, CultureInfo.CurrentCulture.ToString());
            x.MusicName = name.Length > 0 ? name : music.TryGetValue(x.SongId, out var m) && m.SongName.Length > 0 ? m.SongName : $"{Localizer["Unknown song"]} #{x.SongId}";
        }
        scores = list.OrderBy(x => !music.ContainsKey(x.SongId)).ThenBy(x => x.MusicName).ThenBy(x => x.Difficulty).ToList();
    }

    private async Task RemoveScore(SongBestData x)
    {
        if (await Run(() => Client.DeleteAsync($"api/Users/{User.Baid}/Scores/{x.SongId}/{(int)x.Difficulty}"), Localizer["Score removed"]))
        {
            scores!.Remove(x);
            removing = null;
            await OnChanged.InvokeAsync();
        }
    }
}
