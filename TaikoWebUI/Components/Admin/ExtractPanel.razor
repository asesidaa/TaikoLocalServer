@* "Run extract": the server copies the game files in from GamePath. Without GamePath, the admin can send the game
   folder from this browser (AllowRemoteGameDir), or run the command by hand. Used by Server Management › Game data
   and the setup page. *@
@implements IAsyncDisposable
@inject HttpClient Client
@inject IJSRuntime Js

@if (status is null)
{
    <Skeleton />
}
else if (status.ExtractFound && status.GamePathFound)
{
    <div class="space-y-3 text-sm">
        <div class="flex items-start gap-2">
            <Icon Name="check" Class="mt-0.5 size-4 text-emerald-500" />
            <div class="min-w-0">
                <p class="font-medium">@Localizer["Found the game"]</p>
                <p class="truncate font-mono text-xs @Css.Muted" title="@status.GamePath">@status.GamePath</p>
            </div>
        </div>
        <Toggle Label="@Localizer["Include the game's mods folder"]" Description="@Localizer["Include files from Data_mods over vanilla ones"]" Icon="archive" @bind-Value="mods" />
        @if (!status.Running)
        {
            <button class="@Css.PrimaryButton" disabled="@starting" @onclick="() => Start(mods, false)"><Icon Name="rotate" />@Localizer["Extract game files"]</button>
        }
        @RunState
    </div>
}
else if (status.RemoteGameDir)
{
    @* The game is on another machine: pick its folder here, and only the files extract reads are sent. *@
    <div class="space-y-3 text-sm">
        <p class="@Css.Muted">@Localizer["Send Game Folder Hint"]</p>
        <Toggle Label="@Localizer["Include the game's mods folder"]" Description="@Localizer["Include files from Data_mods over vanilla ones"]" Icon="archive" @bind-Value="mods" />
        @if (sending)
        {
            <div role="progressbar" aria-label="@Localizer["Sending the game files"]" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Percent"
                 class="h-1.5 overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800">
                <div class="h-full rounded-full bg-primary-500 transition-[width]" style="width: @(Percent)%"></div>
            </div>
            <p class="@Css.Muted">@string.Format(Localizer["Sending the game files: {0:0} of {1:0} MB"], sent / 1048576, total / 1048576)</p>
        }
        else if (!status.Running)
        {
            @* A real file input (not a JS click) so every browser treats the pick as the user's own. *@
            <label class="@Css.PrimaryButton cursor-pointer focus-within:ring-2 focus-within:ring-primary-500">
                <Icon Name="cloud" />@Localizer["Choose game folder"]
                <input @ref="folderInput" type="file" webkitdirectory class="sr-only" @onchange="Send" />
            </label>
        }
        @if (sendError is { } error)
        {
            <p class="text-red-600 dark:text-red-400">@error</p>
        }
        @RunState
        <details>
            <summary class="cursor-pointer text-xs font-medium @Css.Muted">@Localizer["Or run it on the game PC"]</summary>
            @Command
        </details>
    </div>
}
else
{
    @* The ways out: set GamePath (the server runs it), allow sending it from the browser, or run it by hand. *@
    <div class="space-y-3 text-sm">
        <p class="@Css.Muted">
            @if (!status.ExtractFound)
            {
                @Localizer["extract.exe isn't next to TaikoLocalServer.exe, so run it yourself:"]
            }
            else
            {
                @((MarkupString)string.Format(Localizer["Set GamePath Hint"], "<code class=\"font-mono text-xs\">GamePath</code>", "<code class=\"font-mono text-xs\">Host/Configurations/ServerSettings.json</code>"))
                <span class="mt-1 block">@((MarkupString)string.Format(Localizer["Allow Remote Game Dir Hint"], "<code class=\"font-mono text-xs\">\"AllowRemoteGameDir\": true</code>"))</span>
            }
        </p>
        @Command
        <button class="@Css.GhostButton !px-0" @onclick="Refresh"><Icon Name="rotate" />@Localizer["Check again"]</button>
    </div>
}

@code {
    /// <summary>A run finished (successfully or not): the game data has been reloaded.</summary>
    [Parameter] public EventCallback OnFinished { get; set; }

    private ExtractStatus? status;
    private bool mods = true;
    private bool starting;
    private CancellationTokenSource? polling;

    private ElementReference folderInput;
    private IJSObjectReference? module;
    private DotNetObjectReference<ExtractPanel>? self;
    private bool sending;
    private double sent, total;
    private string? sendError;
    private int Percent => total > 0 ? (int)(sent * 100 / total) : 0;

    private sealed record SendResult(string? Error, bool Mods);

    private RenderFragment Command => @<code class="mt-2 block overflow-x-auto whitespace-nowrap rounded-lg bg-zinc-900 px-3 py-2 font-mono text-xs text-zinc-100">extract --game "@(status!.GamePath.Length > 0 ? status.GamePath : "<Nijiiro game folder>")" --mods</code>;

    // Extracting, then how the last run went and its report.
    private RenderFragment RunState => @<text>
        @if (status!.Running)
        {
            <div role="progressbar" aria-label="@Localizer["Extracting"]" class="h-1.5 overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800">
                <div class="h-full w-1/3 animate-pulse rounded-full bg-primary-500"></div>
            </div>
            <p class="@Css.Muted">@Localizer["Extracting… This takes about a minute. Nothing in the game folder is changed."]</p>
        }
        @if (status is { Running: false, FinishedAt: { } done, StartedAt: { } started })
        {
            <p class="@(status.ExitCode == 0 ? Css.Muted : "text-red-600 dark:text-red-400")">
                @(status.ExitCode == 0
                    ? string.Format(Localizer["Done in {0:0} s{1}."], (done - started).TotalSeconds, status.Mods ? Localizer[", with mods"].Value : "")
                    : string.Format(Localizer["Finished with errors (exit code {0}). See the report."], status.ExitCode))
            </p>
        }
        @if (status.Output.Count > 0)
        {
            <details open="@(status.ExitCode is not 0)">
                <summary class="cursor-pointer text-xs font-medium @Css.Muted">@Localizer["Report"]</summary>
                <pre class="mt-2 max-h-64 overflow-auto rounded-lg bg-zinc-900 p-3 font-mono text-xs text-zinc-100">@string.Join("\n", status.Output)</pre>
            </details>
        }
    </text>;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        if (status?.Running == true) _ = Poll();
    }

    private async Task Refresh()
    {
        status = await Client.GetFromJsonAsync<ExtractStatus>("api/Extract");
        if (status is { FinishedAt: not null }) mods = status.Mods;
    }

    private async Task Start(bool withMods, bool uploaded)
    {
        starting = true;
        var res = await Client.PostAsync($"api/Extract?mods={(withMods ? "true" : "false")}&uploaded={(uploaded ? "true" : "false")}", null);
        starting = false;
        await Refresh();
        if (res.IsSuccessStatusCode) _ = Poll();
    }

    private async Task Send()
    {
        sendError = null;
        sending = true;
        sent = total = 0;
        module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/gamefolder.js");
        self ??= DotNetObjectReference.Create(this);
        var result = await module.InvokeAsync<SendResult>("send", folderInput, mods, self);
        sending = false;
        if (result.Error is { } error)
        {
            sendError = error == "no-game" ? Localizer["No Game In Folder"] : error;
            return;
        }
        // Data_mods may not be in the picked folder: extract then runs without it.
        await Start(mods && result.Mods, true);
    }

    [JSInvokable]
    public Task Progress(double done, double all)
    {
        sent = done;
        total = all;
        StateHasChanged();
        return Task.CompletedTask;
    }

    // Once a second while it runs; extract prints its report at the end.
    private async Task Poll()
    {
        polling?.Cancel();
        polling = new CancellationTokenSource();
        var token = polling.Token;
        while (!token.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(1000, token);
            }
            catch (TaskCanceledException)
            {
                return;
            }
            await Refresh();
            StateHasChanged();
            if (status?.Running != true)
            {
                await OnFinished.InvokeAsync();
                return;
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        polling?.Cancel();
        self?.Dispose();
        if (module is not null)
        {
            try { await module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
