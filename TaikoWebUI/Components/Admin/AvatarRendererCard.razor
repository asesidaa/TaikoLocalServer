@* Server Management › Status: the server-side avatar renderer, with an off switch for servers that don't want the overhead. *@
@inject HttpClient Client
@inject ToastService Toast
@inject IJSRuntime Js

<section class="@Css.Card p-5 sm:p-6">
    <h2 class="font-semibold">@Localizer["Avatars"]</h2>
    @if (status is null)
    {
        <div class="mt-2"><Skeleton /></div>
    }
    else
    {
        <Toggle Label="@Localizer["Render avatars on the server"]" Icon="profile" Value="status.Enabled" ValueChanged="Set"
                Description="@Localizer["Gives every player an avatar, even players who never open the Web UI. Edge or Chrome runs in the background only while avatars are waiting. When off, each avatar is drawn the next time its player views their card."]" />
        @* Stills come from the renderer above, so without it cards stay 3D. *@
        <Toggle Label="@Localizer["Enable 3D Renderer"]" Icon="profile" Value="status.Cards3D || !status.Enabled" ValueChanged="SetCards3D" Disabled="!status.Enabled"
                Description="@(status.Enabled
                    ? Localizer["Player cards show an animated 3D don-chan. When off, they show a still image the server draws: lighter for phones and older PCs, and it updates a few seconds after a costume change."]
                    : Localizer["Player cards show an animated 3D don-chan. Turn on rendering avatars on the server to use still images instead."])" />
        <dl class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
            <div class="min-w-0">
                <dt class="text-xs @Css.Muted">@Localizer["Browser"]</dt>
                <dd class="truncate font-mono text-xs" title="@status.Browser">@(status.Browser ?? Localizer["None found"].Value)</dd>
            </div>
            <div>
                <dt class="text-xs @Css.Muted">@Localizer["Activity"]</dt>
                <dd>@(status.Running ? Localizer["Running"] : Localizer["Idle"]) · @string.Format(Localizer["{0} queued · {1} drawn · {2} failed"], status.Queued, status.Rendered, status.Failed)</dd>
            </div>
        </dl>
        @if (status.LastError is { } error)
        {
            <p class="mt-3 rounded-xl bg-amber-500/10 px-3 py-2 text-xs text-amber-800 dark:text-amber-200">@error</p>
        }
        <div class="mt-4 flex flex-wrap gap-2 border-t border-zinc-100 pt-4 dark:border-zinc-800">
            <button class="@Css.GhostButton border border-zinc-200 !py-2 dark:border-zinc-700" @onclick="OpenList"><Icon Name="list" Class="size-4" />@Localizer["Stored avatars"]</button>
            <button class="@Css.GhostButton border border-red-500/40 !py-2 !text-red-600 dark:!text-red-400" @onclick="() => confirmClear = true"><Icon Name="trash" Class="size-4" />@Localizer["Clear all avatars"]</button>
        </div>
    }
</section>

@if (stored is not null)
{
    <Dialog Title="@string.Format(Localizer["Stored avatars · {0}"], stored.Count)" Width="max-w-lg" OnClose="() => stored = null">
        @if (stored.Count == 0)
        {
            <p class="mt-2">@Localizer["No avatars stored yet."]</p>
        }
        else
        {
            <p class="mt-1">@string.Format(Localizer["{0} in the database."], Size(stored.Sum(a => (long)a.Bytes)))</p>
            <ul class="mt-2 max-h-96 divide-y divide-zinc-100 overflow-y-auto dark:divide-zinc-800">
                @foreach (var a in stored)
                {
                    <li class="flex items-center gap-3 py-2 text-zinc-900 dark:text-zinc-100">
                        <span class="relative size-10 shrink-0 overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800">
                            <img data-avatar="api/Users/@a.Baid/Avatar?v=@Uri.EscapeDataString(a.Key)" alt="" hidden class="size-full object-cover" />
                        </span>
                        <span class="min-w-0 flex-1">
                            <span class="block truncate text-sm font-medium">@(a.Name.Length > 0 ? a.Name : Localizer["No name"])</span>
                            <span class="block truncate text-xs @Css.Muted">@Localizer["User ID"] @a.Baid · @Size(a.Bytes) · @a.ContentType.Replace("image/", "").ToUpperInvariant()</span>
                        </span>
                        @* The costume it shows: a stale key is redrawn. *@
                        <span class="hidden max-w-44 truncate font-mono text-[11px] sm:block @Css.Muted" title="@a.Key">@a.Key</span>
                    </li>
                }
            </ul>
        }
    </Dialog>
}

@if (confirmClear)
{
    <Dialog Title="@Localizer["Clear all avatars?"]" Alert OnClose="() => confirmClear = false">
        <ChildContent>
            @(status?.Enabled == true
                ? Localizer["Every stored avatar is deleted. The server draws them all again in the background."]
                : Localizer["Every stored avatar is deleted. Each is drawn again the next time its player views their card."])
        </ChildContent>
        <Footer>
            <button class="@Css.GhostButton" @onclick="() => confirmClear = false">@Localizer["Cancel"]</button>
            <button class="inline-flex items-center gap-1.5 rounded-xl bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700" disabled="@clearing" @onclick="Clear">@Localizer["Clear all avatars"]</button>
        </Footer>
    </Dialog>
}

@code {
    private AvatarRendererStatus? status;
    private List<StoredAvatar>? stored;
    private bool confirmClear, clearing;

    protected override async Task OnInitializedAsync() => status = await Client.GetFromJsonAsync<AvatarRendererStatus>("api/AvatarRenderer");

    private async Task Set(bool on)
    {
        var res = await Client.PutAsJsonAsync("api/AvatarRenderer", new { enabled = on });
        if (!res.IsSuccessStatusCode) { Toast.Show(Localizer["Save Failed"], true); return; }
        status = await res.Content.ReadFromJsonAsync<AvatarRendererStatus>();
        Toast.Show(on ? Localizer["Avatar renderer on"] : Localizer["Avatar renderer off"]);
    }

    private async Task SetCards3D(bool on)
    {
        var res = await Client.PutAsJsonAsync("api/AvatarRenderer/Cards3D", new { enabled = on });
        if (!res.IsSuccessStatusCode) { Toast.Show(Localizer["Save Failed"], true); return; }
        status = await res.Content.ReadFromJsonAsync<AvatarRendererStatus>();
        Toast.Show(on ? Localizer["Player cards show 3D"] : Localizer["Player cards show still images"]);
    }

    // The list's thumbnails load through the asset fetcher (they need the sign-in token).
    protected override Task OnAfterRenderAsync(bool firstRender) => stored is { Count: > 0 } ? Js.InvokeVoidAsync("ui.hydrateAssets").AsTask() : Task.CompletedTask;

    private async Task OpenList() => stored = await Client.GetFromJsonAsync<List<StoredAvatar>>("api/AvatarRenderer/Avatars") ?? [];

    private async Task Clear()
    {
        clearing = true;
        var res = await Client.DeleteAsync("api/AvatarRenderer/Avatars");
        clearing = confirmClear = false;
        if (!res.IsSuccessStatusCode) { Toast.Show(Localizer["Save Failed"], true); return; }
        Toast.Show(string.Format(Localizer["Avatars cleared ({0})"], await res.Content.ReadFromJsonAsync<int>()));
        status = await Client.GetFromJsonAsync<AvatarRendererStatus>("api/AvatarRenderer");
    }

    private static string Size(long bytes) => bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB" : $"{bytes / 1048576.0:0.#} MB";
}
