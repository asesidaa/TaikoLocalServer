@* Server Management › Settings: what players may do with their own account. Part of the access rules (api/AccessRules);
   the sign-up and sign-in rules stay on Access › Overview. Free editing and deleting only apply in Server mode. *@
@inject HttpClient Client
@inject AuthService AuthService
@inject ToastService Toast

<section class="@Css.Card p-5 sm:p-6">
    <h2 class="font-semibold">@Localizer["Players"]</h2>
    @if (draft is null)
    {
        <div class="mt-2"><Skeleton /></div>
    }
    else
    {
        <div class="mt-3 divide-y divide-zinc-100 dark:divide-zinc-800">
            @if (AuthService.LoginRequired)
            {
                <Toggle Label="@Localizer["Free profile editing"]" Description="@Localizer["Free Profile Editing Hint"]" Icon="id" @bind-Value="draft.AllowFreeProfileEditing" />
                <Toggle Label="@Localizer["Players can delete their account"]" Icon="users" @bind-Value="draft.AllowUserDelete" />
            }
            <label class="flex items-center gap-3 py-2">
                <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-zinc-100 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400"><Icon Name="card" Class="size-5" /></span>
                <span class="min-w-0 flex-1 text-sm font-medium">@Localizer["Access codes per player"]</span>
                <input type="number" min="1" max="99" class="@Css.Input !w-20 text-right" @bind="draft.AccessCodeLimit" />
            </label>
        </div>
        <div class="mt-4 flex justify-end gap-2">
            @if (Changed)
            {
                <button class="@Css.GhostButton" @onclick="Reset">@Localizer["Cancel"]</button>
            }
            <button class="@Css.PrimaryButton" disabled="@(!Changed || saving || draft.AccessCodeLimit < 1)" @onclick="Save">@Localizer["Save"]</button>
        </div>
    }
</section>

@code {
    private AccessRulesSettings? saved, draft;
    private bool saving;

    private bool Changed => saved is not null && draft is not null &&
        (saved.AllowFreeProfileEditing, saved.AllowUserDelete, saved.AccessCodeLimit) != (draft.AllowFreeProfileEditing, draft.AllowUserDelete, draft.AccessCodeLimit);

    protected override async Task OnInitializedAsync()
    {
        saved = await Client.GetFromJsonAsync<AccessRulesSettings>("api/AccessRules");
        Reset();
    }

    private void Reset() => draft = saved is null ? null : new()
    {
        AllowFreeProfileEditing = saved.AllowFreeProfileEditing, AllowUserDelete = saved.AllowUserDelete, AccessCodeLimit = saved.AccessCodeLimit,
    };

    private async Task Save()
    {
        saving = true;
        // The rules are saved whole: start from the current ones, so Access's rules aren't overwritten with stale values.
        var rules = await Client.GetFromJsonAsync<AccessRulesSettings>("api/AccessRules");
        if (rules is not null)
        {
            rules.AllowFreeProfileEditing = draft!.AllowFreeProfileEditing;
            rules.AllowUserDelete = draft.AllowUserDelete;
            rules.AccessCodeLimit = draft.AccessCodeLimit;
        }
        var res = rules is null ? null : await Client.PutAsJsonAsync("api/AccessRules", rules);
        saving = false;
        if (res is not { IsSuccessStatusCode: true })
        {
            Toast.Show(Localizer["Save Failed"], true);
            return;
        }
        saved = rules;
        Reset();
        Toast.Show(Localizer["Saved"]);
    }
}
