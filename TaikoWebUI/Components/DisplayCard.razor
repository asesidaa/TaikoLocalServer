@* Settings › Display: how finely player cards draw the 3D don-chan for you (kept on this device, the embed reads it,
   and, signed in, on your account so your other devices use it too), and the language song titles show in (on the
   player's web profile: the server names songs with it). *@
@inject HttpClient Client
@inject AuthService AuthService
@inject ToastService Toast
@inject IJSRuntime Js
@inject PlayerSelection Players

<section class="@Css.Card p-5 sm:p-6">
    <h2 class="font-semibold">@Localizer["Display"]</h2>
    <div class="mt-3 flex flex-wrap items-center gap-3">
        <span class="min-w-0 flex-1">
            <span class="block text-sm font-medium">@Localizer["3D quality"]</span>
            <span class="block max-w-2xl text-xs @Css.Muted">@Localizer["High draws don-chan with twice the pixels on ordinary screens, for smoother edges. Low is the lightest, for slow phones and PCs."]</span>
        </span>
        <div class="inline-flex gap-0.5 rounded-xl bg-zinc-100 p-1 dark:bg-zinc-800" role="radiogroup" aria-label="@Localizer["3D quality"]">
            @foreach (var (q, label) in new[] { (RenderQuality.Low, Localizer["Low"].Value), (RenderQuality.Standard, Localizer["Standard"].Value), (RenderQuality.High, Localizer["High"].Value) })
            {
                var on = quality == q;
                <button role="radio" aria-checked="@Css.Aria(on)" @onclick="() => Set(q)"
                        class="rounded-lg px-3 py-1 text-xs font-medium @(on ? "bg-white shadow-sm dark:bg-zinc-900" : "text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-200")">@label</button>
            }
        </div>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-zinc-100 pt-4 dark:border-zinc-800">
        <span class="min-w-0 flex-1">
            <span class="block text-sm font-medium">@Localizer["Song titles"]</span>
            <span class="block max-w-2xl text-xs @Css.Muted">@Localizer["The language song titles show in here."]</span>
        </span>
        <select class="@Css.Input w-auto dark:[&>option]:bg-zinc-900" aria-label="@Localizer["Song titles"]" disabled="@(songLanguage is null)" value="@songLanguage"
                @onchange="e => SetSongLanguage(int.Parse(e.Value!.ToString()!))">
            <option value="-1">@Localizer["My profile's language"]</option>
            @for (var i = 0; i < 4; i++)
            {
                var value = i;
                <option value="@value">@Localizer[GameData.NameLanguages[value]]</option>
            }
        </select>
    </div>
</section>

@code {
    /// <summary>The player whose settings these are (song titles are per player).</summary>
    [Parameter] public uint Baid { get; set; }

    private RenderQuality? quality;
    private int? songLanguage;

    protected override async Task OnParametersSetAsync()
    {
        if (Baid == 0) return;
        try { songLanguage = (await Client.GetFromJsonAsync<UiTheme>($"api/Users/{Baid}/Theme"))?.SongLanguage ?? -1; }
        catch (HttpRequestException) { }
    }

    private async Task SetSongLanguage(int value)
    {
        songLanguage = value;
        var res = await Client.PutAsJsonAsync($"api/Users/{Baid}/Theme", new UiTheme { SongLanguage = value });
        if (!res.IsSuccessStatusCode) { Toast.Show(Localizer["Save Failed"], true); return; }
        // Pages that name songs themselves read it from the loaded player list.
        if (Players.Users.FirstOrDefault(u => u.Baid == Baid) is { } user) user.UserSetting.SongLanguage = value < 0 ? null : (uint)value;
        Toast.Show(Localizer["Saved"]);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        quality = Enum.TryParse<RenderQuality>(await Js.InvokeAsync<string>("ui.getQuality3D"), true, out var q) ? q : RenderQuality.Standard;
        StateHasChanged();
    }

    private async Task Set(RenderQuality q)
    {
        if (quality == q) return;
        quality = q;
        await Js.InvokeVoidAsync("ui.setQuality3D", q.ToString().ToLowerInvariant());
        if (AuthService.LoginRequired && AuthService.IsLoggedIn)
        {
            var res = await Client.PutAsJsonAsync($"api/Users/{AuthService.GetLoggedInBaid()}/Theme", new UiTheme { Quality3D = q });
            if (!res.IsSuccessStatusCode) { Toast.Show(Localizer["Save Failed"], true); return; }
        }
        Toast.Show(Localizer["Saved"]);
    }
}
