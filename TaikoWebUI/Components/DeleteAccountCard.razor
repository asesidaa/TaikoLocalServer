@* Settings: a player deleting their own account, when an admin allows it (Server Management › Player Settings). It
   takes their password, and their 2-step code when that's on (the server asks for it); then they're at Log in. *@
@inject HttpClient Client
@inject AuthService AuthService
@inject NavigationManager Nav
@inject ToastService Toast

<section class="@Css.Card p-5 sm:p-6">
    <div class="flex flex-wrap items-center gap-3">
        <div class="min-w-0 flex-1">
            <h2 class="font-semibold">@Localizer["Delete your account"]</h2>
            <p class="text-sm @Css.Muted">@Localizer["Delete Account Hint"]</p>
        </div>
        <button class="@Danger shrink-0" @onclick="Open"><Icon Name="trash" />@Localizer["Delete account"]</button>
    </div>
</section>

@if (confirming)
{
    <Dialog Title="@Localizer["Delete your account?"]" Alert OnClose="() => confirming = false">
        <ChildContent>
            <p>@Localizer["Delete Account Password Hint"]</p>
            <label class="mt-3 block"><span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Password"]</span>
                <input type="password" autocomplete="current-password" class="@Css.Input mt-1.5" @bind="password" @bind:event="oninput" /></label>
            @if (codeStep)
            {
                <label class="mt-3 block"><span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Code from your authenticator app"]</span>
                    <input type="text" inputmode="numeric" autocomplete="one-time-code" class="@Css.Input mt-1.5 text-center font-mono tracking-widest" @bind="code" @bind:event="oninput" /></label>
            }
            @if (error is not null)
            {
                <p class="mt-3 text-sm text-red-600 dark:text-red-400" role="alert">@error</p>
            }
        </ChildContent>
        <Footer>
            <button class="@Css.GhostButton" @onclick="() => confirming = false">@Localizer["Cancel"]</button>
            <button class="@Danger" disabled="@(password.Length == 0 || (codeStep && code.Trim().Length == 0) || busy)" @onclick="Delete">@Localizer["Delete"]</button>
        </Footer>
    </Dialog>
}

@code {
    private const string Danger = "inline-flex items-center justify-center gap-1.5 rounded-xl bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700 active:scale-[.98] disabled:cursor-not-allowed disabled:opacity-50";

    private bool confirming, codeStep, busy;
    private string password = "", code = "";
    private string? error;

    private void Open()
    {
        (confirming, codeStep, password, code, error) = (true, false, "", "", null);
    }

    private async Task Delete()
    {
        busy = true;
        error = null;
        HttpResponseMessage res;
        try
        {
            res = await Client.PostAsJsonAsync("api/Auth/DeleteAccount", new DeleteAccountRequest { Password = password, Code = codeStep ? code.Trim() : null });
        }
        catch (HttpRequestException)
        {
            busy = false;
            error = Localizer["Couldn't delete the account. Try again."];
            return;
        }
        busy = false;
        if (res.IsSuccessStatusCode)
        {
            // The server ended this account's sessions; forget this one here too.
            await AuthService.Logout();
            Toast.Show(Localizer["Your account was deleted."]);
            // Like Log Out: "/" sends the signed-out visitor to Log in (going there directly raced the sign-out and
            // left a blank page).
            Nav.NavigateTo("/");
            return;
        }
        if (res.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            error = Localizer["Deleting accounts is turned off on this server."];
            return;
        }
        // Shares sign-in's rate limit.
        if (res.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            error = Localizer["Too many tries. Wait a minute, then try again."];
            return;
        }
        var message = (await res.Content.ReadFromJsonAsync<MessageBody>().ContinueWith(t => t.IsCompletedSuccessfully ? t.Result : null))?.Message;
        switch (message)
        {
            case "Code Required":
                codeStep = true;
                break;
            case "Wrong Password":
                // Log in shows it as markup, on two lines.
                error = Localizer["Login Wrong Password Error"].Value.Replace("<br />", " ");
                break;
            case "Wrong Code":
                error = Localizer["That code didn't work. Codes change every 30 seconds, so try the newest one."];
                break;
            default:
                error = Localizer["Couldn't delete the account. Try again."];
                break;
        }
    }

    private sealed record MessageBody(string? Message);
}
