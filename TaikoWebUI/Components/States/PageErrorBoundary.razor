@* Around every page (MainLayout): a load that fails shows the 404 page (the server answered 404) or a "Couldn't load"
   card with Try again, in the page's place, instead of the "unhandled error" bar. Try again builds the page again. *@
@inherits ErrorBoundary
@using System.Net
@inject ILogger<PageErrorBoundary> Logger

@if (CurrentException is null)
{
    @ChildContent
}
else if (CurrentException is HttpRequestException { StatusCode: HttpStatusCode.NotFound })
{
    <NotFoundPage />
}
else
{
    <section class="@Css.Card grid place-items-center px-6 py-14 text-center" role="alert">
        <span class="grid size-12 place-items-center rounded-full bg-red-500/10 text-red-600 dark:text-red-400"><Icon Name="alert" Class="size-6" /></span>
        <h2 class="mt-3 font-semibold">@Localizer["Couldn't load this page"]</h2>
        <p class="mt-1 max-w-sm text-sm @Css.Muted">
            @(CurrentException is HttpRequestException { StatusCode: null }
                ? Localizer["The server didn't answer. Check your connection, then try again. Nothing you changed was lost."]
                : Localizer["Something went wrong on the server. Try again. Nothing you changed was lost."])
        </p>
        <button class="@Css.PrimaryButton mt-4" @onclick="Recover"><Icon Name="rotate" />@Localizer["Try again"]</button>
        <p class="mt-3 font-mono text-[11px] @Css.Muted">@Code · @Localizer["request"] @requestId</p>
    </section>
}

@code {
    private string requestId = "";

    // For a bug report: the HTTP status (or what failed), and an ID that's in the browser console with the details.
    private string Code => CurrentException switch
    {
        HttpRequestException { StatusCode: { } status } => $"{Localizer["Error"]} {(int)status}",
        HttpRequestException => Localizer["No connection"],
        _ => CurrentException!.GetType().Name,
    };

    protected override Task OnErrorAsync(Exception exception)
    {
        requestId = Convert.ToHexString(Guid.NewGuid().ToByteArray()[..3]).ToLowerInvariant();
        // A warning, not stderr: anything on stderr shows Blazor's "unhandled error" bar.
        Logger.LogWarning(exception, "[{RequestId}] Couldn't load the page", requestId);
        return Task.CompletedTask;
    }
}
