@* 404, inside the normal shell: unknown routes (App.razor) and unknown songs, players or IDs (PageErrorBoundary). *@
@inject AuthService AuthService
@inject PlayerSelection Players
@inject PageState Page

<PageTitle>@Localizer["Page not found"]</PageTitle>
<div class="mx-auto grid max-w-md place-items-center py-12 text-center">
    <p class="font-display text-7xl text-primary-500">404</p>
    <h1 class="mt-3 text-xl font-semibold">@Localizer["This page doesn't exist"]</h1>
    <p class="mt-2 text-sm @Css.Muted">@Localizer["The link may be old, or the song, player or page was removed."]</p>
    <div class="mt-6 flex flex-wrap justify-center gap-2">
        <a href="/" class="@Css.PrimaryButton">@Localizer["Go to the Dashboard"]</a>
        @if (Baid > 0)
        {
            <a href="@PlayDataPaths.Of(Baid, PlayDataPaths.Songs)" class="@Css.GhostButton">@Localizer["Song List"]</a>
        }
    </div>
</div>

@code {
    private uint Baid => AuthService.LoginRequired ? AuthService.GetLoggedInBaid() : Players.Baid;

    protected override void OnInitialized() => Page.Set(Localizer["Page not found"]);
}
