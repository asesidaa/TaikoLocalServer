@implements IDisposable
@inject AuthService AuthService
@inject NavigationManager Nav
@inject PlayerSelection Players
@inject IOptions<WebUiSettings> Settings
@using Microsoft.Extensions.Options

<div class="flex h-16 items-center gap-2.5 px-5">
    <DrumMark />
    <span class="font-display text-[17px] tracking-wide">@Settings.Value.Title</span>
</div>
<nav class="flex-1 space-y-0.5 overflow-y-auto px-3 py-2">
    <p class="px-3 pb-1 pt-2 text-[11px] font-medium uppercase tracking-wider text-zinc-400 dark:text-zinc-500">@(AuthService.LoginRequired ? Localizer["Account"] : Localizer["Players"])</p>
    @Link("/", "dashboard", Localizer["Dashboard"])
    @if (Baid > 0)
    {
        @Link($"/Users/{Baid}/Profile", "profile", Localizer["Profile"])
        @Link($"/Users/{Baid}/Songs", "music", Localizer["Song List"], prefix: true)
        @Group("playData", Localizer["Play Data"], playDataOpen, () => playDataOpen = !playDataOpen,
            [($"/Users/{Baid}/Stats", Localizer["Stats"]),
             ($"/Users/{Baid}/HighScores", Localizer["High Scores"]), ($"/Users/{Baid}/PlayHistory", Localizer["Play History"]),
             ($"/Users/{Baid}/DaniDojo", Localizer["Dani Dojo"])])
        @Link("/Settings", "settings", Localizer["Settings"], prefix: true)
    }
    @* Local mode has no accounts: the admin pages are open to everyone, and Access (sign-in rules) doesn't apply. *@
    @if (AuthService.IsAdmin || !AuthService.LoginRequired)
    {
        <p class="px-3 pb-1 pt-4 text-[11px] font-medium uppercase tracking-wider text-zinc-400 dark:text-zinc-500">@Localizer["Admin"]</p>
        @Link("/Users", "users", Localizer["User Management"])
        @Link("/Admin/Server", "server", Localizer["Server Management"], prefix: true)
        @if (AuthService.LoginRequired)
        {
            @Link("/Admin/Access", "shield", Localizer["Access"], prefix: true)
        }
    }
</nav>
@if (AuthService.IsLoggedIn)
{
    <div class="border-t border-zinc-200/80 p-3 dark:border-zinc-800">
        <div class="flex items-center gap-3 rounded-xl px-2 py-2">
            @if (me is not null)
            {
                <Avatar Setting="me.UserSetting" Size="40" />
            }
            else
            {
                <span class="grid size-10 place-items-center rounded-full bg-zinc-200 text-sm font-semibold text-zinc-500 dark:bg-zinc-800">?</span>
            }
            <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-medium">@me?.UserSetting.MyDonName</p>
                <p class="truncate text-xs @Css.Muted">Baid @Baid@(AuthService.IsAdmin ? $" · {Localizer["Admin"]}" : "")</p>
            </div>
            <button class="@Css.IconButton hover:!text-primary-600" aria-label="@Localizer["Log Out"]" @onclick="OnLogout"><Icon Name="logOut" /></button>
        </div>
    </div>
}
else if (!AuthService.LoginRequired)
{
    <p class="border-t border-zinc-200/80 px-5 py-4 text-xs @Css.Muted dark:border-zinc-800">@Localizer["Local mode"]</p>
}

@code {
    private bool playDataOpen = true;
    private User? me;

    // The signed-in user, or (Local mode) the player picked in the top bar.
    private uint Baid => AuthService.LoginRequired ? AuthService.GetLoggedInBaid() : Players.Baid;

    // prefix: the link stays active on its sub-routes (a page's tabs).
    private bool IsActive(string href, bool prefix = false)
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
        return string.Equals(path, href, StringComparison.OrdinalIgnoreCase)
               || (prefix && path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase));
    }

    private RenderFragment Link(string href, string icon, string label, bool prefix = false) => __builder =>
    {
        var active = IsActive(href, prefix);
        <a href="@href" aria-current="@(active ? "page" : null)"
           class="group flex w-full items-center gap-3 rounded-xl px-3 py-2 text-sm transition-colors @(active ? "bg-primary-500/10 font-medium text-primary-700 dark:text-primary-300" : "text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800/70 dark:hover:text-zinc-100")">
            <Icon Name="@icon" /><span class="truncate">@label</span>
        </a>
    };

    private RenderFragment Group(string icon, string label, bool open, Action toggle, IEnumerable<(string Href, string Label)> kids) => __builder =>
    {
        var list = kids.ToList();
        var expanded = open || list.Any(k => IsActive(k.Href));
        <div>
            <button aria-expanded="@Css.Aria(expanded)" @onclick="toggle"
                    class="flex w-full items-center gap-3 rounded-xl px-3 py-2 text-sm text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800/70 dark:hover:text-zinc-100">
                <Icon Name="@icon" /><span class="flex-1 text-left">@label</span>
                <span class="chev @(expanded ? "rotate-180" : "")"><Icon Name="chevDown" /></span>
            </button>
            @if (expanded)
            {
                <div class="fade mt-0.5 space-y-0.5">
                    @foreach (var (href, text) in list)
                    {
                        var active = IsActive(href);
                        <a href="@href" aria-current="@(active ? "page" : null)"
                           class="flex w-full items-center rounded-xl py-2 pl-10 pr-3 text-sm transition-colors @(active ? "bg-primary-500/10 font-medium text-primary-700 dark:text-primary-300" : "text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800/70 dark:hover:text-zinc-100")">
                            <span class="truncate">@text</span>
                            @if (active)
                            {
                                <span class="ml-auto size-2 rounded-full bg-primary-500"></span>
                            }
                        </a>
                    }
                </div>
            }
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        AuthService.LoginStatusChanged += OnAuthChanged;
        Nav.LocationChanged += OnLocationChanged;
        Players.Changed += OnPlayerChanged;
        await LoadUserName();
        if (!AuthService.LoginRequired) await Players.LoadAsync();
    }

    private async Task LoadUserName()
    {
        var user = AuthService.IsLoggedIn ? await AuthService.GetLoggedInUser() : null;
        me = user;
    }

    private async void OnAuthChanged(object? sender, EventArgs e)
    {
        await LoadUserName();
        await InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private void OnPlayerChanged() => InvokeAsync(StateHasChanged);

    /// <summary>The layout asks to confirm: a dialog inside the sidebar would only cover the sidebar (its slide-in transform).</summary>
    [Parameter] public EventCallback OnLogout { get; set; }

    public void Dispose()
    {
        AuthService.LoginStatusChanged -= OnAuthChanged;
        Nav.LocationChanged -= OnLocationChanged;
        Players.Changed -= OnPlayerChanged;
    }
}
