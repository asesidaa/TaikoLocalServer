@implements IDisposable
@inject AuthService AuthService
@inject NavigationManager Nav
@inject PlayerSelection Players
@inject AdminView View
@inject IOptions<WebUiSettings> Settings
@using Microsoft.Extensions.Options

<div class="flex h-16 items-center gap-2.5 px-5">
    <DrumMark />
    <span class="font-display text-[17px] tracking-wide">@Settings.Value.Title</span>
</div>
<nav class="flex-1 space-y-0.5 overflow-y-auto px-3 py-2">
    <p class="truncate px-3 pb-1 pt-2 text-[11px] font-medium uppercase tracking-wider text-zinc-400 dark:text-zinc-500">@(View.Baid > 0 ? string.Format(Localizer["{0} (admin view)"], ViewName) : AuthService.LoginRequired ? Localizer["Account"] : Localizer["Players"])</p>
    @Link(View.Baid > 0 ? $"/Users/{Baid}/Dashboard" : "/", "dashboard", Localizer["Dashboard"])
    @if (Baid > 0)
    {
        @if (AuthService.EnabledGames.Count > 1)
        {
            @* Which game's pages these are; switching keeps the page when that game has it. *@
            <GameMenu Games="AuthService.EnabledGames" Value="@Game" ValueChanged="SwitchGame" Class="my-1.5" Dim="@(View.Played is { } played ? g => !played.Contains(g) : null)" />
        }
        @Link(EraPaths.Profile(Baid, Game), "profile", Localizer["Profile"])
        @* The game's whole song list (with this player's results): its own item, not a Play Data page. *@
        @Link(EraPaths.Of(Baid, Game, PlayDataPaths.Songs), "music", Localizer["Song List"], prefix: true)
        @if (Game == "Green")
        {
            @Link(EraPaths.Friends(Baid), "users", Localizer["Friends"])
        }
        @* Play Data: the label opens its index, the chevron folds its pages away (they stay shown while one is open). *@
        var playDataShown = playDataOpen || OnPlayDataPage;
        <div class="flex items-center gap-0.5">
            <div class="min-w-0 flex-1">@Link(EraPaths.Index(Baid, Game), "playData", Localizer["Play Data"])</div>
            <button class="@Css.IconButton" aria-expanded="@Css.Aria(playDataShown)" aria-controls="nav-play-data"
                    aria-label="@Localizer["Play Data"]" @onclick="() => playDataOpen = !playDataShown">
                <span class="chev @(playDataShown ? "rotate-180" : "")"><Icon Name="chevDown" /></span>
            </button>
        </div>
        @if (playDataShown)
        {
            <div id="nav-play-data" class="fade space-y-0.5">
                @foreach (var page in EraPaths.PagesOf(Game))
                {
                    @Sub(page, PageLabel(page))
                }
            </div>
        }
        @Link(View.Baid > 0 ? $"/Users/{Baid}/Settings" : "/Settings", "settings", Localizer["Settings"], prefix: true)
    }
    @* Local mode has no accounts: the admin pages are open to everyone, and Access (sign-in rules) doesn't apply. *@
    @if (AuthService.IsAdmin || !AuthService.LoginRequired)
    {
        <p class="px-3 pb-1 pt-4 text-[11px] font-medium uppercase tracking-wider text-zinc-400 dark:text-zinc-500">@Localizer["Admin"]</p>
        @Link("/Users", "users", Localizer["User Management"])
        @Link("/Admin/Server", "server", Localizer["Server Management"], prefix: true)
        @if (AuthService.LoginRequired)
        {
            @Link("/Admin/Access", "shield", Localizer["Access"], prefix: true)
        }
    }
</nav>
@if (AuthService.IsLoggedIn)
{
    <div class="border-t border-zinc-200/80 p-3 dark:border-zinc-800">
        <div class="flex items-center gap-3 rounded-xl px-2 py-2">
            @if (me is not null)
            {
                <Avatar Setting="me.UserSetting" Size="40" />
            }
            else
            {
                <span class="grid size-10 place-items-center rounded-full bg-zinc-200 text-sm font-semibold text-zinc-500 dark:bg-zinc-800">?</span>
            }
            <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-medium">@me?.UserSetting.MyDonName</p>
                <p class="truncate text-xs @Css.Muted">ID: @AuthService.GetLoggedInBaid()@(AuthService.IsAdmin ? $" · {Localizer["Admin"]}" : "")</p>
            </div>
            <button class="@Css.IconButton hover:!text-primary-600" aria-label="@Localizer["Log Out"]" @onclick="OnLogout"><Icon Name="logOut" /></button>
        </div>
    </div>
}
else if (!AuthService.LoginRequired)
{
    <p class="border-t border-zinc-200/80 px-5 py-4 text-xs @Css.Muted dark:border-zinc-800">@Localizer["Local mode"]</p>
}

@code {
    private User? me;

    // Whose pages the player links open: the player in the admin view, else the signed-in user, or (Local mode) the
    // player picked in the top bar.
    private uint Baid => View.Baid > 0 ? View.Baid : AuthService.LoginRequired ? AuthService.GetLoggedInBaid() : Players.Baid;
    private string ViewName => View.Name.Length > 0 ? View.Name : $"#{View.Baid}";

    // prefix: the link stays active on its sub-routes (a page's tabs).
    private bool IsActive(string href, bool prefix = false)
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
        return string.Equals(path, href, StringComparison.OrdinalIgnoreCase)
               || (prefix && path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase));
    }

    private RenderFragment Link(string href, string icon, string label, bool prefix = false) => __builder =>
    {
        var active = IsActive(href, prefix);
        <a href="@href" aria-current="@(active ? "page" : null)"
           class="group flex w-full items-center gap-3 rounded-xl px-3 py-2 text-sm transition-colors @(active ? "bg-primary-500/10 font-medium text-primary-700 dark:text-primary-300" : "text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800/70 dark:hover:text-zinc-100")">
            <Icon Name="@icon" /><span class="truncate">@label</span>
        </a>
    };

    private bool playDataOpen = true;
    private bool OnPlayDataPage => ("/" + Nav.ToBaseRelativePath(Nav.Uri)) is var path
        && path.StartsWith(EraPaths.Index(Baid, Game) + "/", StringComparison.OrdinalIgnoreCase) && !IsActive(EraPaths.Of(Baid, Game, PlayDataPaths.Songs), prefix: true);

    // The game the player pages are for: the page's own when it's in one, else the last one picked.
    private string picked = EraPaths.Nijiiro;
    private string Game
    {
        get
        {
            var path = "/" + Nav.ToBaseRelativePath(Nav.Uri);
            if (EraPaths.Switch(path, Baid, EraPaths.Nijiiro) is not null || EraPaths.GameOf(path) != EraPaths.Nijiiro) picked = EraPaths.GameOf(path);
            return AuthService.EnabledGames.Contains(picked) ? picked
                : AuthService.NijiiroOn ? EraPaths.Nijiiro : GameInfo.All.First(g => AuthService.EnabledGames.Contains(g.Name)).Name;
        }
    }

    private void SwitchGame(string to)
    {
        picked = to;
        Nav.NavigateTo(EraPaths.Switch("/" + Nav.ToBaseRelativePath(Nav.Uri), Baid, to) ?? EraPaths.Index(Baid, to));
    }

    private string PageLabel(string page) => page switch
    {
        PlayDataPaths.Stats => Localizer["Stats"], PlayDataPaths.Songs => Localizer["Song List"], PlayDataPaths.Favourites => Localizer["Favourites"],
        PlayDataPaths.HighScores => Localizer["High Scores"], PlayDataPaths.PlayHistory => Localizer["Play History"],
        PlayDataPaths.DaniDojo => Localizer["Dani Dojo"], EraPaths.Shop => Localizer["Item shop"], EraPaths.Battle => Localizer["Battle mode"], EraPaths.Training => Localizer["Training"], EraPaths.Ghost => Localizer["Ghost battles"], _ => Localizer["Don Challenge"],
    };

    // A Play Data page, indented under it.
    private RenderFragment Sub(string page, string label, bool prefix = false) => __builder =>
    {
        var href = EraPaths.Of(Baid, Game, page);
        var active = IsActive(href, prefix);
        <a href="@href" aria-current="@(active ? "page" : null)"
           class="flex w-full items-center rounded-xl py-2 pl-10 pr-3 text-sm transition-colors @(active ? "bg-primary-500/10 font-medium text-primary-700 dark:text-primary-300" : "text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800/70 dark:hover:text-zinc-100")">
            <span class="truncate">@label</span>
            @if (active)
            {
                <span class="ml-auto size-2 rounded-full bg-primary-500"></span>
            }
        </a>
    };

    protected override async Task OnInitializedAsync()
    {
        AuthService.LoginStatusChanged += OnAuthChanged;
        Nav.LocationChanged += OnLocationChanged;
        Players.Changed += OnPlayerChanged;
        View.Changed += OnPlayerChanged;
        await LoadUserName();
        if (!AuthService.LoginRequired) await Players.LoadAsync();
    }

    private async Task LoadUserName()
    {
        // Keeps the name it has if the server can't be reached.
        me = AuthService.IsLoggedIn ? await AuthService.GetLoggedInUser() ?? me : null;
    }

    private async void OnAuthChanged(object? sender, EventArgs e)
    {
        await LoadUserName();
        await InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private void OnPlayerChanged() => InvokeAsync(StateHasChanged);

    /// <summary>The layout asks to confirm: a dialog inside the sidebar would only cover the sidebar (its slide-in transform).</summary>
    [Parameter] public EventCallback OnLogout { get; set; }

    public void Dispose()
    {
        AuthService.LoginStatusChanged -= OnAuthChanged;
        Nav.LocationChanged -= OnLocationChanged;
        Players.Changed -= OnPlayerChanged;
        View.Changed -= OnPlayerChanged;
    }
}
