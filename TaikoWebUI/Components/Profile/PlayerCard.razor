@* The player's card: 3D don-chan (display-only embed covering the whole card so costumes never clip),
   name, and the game nameplate. DanView = the Dani Dojo look (段位道場 outfit for the top rank, no puchi,
   Clear animation, and a dan panel under the nameplate). Colour, pattern, fade and animation come from the
   user's card settings (UserWebProfiles; see Shared/CardStyle.cs). *@
@implements IDisposable
@inject IJSRuntime Js
@inject OverlayHost Overlay
@inject IOptions<WebUiSettings> Settings
@inject AuthService Auth
@using Microsoft.Extensions.Options

<section class="relative overflow-hidden rounded-3xl shadow-[0_8px_24px_-12px_rgba(0,0,0,.4)] @(LightText ? "text-zinc-900" : "text-white")" aria-label="@Localizer["Player card"]"
         style="@CardStyle.Background(Setting.CardColor, Setting.CardPattern)">
    @if (Setting.CardFade >= 0)
    {
        @* The fade sits behind don-chan, the name and the nameplate; the text contrast follows it. *@
        <div class="absolute inset-x-0 bottom-0 h-3/5" style="background:linear-gradient(to top, @GameData.Color((uint)Setting.CardFade) 15%, transparent)"></div>
    }
    @if (HasEmbed)
    {
        <iframe @ref="frame" src="@EmbedSrc" title="@Localizer["3D preview"]" class="pointer-events-none absolute inset-0 size-full border-0" loading="lazy"></iframe>
        @* The iframe is display-only (no pointer events), so the button above it gets the click. *@
        @if (!DanView)
        {
            <button class="absolute right-3 top-3 z-10 grid size-8 place-items-center rounded-xl bg-black/25 text-white backdrop-blur transition-colors hover:bg-black/40"
                    aria-label="@Localizer["View don-chan larger"]" title="@Localizer["View larger"]" @onclick="() => Overlay.Show(BigView)">
                <Icon Name="expand" Class="size-4" />
            </button>
        }
    }
    <div class="relative grid grid-cols-[160px_minmax(0,1fr)] items-center gap-4 p-4 lg:grid-cols-1 lg:gap-2 lg:p-5">
        <div @ref="anchor" class="relative grid h-40 place-items-center lg:h-80">
            @if (!HasEmbed)
            {
                <span class="opacity-90"><DrumMark Size="96" /></span>
            }
        </div>
        <div class="min-w-0 lg:text-center">
            <p class="font-display truncate text-2xl @(LightText ? "" : "drop-shadow-[0_2px_0_rgba(0,0,0,.2)]")">@(string.IsNullOrEmpty(Setting.MyDonName) ? " " : Setting.MyDonName)</p>
            @if (Setting.FriendCode.Length == 12)
            {
                @* Friend code: digits in groups of four, no label (the accessible name and tooltip say it); copies without spaces. *@
                <span class="relative mt-1.5 inline-block">
                    <button class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold tabular-nums tracking-wide transition-colors @(LightText ? "bg-black/10 hover:bg-black/15" : "bg-black/25 hover:bg-black/35")"
                            aria-label="@string.Format(Localizer["Friend code {0}, copy"], FriendCodeGroups)" title="@Localizer["Friend code · click to copy"]" @onclick="CopyFriendCode">
                        @FriendCodeGroups<Icon Name="copy" Class="size-3.5 opacity-70" />
                    </button>
                    @if (copied)
                    {
                        <span role="status" class="fade pointer-events-none absolute left-1/2 top-full z-10 mt-1.5 -translate-x-1/2 whitespace-nowrap rounded-lg bg-zinc-950/90 px-2 py-1 text-xs text-white shadow-lg">@Localizer["Friend Code copied!"]</span>
                    }
                </span>
            }
            @* In the strip (<lg) the plate sits beside the 160px don-chan slot, so it's capped at 3/4 of its 352px. *@
            <div class="mt-3 max-w-[264px] lg:mx-auto lg:max-w-[352px]">
                <Nameplate Title="@Setting.Title" Name="@Setting.MyDonName" Language="@Setting.MyDonNameLanguage" PlateId="@Setting.TitlePlateId"
                           DanBadge="@(Setting.IsDisplayDanOnNamePlate ? TopDanBadge : null)" />
            </div>
            @if (DanView)
            {
                <div class="mx-auto mt-2 flex w-full max-w-[352px] items-center gap-3 rounded-2xl bg-zinc-950/85 p-3 text-left text-white">
                    @if (TopDan is { } top)
                    {
                        <div class="min-w-0 flex-1">
                            <p class="text-xs text-zinc-400">@Localizer["Dani Dojo"]</p>
                            <p class="font-display text-xl">@Localizer[GameData.Dans[top.DanId - 1].Key]</p>
                            <p class="text-xs text-zinc-300">@(GameData.IsGold(top.ClearState) ? Localizer["Gold pass"] : Localizer["Passed"])</p>
                        </div>
                        <img data-asset="@GameData.DanStamp(top.ClearState)" alt="" class="size-12 object-contain" />
                    }
                    else
                    {
                        <p class="flex-1 text-center text-sm">@Localizer["No Dani Dojo pass yet"]</p>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public UserSetting Setting { get; set; } = new();
    /// <summary>The player's best result per dan, used for the nameplate badge and the Dani Dojo look.</summary>
    [Parameter] public IReadOnlyList<DanBestData> Dans { get; set; } = [];
    [Parameter] public bool DanView { get; set; }

    private ElementReference frame, anchor;

    // Text sits over the fade when there is one, otherwise over the background.
    private bool LightText => CardStyle.IsLight(GameData.Color(Setting.CardFade >= 0 ? (uint)Setting.CardFade : Setting.CardColor));
    private bool copied;

    private string FriendCodeGroups => string.Join(' ', Setting.FriendCode.Chunk(4).Select(c => new string(c)));

    private async Task CopyFriendCode()
    {
        if (!await Js.InvokeAsync<bool>("ui.copy", Setting.FriendCode)) return;
        copied = true;
        StateHasChanged();
        await Task.Delay(1400);
        copied = false;
    }

    private bool HasEmbed => !string.IsNullOrWhiteSpace(Settings.Value.DonEmbedUrl);
    private string EmbedSrc => Settings.Value.DonEmbedUrl;

    private DanBestData? TopDan => Dans.Where(d => d.ClearState != DanClearState.NotClear && d.DanId is >= 1 and <= 19)
        .MaxBy(d => d.DanId);

    private string? TopDanBadge => TopDan is { } d ? $"{GameData.Dans[d.DanId - 1].Badge}_{(GameData.IsGold(d.ClearState) ? "gold" : "red")}" : null;

    // Kigurumi 36 (段位道場) has one variant per rank: cos_036007 = 五級 … cos_036025 = 達人 (DanId 1…19).
    private string? DanCostume => TopDan is { } d ? $"{36006 + d.DanId:000000}" : "036000";

    private object DonState(double zoom, double camY) => new
    {
        body = Setting.Body, head = Setting.Head, kigurumi = Setting.Kigurumi, face = Setting.Face,
        puchi = DanView ? 0 : Setting.Puchi,
        bodyColor = Setting.BodyColor, faceColor = Setting.FaceColor, limbColor = Setting.LimbColor,
        anim = DanView ? CardStyle.Clip(CardAnimation.Clear) : CardStyle.Clip(Setting.CardAnimation),
        cosFile = DanView ? DanCostume : "",
        zoom, camY,
    };

    // The large 3D view (rendered by the layout): its own embed, configured by its URL, framed so the feet clear the bottom.
    private RenderFragment BigView => __builder =>
    {
        var src = $"{EmbedSrc}?body={Setting.Body}&head={Setting.Head}&kigurumi={Setting.Kigurumi}&face={Setting.Face}&puchi={Setting.Puchi}" +
                  $"&bodyColor={Setting.BodyColor}&faceColor={Setting.FaceColor}&limbColor={Setting.LimbColor}" +
                  $"&anim={Uri.EscapeDataString(CardStyle.Clip(Setting.CardAnimation))}&zoom=0.22&camY=0.19";
        <div class="fade fixed inset-0 z-[60] grid place-items-center bg-black/60 p-4" @onclick="Overlay.Hide">
            <div role="dialog" aria-modal="true" aria-label="@Localizer["Don-chan"]" class="pop w-full max-w-3xl overflow-hidden rounded-3xl bg-white shadow-2xl dark:bg-zinc-900"
                 @onclick:stopPropagation="true">
                <div class="relative h-[480px] sm:h-[560px]" style="@CardStyle.Background(Setting.CardColor, Setting.CardPattern)">
                    <iframe src="@src" title="@Localizer["3D preview"]" class="pointer-events-none absolute inset-0 size-full border-0"></iframe>
                    <button class="absolute right-3 top-3 z-10 grid size-10 place-items-center rounded-xl bg-black/25 text-white backdrop-blur hover:bg-black/40"
                            aria-label="@Localizer["Close"]" @onclick="Overlay.Hide"><Icon Name="x" Class="size-5" /></button>
                </div>
            </div>
        </div>
    };

    public void Dispose() => Overlay.Hide();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!HasEmbed) return;
        await Js.InvokeVoidAsync("ui.don", frame, anchor, DonState(0.25, 0.2));
        // The avatar shows the normal costume, so the Dani Dojo look never makes one; nor does the browser when the
        // server draws them.
        if (!DanView && !Auth.ServerAvatars)
            await Js.InvokeVoidAsync("ui.avatar", frame, Setting.Baid, CardStyle.AvatarKey(Setting));
    }
}
