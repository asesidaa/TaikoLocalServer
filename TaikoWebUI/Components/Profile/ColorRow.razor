@* Compact colour row: label + current swatch/name button; the popover is a 12×4 hue grid, neutrals and the
   classic 8. It stays open while you try colours (live preview) and closes on an outside click or Escape. *@
<div class="relative flex items-center justify-between gap-3 py-1" @onkeydown="OnKey">
    <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">@Label</span>
    <button type="button" aria-haspopup="dialog" aria-expanded="@Css.Aria(open)" @onclick="() => open = !open"
            class="flex h-10 items-center gap-2.5 rounded-xl border border-zinc-200 bg-zinc-50 pl-2 pr-2.5 text-sm hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800/60 dark:hover:border-zinc-600">
        @Swatch(Value, false)
        <span class="w-20 text-left">@GameData.ColorName(Value)</span>
        <Icon Name="chevDown" Class="size-4 text-zinc-400" />
    </button>
    @if (open)
    {
        <div class="fixed inset-0 z-30" @onclick="() => open = false"></div>
        <div role="dialog" aria-label="@Label" style="--origin:top right" class="pop absolute right-0 top-12 z-40 w-max rounded-2xl border border-zinc-200 bg-white p-4 shadow-xl dark:border-zinc-800 dark:bg-zinc-900">
            <div role="radiogroup" aria-label="@Label" class="grid grid-flow-col grid-rows-4 gap-2">
                @foreach (var (_, ids) in GameData.Hues)
                {
                    @foreach (var i in ids.Reverse())
                    {
                        @Swatch(i, true)
                    }
                }
            </div>
            <div class="mt-3 flex items-center gap-2 border-t border-zinc-100 pt-3 dark:border-zinc-800">
                @foreach (var i in GameData.Neutrals)
                {
                    @Swatch(i, true)
                }
            </div>
            <p class="mt-3 text-xs font-medium @Css.Muted">@Localizer["Classic"]</p>
            <div class="mt-1.5 flex items-center gap-2">
                @foreach (var i in GameData.Classic)
                {
                    @Swatch(i, true)
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public uint Value { get; set; }
    [Parameter] public EventCallback<uint> ValueChanged { get; set; }

    private bool open;

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") open = false;
    }

    // 24px circles drawn as SVG (pixel-grid rule); the selected one gets a white inner + dark outer ring.
    private RenderFragment Swatch(uint i, bool pickable) => __builder =>
    {
        var on = pickable && i == Value;
        if (pickable)
        {
            <button type="button" role="radio" aria-checked="@Css.Aria(on)" aria-label="@GameData.ColorName(i)" title="@GameData.ColorName(i)"
                    class="relative size-6 rounded-full outline-none focus-visible:ring-2 focus-visible:ring-primary-500" style="background:@GameData.Color(i)"
                    @onclick="() => ValueChanged.InvokeAsync(i)">
                @Ring(on)
            </button>
        }
        else
        {
            <span class="relative size-6 rounded-full" style="background:@GameData.Color(i)">@Ring(false)</span>
        }
    };

    private static RenderFragment Ring(bool on) => __builder =>
    {
        <svg class="absolute inset-0 size-6" viewBox="0 0 24 24" aria-hidden="true">
            @if (on)
            {
                <circle cx="12" cy="12" r="11" fill="none" stroke="#fff" stroke-width="2" />
                <circle cx="12" cy="12" r="11.5" fill="none" stroke="rgba(0,0,0,.35)" stroke-width="1" />
            }
            else
            {
                <circle cx="12" cy="12" r="11.5" fill="none" stroke="rgba(0,0,0,.12)" stroke-width="1" />
            }
        </svg>
    };
}
