@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService AuthService
@inject PageState Page
@inject ToastService Toast
@inject OverlayHost Overlay
@inject AssetStatus AssetStatus
@inject NavigationManager Nav
@inject HttpClient Client
@inject AppStatus Status
@inject GameDataService GameDataService
@inject PlayerSelection Players

@if (!AuthService.Ready)
{
    @* A moment at start-up, until the saved sign-in is read (see AuthService.Ready). *@
}
else if ((AuthService.LoginRequired && !AuthService.IsLoggedIn) || OnSetup)
{
    @* Logged out, or first-run setup: auth layout, no sidebar. Brand left, language + theme right, card centred. *@
    <div class="flex min-h-dvh flex-col">
        <header class="flex h-16 items-center gap-2.5 px-4 sm:px-6">
            @if (!OnSetup)
            {
                <DrumMark />
            }
            <span class="font-display text-[17px] tracking-wide">@AuthService.ServerName</span>
            @if (OnSetup)
            {
                <span class="ml-2 rounded-full bg-zinc-200 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">@Localizer["Setup"]</span>
            }
            <div class="ml-auto flex items-center gap-1"><TopControls /></div>
        </header>
        <main class="flex flex-1 flex-col items-center justify-center px-4 pb-24 pt-4 sm:pb-32">@Body</main>
    </div>
}
else
{
    @* Console: persistent labelled sidebar (a drawer below lg), breadcrumbs + controls in the top bar. *@
    <div class="min-h-dvh lg:pl-64">
        @if (drawerOpen)
        {
            <div data-drawer-close class="fade fixed inset-0 z-30 bg-black/40 lg:hidden" @onclick="() => drawerOpen = false"></div>
        }
        <aside id="app-nav" class="drawer fixed inset-y-0 left-0 z-40 flex w-64 flex-col border-r border-zinc-200/80 bg-white dark:border-zinc-800 dark:bg-zinc-900 lg:translate-x-0 @(drawerOpen ? "translate-x-0" : "-translate-x-full")">
            <NavMenu OnLogout="() => confirmLogout = true" />
        </aside>
        <header class="sticky top-0 z-20 flex h-16 items-center gap-3 border-b border-zinc-200/80 bg-zinc-50/80 px-4 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/80 sm:px-6">
            <button class="@Css.IconButton lg:hidden" aria-label="@Localizer["Open navigation"]" aria-expanded="@Css.Aria(drawerOpen)" aria-controls="app-nav" @onclick="() => drawerOpen = !drawerOpen"><Icon Name="menu" /></button>
            <nav aria-label="Breadcrumb" class="flex min-w-0 items-center gap-1.5 text-sm">
                @* Phones show only the page itself, with a back button when its parent is a page (Play Data, Song List); the trail from sm. *@
                @if (Page.Crumbs.Count > 1 && Page.Crumbs[^2] is { Href: { } parent } up)
                {
                    <a href="@parent" aria-label="@string.Format(Localizer["Back to {0}"], up.Text)" class="-ml-1 grid size-8 shrink-0 place-items-center rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 sm:hidden"><Icon Name="chevLeft" Class="size-4" /></a>
                }
                @for (var i = 0; i < Page.Crumbs.Count; i++)
                {
                    var last = i == Page.Crumbs.Count - 1;
                    var crumb = Page.Crumbs[i];
                    if (i > 0)
                    {
                        <Icon Name="chevRight" Class="size-4 shrink-0 text-zinc-400 max-sm:hidden" />
                    }
                    if (!last && crumb.Href is { } href)
                    {
                        <a href="@href" class="truncate @Css.Muted hover:text-zinc-900 hover:underline dark:hover:text-zinc-100 max-sm:hidden">@crumb.Text</a>
                    }
                    else
                    {
                        <span class="truncate @(last ? "font-medium" : Css.Muted + " max-sm:hidden")" aria-current="@(last ? "page" : null)">@crumb.Text</span>
                    }
                }
            </nav>
            <div class="ml-auto flex items-center gap-1">
                @if (Page.Save is { } save)
                {
                    @* Autosave pages only. On phones the icon alone; the text stays in the accessible status. *@
                    <span class="mr-1 flex items-center gap-1.5 text-xs @Css.Muted" role="status">
                        @switch (save)
                        {
                            case PageState.SaveStatus.Saving: <Icon Name="rotate" Class="size-4 animate-spin" /><span class="max-sm:sr-only">@Localizer["Saving…"]</span> break;
                            case PageState.SaveStatus.Saved: <Icon Name="check" Class="size-4 text-emerald-500" /><span class="max-sm:sr-only">@Localizer["Saved"]</span> break;
                            default: <Icon Name="cloud" Class="size-4" /><span class="max-sm:sr-only">@Localizer["All changes saved"]</span> break;
                        }
                    </span>
                }
                @if (OnAdminPage && Page.ServerState is { } state)
                {
                    <span class="mr-1"><TaikoWebUI.Components.Admin.ServerStatePill State="state" /></span>
                }
                @if (!AuthService.LoginRequired)
                {
                    <PlayerSwitcher />
                }
                <TopControls />
            </div>
        </header>
        <ConnectionBar />
        <main class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8">
            <ServerBanner Admin="Unaffected" />
            <AdminViewBanner />
            @if (AuthService.TwoFactorSetupRequired && !Nav.Uri.Contains("/Settings", StringComparison.OrdinalIgnoreCase))
            {
                <div role="alert" class="mb-6 flex flex-wrap items-center gap-3 rounded-2xl border border-amber-500/30 bg-amber-500/10 p-4 text-sm text-amber-800 dark:text-amber-200">
                    <Icon Name="shield" Class="size-5" />
                    <p class="min-w-0 flex-1">@Localizer["Turn on 2-step verification to use the admin pages."]</p>
                    <a href="/Settings" class="font-semibold underline underline-offset-2">@Localizer["Set it up"]</a>
                </div>
            }
            @if ((NijiiroMissing || olderMissing.Count > 0) && CanFixAssets)
            {
                @* Only people who can fix it see this; players just get the plain fallbacks. An older game's missing folder
                   is named too, but only Nijiiro's files change the whole site. *@
                var names = (NijiiroMissing ? ["Nijiiro"] : Array.Empty<string>()).Concat(olderMissing).ToList();
                <div role="alert" class="mb-6 flex flex-wrap items-center gap-3 rounded-2xl border border-amber-500/30 bg-amber-500/10 p-4 text-sm text-amber-800 dark:text-amber-200">
                    <Icon Name="alert" Class="size-5" />
                    <p class="min-w-0 flex-1">
                        @if (AuthService.EnabledGames.Count == 1)
                        {
                            @Localizer["Game files are missing. Cabinets can't play and pages show IDs instead of names."]
                        }
                        else if (NijiiroMissing)
                        {
                            @string.Format(Localizer["Game files are missing for {0}. Cabinets can't play and pages show IDs instead of names."], AndList(names))
                        }
                        else
                        {
                            @string.Format(Localizer["Game files are missing for {0}. {0} cabinets can't load songs or events."], AndList(names))
                        }
                    </p>
                    <a href="@(NijiiroMissing ? "/Admin/Server/data" : "/Admin/Server")" class="font-semibold underline underline-offset-2">@(NijiiroMissing ? Localizer["Add them"] : Localizer["Fix it"])</a>
                </div>
            }
            @if (Status.Server?.Current == ServerState.Offline && !Unaffected)
            {
                <OfflinePage />
            }
            else
            {
                <PageErrorBoundary @ref="boundary"><NotPlayedGate>@Body</NotPlayedGate></PageErrorBoundary>
            }
        </main>
    </div>
}

@if (confirmLogout)
{
    <Dialog Title="@Localizer["Log Out"]" Alert OnClose="() => confirmLogout = false">
        <ChildContent>@Localizer["Log Out Confirm"]</ChildContent>
        <Footer>
            <button class="@Css.GhostButton" @onclick="() => confirmLogout = false">@Localizer["Cancel"]</button>
            <button class="@Css.PrimaryButton" @onclick="Logout">@Localizer["Log Out"]</button>
        </Footer>
    </Dialog>
}

@if (Overlay.Content is { } overlayContent)
{
    @* Page-level overlays (OverlayHost): outside every column, so nothing on the page paints over them. *@
    <div @ref="overlayRoot" tabindex="-1" class="outline-none" @onkeydown="OnOverlayKey">@overlayContent</div>
}

@if (Status.SignInNeeded)
{
    <SignInAgainDialog />
}

@if (Toast.Message is { } message)
{
    <div role="status" class="pop fixed bottom-6 right-6 z-50 flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm shadow-lg @(Toast.IsError ? "bg-primary-600 text-white" : "bg-zinc-900 text-white dark:bg-white dark:text-zinc-900")" style="--origin:bottom right">
        <Icon Name="@(Toast.IsError ? "alert" : "check")" />@message
    </div>
}

@code {
    private bool drawerOpen;
    private PageErrorBoundary? boundary;

    // Admins, and everyone in Local mode, keep working in every server state (ServerStateFilter).
    private bool Unaffected => !AuthService.LoginRequired || AuthService.IsAdmin;

    private void OnSavingPaused() => Toast.ShowFirm(Localizer["Saving is paused during maintenance"]);
    private ElementReference overlayRoot;
    private bool overlayFocused;

    // Focus the overlay when it opens, so Escape reaches it.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Overlay.Content is null) { overlayFocused = false; return; }
        if (overlayFocused) return;
        overlayFocused = true;
        await overlayRoot.FocusAsync();
    }

    private void OnOverlayKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Overlay.Hide();
    }
    private bool confirmLogout;

    private async Task Logout()
    {
        confirmLogout = false;
        await AuthService.Logout();
        Nav.NavigateTo("/");
    }
    private bool assetsMissing;
    private List<string> olderMissing = [];

    // Admins (or everyone when login is off) can run the extractor; api/Assets needs a logged-in user.
    private bool CanFixAssets => AuthService.IsAdmin || !AuthService.LoginRequired;

    private bool OnAdminPage => CanFixAssets && Nav.ToBaseRelativePath(Nav.Uri).StartsWith("admin", StringComparison.OrdinalIgnoreCase);

    // Loaded once on the first admin page; the Status tab updates it after a change.
    private async Task LoadServerState()
    {
        if (!OnAdminPage || Page.ServerState is not null || (AuthService.LoginRequired && !AuthService.IsLoggedIn)) return;
        try
        {
            if (await Client.GetFromJsonAsync<ServerStateSettings>("api/ServerState") is { } s) Page.SetServerState(s.Current);
        }
        catch (HttpRequestException)
        {
            // Not an admin after all, or the server is down: no pill.
        }
    }

    private bool OnSetup => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("setup", StringComparison.OrdinalIgnoreCase);

    // Server mode without an admin: only the setup page is open (cabinets keep working; they don't use the WebUI).
    private void RequireSetup()
    {
        if (AuthService.SetupPending && !OnSetup) Nav.NavigateTo("/setup", replace: true);
    }

    protected override async Task OnInitializedAsync()
    {
        RequireSetup();
        AuthService.LoginStatusChanged += OnChanged;
        Page.Changed += Refresh;
        Toast.Changed += Refresh;
        Overlay.Changed += Refresh;
        Status.Changed += Refresh;
        Status.SavingPaused += OnSavingPaused;
        Nav.LocationChanged += OnLocationChanged;
        Players.Changed += OnPlayerChanged;
        await LoadSongLanguage();
        await CheckAssets();
        await LoadServerState();
    }

    private async Task CheckAssets()
    {
        if (!CanFixAssets || (AuthService.LoginRequired && !AuthService.IsLoggedIn)) return;
        assetsMissing = await AssetStatus.IsMissingAsync();
        if (AuthService.EnabledGames.Count == 1 && AuthService.NijiiroOn) return;
        try
        {
            olderMissing = (await Client.GetFromJsonAsync<List<GameStatus>>("api/Games") ?? [])
                .Where(g => g.Enabled && g.Era != "Nijiiro" && (!g.FolderFound || g.Error is not null)).Select(g => g.Era).ToList();
        }
        catch (HttpRequestException)
        {
            // The banner just leaves the older games out.
        }
    }

    private bool NijiiroMissing => assetsMissing && AuthService.NijiiroOn;

    private string AndList(List<string> names) =>
        names.Count == 1 ? names[0] : string.Format(Localizer["{0} and {1}"], string.Join(", ", names[..^1]), names[^1]);

    private async void OnChanged(object? sender, EventArgs e)
    {
        await LoadSongLanguage();
        await CheckAssets();
        Refresh();
    }
    private void Refresh() => InvokeAsync(StateHasChanged);

    // Song titles everywhere follow the viewer's language: the signed-in player's, or in Local mode the picked one's.
    private Task LoadSongLanguage() =>
        GameDataService.LoadSongLanguageAsync(AuthService.LoginRequired ? (AuthService.IsLoggedIn ? AuthService.GetLoggedInBaid() : 0) : Players.Baid);

    private async void OnPlayerChanged()
    {
        if (AuthService.LoginRequired) return;
        await LoadSongLanguage();
        Refresh();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        drawerOpen = false;
        // A page that failed to load doesn't keep the next one from showing.
        boundary?.Recover();
        _ = Status.RefreshState(TimeSpan.FromSeconds(15));
        RequireSetup();
        _ = LoadServerState();
        Refresh();
    }

    public void Dispose()
    {
        AuthService.LoginStatusChanged -= OnChanged;
        Players.Changed -= OnPlayerChanged;
        Page.Changed -= Refresh;
        Toast.Changed -= Refresh;
        Overlay.Changed -= Refresh;
        Status.Changed -= Refresh;
        Status.SavingPaused -= OnSavingPaused;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
