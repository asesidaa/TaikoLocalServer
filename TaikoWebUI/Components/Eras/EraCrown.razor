@* An older game's result on a chart: the game's own crown (none, silver, gold) and "Clear" / "Full combo" (amber) or
   "Played". Without its art a plain crown icon stands in. They have no Donderful combo or score ranks. *@
<span class="@($"inline-flex items-center gap-1 text-xs {(Crown >= CrownType.Gold ? "font-medium text-amber-600 dark:text-amber-400" : Crown == CrownType.Clear ? "font-medium" : Css.Muted)} {Class}")">
    <img data-asset="@GameData.EraCrownIcon(Game, Crown)" alt="" hidden class="peer size-5 object-contain" />
    @if (Crown >= CrownType.Clear)
    {
        <Icon Name="crown" Class="size-3.5 peer-[:not([hidden])]:hidden" />
    }
    @(Crown >= CrownType.Gold ? Localizer["Full combo"] : Crown == CrownType.Clear ? Localizer["Clear"] : Localizer["Played"])
</span>

@code {
    [Parameter] public CrownType Crown { get; set; }
    [Parameter, EditorRequired] public string Game { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
}
