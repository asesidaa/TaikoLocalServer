@* Phones (below lg): an Inspector's side list becomes this full-width button showing the pick; tapping it opens the
   list in a panel under it. A pick (the page sets Open false), a tap outside or Escape closes it. *@
@inject IJSRuntime Js

<div class="relative mb-3 lg:hidden">
    <button aria-haspopup="dialog" aria-expanded="@Css.Aria(Open)" @onclick="() => OpenChanged.InvokeAsync(!Open)"
            class="flex w-full items-center gap-3 rounded-2xl border border-zinc-200 bg-white p-2.5 text-left shadow-sm dark:border-zinc-700 dark:bg-zinc-900">
        @Summary
        <Icon Name="chevDown" Class="size-4 shrink-0 text-zinc-400" />
    </button>
    @if (Open)
    {
        <div class="fixed inset-0 z-20" @onclick="() => OpenChanged.InvokeAsync(false)"></div>
        <div @ref="panel" role="dialog" aria-label="@Label" @onkeydown="Key" style="--origin:top center"
             class="pop absolute inset-x-0 top-full z-30 mt-1 rounded-2xl border border-zinc-200 bg-white p-2 shadow-xl dark:border-zinc-700 dark:bg-zinc-900">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? Summary { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ElementReference panel;
    private bool focused;

    // Opening focuses the panel's search box, so typing (and Escape) go there.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Open) { focused = false; return; }
        if (focused) return;
        focused = true;
        await Js.InvokeVoidAsync("ui.focusIn", panel);
    }

    private Task Key(KeyboardEventArgs e) => e.Key == "Escape" ? OpenChanged.InvokeAsync(false) : Task.CompletedTask;
}
