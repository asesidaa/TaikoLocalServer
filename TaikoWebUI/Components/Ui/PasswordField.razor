@* Password input with a show/hide toggle. *@
<label class="block">
    <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">@Label</span>
    <span class="relative mt-1.5 block">
        <input type="@(show ? "text" : "password")" autocomplete="@AutoComplete" value="@Value" class="@Css.Input pr-10"
               @oninput="e => ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)" />
        <button type="button" class="absolute right-1.5 top-1/2 grid size-8 -translate-y-1/2 place-items-center rounded-lg text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200"
                aria-label="@(show ? Localizer["Hide password"] : Localizer["Show password"])" @onclick="() => show = !show">
            <Icon Name="@(show ? "eyeOff" : "eye")" />
        </button>
    </span>
</label>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string AutoComplete { get; set; } = "current-password";

    private bool show;
}
