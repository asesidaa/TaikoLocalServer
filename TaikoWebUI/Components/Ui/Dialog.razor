@* Modal dialog: Escape or a backdrop click closes it, a click inside doesn't. *@
<div class="fade fixed inset-0 z-[60] grid place-items-center bg-black/50 p-4" @onclick="Close" @onkeydown="OnKey">
    <div role="@(Alert ? "alertdialog" : "dialog")" aria-modal="true" aria-labelledby="dlg-h" @onclick:stopPropagation style="--origin:center"
         class="pop flex max-h-[min(680px,calc(100dvh-2rem))] w-full @Width flex-col rounded-2xl bg-white p-6 shadow-2xl dark:bg-zinc-900">
        <h2 id="dlg-h" class="font-semibold">@Title</h2>
        <div class="mt-1 min-h-0 flex-1 overflow-y-auto text-sm @Css.Muted">@ChildContent</div>
        @if (Footer is not null)
        {
            <div class="mt-6 flex justify-end gap-2">@Footer</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>A confirm (delete, reset): read by screen readers as an alert.</summary>
    [Parameter] public bool Alert { get; set; }
    [Parameter] public string Width { get; set; } = "max-w-sm";

    private Task Close() => OnClose.InvokeAsync();
    private Task OnKey(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;
}
