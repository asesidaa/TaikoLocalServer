@* A song as one line: genre bar, its title in the viewer's song language, and its subtitle under it when it has one. *@
@inject GameDataService GameDataService
<span class="flex items-stretch gap-2 @Class">
    <GenreBar Genre="Song.Genre" />
    <span class="min-w-0">
        <span class="block truncate">@GameDataService.SongTitle(Song)</span>
        @if (GameDataService.SongSubtitle(Song) is { Length: > 0 } sub)
        {
            <span class="block truncate text-xs @Css.Muted">@sub</span>
        }
    </span>
</span>

@code {
    [Parameter, EditorRequired] public MusicDetail Song { get; set; } = new();
    [Parameter] public string Class { get; set; } = "";
}
