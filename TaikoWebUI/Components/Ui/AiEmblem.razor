@* AI Battle result: the game's win / lose emblem, plus sections won. *@
@if (Result is { } r)
{
    var title = string.Format(Localizer[r.Win ? "AI Battle: won {0} of {1} sections" : "AI Battle: lost, {0} of {1} sections won"], r.SectionsWon, r.Sections);
    <span class="inline-flex shrink-0 items-center gap-1" title="@title">
        <img data-asset="@GameData.AiResultIcon(r.Win)" alt="@title" class="@Size shrink-0" />
        @if (!Small)
        {
            <span class="text-xs tabular-nums @Css.Muted">@r.SectionsWon/@r.Sections</span>
        }
    </span>
}
else
{
    <span class="@(Small ? "size-4" : "size-5")"></span>
}

@code {
    [Parameter] public AiResult? Result { get; set; }
    [Parameter] public bool Small { get; set; }
    /// <summary>Overrides the emblem size (e.g. "size-14").</summary>
    [Parameter] public string? SizeClass { get; set; }

    private string Size => SizeClass ?? (Small ? "size-5" : "size-6");
}
