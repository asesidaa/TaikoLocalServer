@* Switch with a label and optional hint; the whole row is the hit target. *@
<label class="flex cursor-pointer items-center gap-3 py-2">
    @if (!string.IsNullOrEmpty(Image))
    {
        <img data-asset="@Image" alt="" class="size-8 shrink-0 rounded-lg bg-zinc-100 p-1 dark:bg-zinc-800" />
    }
    else if (!string.IsNullOrEmpty(Icon))
    {
        @* Options the game has no icon for get a UI icon in the same tile, so rows line up. *@
        <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-zinc-100 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400"><TaikoWebUI.Components.Ui.Icon Name="@Icon" Class="size-5" /></span>
    }
    <span class="min-w-0 flex-1">
        <span class="block text-sm font-medium">@Label</span>
        @if (!string.IsNullOrEmpty(Description))
        {
            <span class="block text-xs text-zinc-500 dark:text-zinc-400">@Description</span>
        }
    </span>
    <input type="checkbox" class="peer sr-only" checked="@Value" @onchange="OnChange" />
    <span class="relative h-6 w-10 shrink-0 rounded-full bg-zinc-300 transition-colors after:absolute after:left-1 after:top-1 after:size-4 after:rounded-full after:bg-white after:shadow after:transition-transform after:duration-150 peer-checked:bg-primary-500 peer-checked:after:translate-x-4 peer-focus-visible:ring-2 peer-focus-visible:ring-primary-500/40 dark:bg-zinc-700"></span>
</label>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Image { get; set; }
    /// <summary>A UI <see cref="TaikoWebUI.Components.Ui.Icon"/> name, used when there is no game <see cref="Image"/>.</summary>
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    private Task OnChange(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value is true);
}
