@page "/Users/{baid:int}/Profile"
@attribute [Authorize]
@inject HttpClient Client
@inject GameDataService GameDataService
@inject AuthService AuthService
@inject PageState Page
@inject ToastService Toast
@inject IJSRuntime Js
@using TaikoWebUI.Components.Profile

<PageTitle>@Localizer["Profile"]</PageTitle>

@if (setting is null)
{
    <p class="text-sm @Css.Muted">@Localizer["Loading..."]</p>
}
else
{
    @* Two columns from lg: the sticky player card, then the section switcher + settings. Autosave, no Save button. *@
    <div class="lg:grid lg:grid-cols-[320px_minmax(0,1fr)] lg:items-start lg:gap-6">
        <aside class="lg:sticky lg:top-24"><PlayerCard Setting="setting" Dans="dans" /></aside>
        <div class="min-w-0">
            <div class="mt-4 grid grid-cols-2 gap-1 rounded-2xl bg-zinc-100 p-1 dark:bg-zinc-900 lg:mt-0 xl:grid-cols-4" role="tablist">
                @Tab(Section.Profile, Localizer["Profile"], "id")
                @Tab(Section.Costume, Localizer["Costume"], "shirt")
                @Tab(Section.SongOptions, Localizer["Song Options"], "drum")
                @Tab(Section.Card, Localizer["Card"], "palette")
            </div>
            <section class="@Css.Card mt-4 p-5 sm:p-6" role="tabpanel">
                @switch (section)
                {
                    case Section.Profile: @ProfileSection break;
                    case Section.Costume: @CostumeSection break;
                    case Section.Card: @CardSection break;
                    default: @SongSection break;
                }
            </section>
        </div>
    </div>

    @if (titlesOpen)
    {
        <TitlePicker Setting="setting" Titles="unlockedTitles" AllowCustom="AuthService.AllowFreeProfileEditing" OnPick="PickTitle" OnClose="() => titlesOpen = false" />
    }
}

@code {
    private RenderFragment Tab(Section s, string label, string icon) => __builder =>
    {
        var on = section == s;
        <button role="tab" aria-selected="@Css.Aria(on)" @onclick="() => section = s"
                class="flex items-center justify-center gap-2 whitespace-nowrap rounded-xl px-2 py-2 text-sm font-medium transition-colors @(on ? "bg-white shadow-sm dark:bg-zinc-800" : "text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-200")">
            <Icon Name="@icon" Class="hidden size-4 xl:block" />@label
        </button>
    };

    // Card: background colour + fade, the don-chan animation, and the pattern (tiles preview it on the chosen colour).
    private RenderFragment CardSection => __builder =>
    {
        var s = setting!;
        <ColorRow Label="@Localizer["Background"]" Value="s.CardColor" ValueChanged="v => Set(x => x.CardColor = v)" />
        <ColorRow Label="@Localizer["Fade"]" AllowNone="true" Value="@(s.CardFade < 0 ? ColorRow.None : (uint)s.CardFade)"
                  ValueChanged="v => Set(x => x.CardFade = v == ColorRow.None ? -1 : (int)v)" />
        <p class="mt-4 text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Animation"]</p>
        <div class="mt-2 grid grid-cols-3 gap-2" role="radiogroup" aria-label="@Localizer["Animation"]">
            @foreach (var (value, name, _) in CardStyle.Animations)
            {
                var on = s.CardAnimation == value;
                <button role="radio" aria-checked="@Css.Aria(on)" @onclick="() => Set(x => x.CardAnimation = value)"
                        class="h-10 rounded-xl border text-sm font-medium transition-colors @(on ? "border-primary-500 bg-primary-500/10 text-primary-700 dark:text-primary-300" : "border-zinc-200 text-zinc-600 hover:border-zinc-300 dark:border-zinc-800 dark:text-zinc-400 dark:hover:border-zinc-700")">
                    @Localizer[name]
                </button>
            }
        </div>
        <p class="mt-4 text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Pattern"]</p>
        <div class="mt-2 grid grid-cols-3 gap-2 sm:grid-cols-4 xl:grid-cols-6" role="radiogroup" aria-label="@Localizer["Pattern"]">
            @foreach (var (value, name) in CardStyle.Patterns)
            {
                var on = s.CardPattern == value;
                <button role="radio" aria-checked="@Css.Aria(on)" class="group text-center" @onclick="() => Set(x => x.CardPattern = value)">
                    <span class="block h-16 rounded-xl ring-2 ring-offset-2 ring-offset-white transition-shadow dark:ring-offset-zinc-900 @(on ? "ring-primary-500" : "ring-transparent group-hover:ring-zinc-300 dark:group-hover:ring-zinc-700")"
                          style="@CardStyle.Background(s.CardColor, value)"></span>
                    <span class="mt-1.5 block text-xs @(on ? "font-medium" : Css.Muted)">@Localizer[name]</span>
                </button>
            }
        </div>
    };

    private RenderFragment ProfileSection => __builder =>
    {
        var s = setting!;
        <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
                <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Name"]</span>
                <input maxlength="10" value="@s.MyDonName" class="@Css.Input mt-1.5" @oninput="e => Set(x => x.MyDonName = e.Value?.ToString() ?? string.Empty)" />
            </label>
            <SelectField Label="@Localizer["Language"]" Options="@GameData.NameLanguages.Select(l => (string)Localizer[l]).ToList()"
                         Value="s.MyDonNameLanguage" ValueChanged="v => Set(x => x.MyDonNameLanguage = v)" />
            <label class="block">
                <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Title"]</span>
                <button class="@Css.Input mt-1.5 flex items-center justify-between text-left" @onclick="() => titlesOpen = true">
                    <span class="font-display truncate">@(string.IsNullOrEmpty(s.Title) ? " " : s.Title)</span><Icon Name="chevDown" Class="size-4 text-zinc-400" />
                </button>
            </label>
            <label class="block">
                <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Title Plate"]</span>
                <select class="@Css.Input mt-1.5 dark:[&>option]:bg-zinc-900" @onchange="e => Set(x => x.TitlePlateId = uint.Parse(e.Value!.ToString()!))">
                    @foreach (var id in titlePlateIds)
                    {
                        <option value="@id" selected="@(id == s.TitlePlateId)">@(id < GameData.TitlePlates.Length ? GameData.TitlePlates[id].Name : $"#{id}")</option>
                    }
                </select>
            </label>
        </div>
        <div class="mt-4 grid gap-x-6 sm:grid-cols-2">
            <div>
                <Toggle Label="@Localizer["Dan rank on nameplate"]" Value="s.IsDisplayDanOnNamePlate" ValueChanged="v => Set(x => x.IsDisplayDanOnNamePlate = v)" />
                <Toggle Label="@Localizer["Show Sou-uchi songs"]" Description="@Localizer["Two-player charts in the song list"]" Value="s.IsDisplaySouUchi" ValueChanged="v => Set(x => x.IsDisplaySouUchi = v)" />
            </div>
            <div>
                <Toggle Label="@Localizer["Achievement panel"]" Description="@Localizer["Show/hide the achievement panel in-game"]" Value="s.IsDisplayAchievement" ValueChanged="v => Set(x => x.IsDisplayAchievement = v)" />
                @if (s.IsDisplayAchievement)
                {
                    <div class="pb-2 pt-1">
                        <SelectField Label="@Localizer["Achievement panel difficulty"]" Options="@AchievementOptions" Value="(uint)s.AchievementDisplayDifficulty"
                                     ValueChanged="v => Set(x => x.AchievementDisplayDifficulty = (Difficulty)v)" />
                    </div>
                }
            </div>
        </div>
        <h3 class="mt-6 text-sm font-semibold">@Localizer["Song select defaults"]</h3>
        <div class="mt-3 grid gap-4 sm:grid-cols-3">
            <SelectField Label="@Localizer["Course"]" Options="@Localized(GameData.CourseOptions)" Value="s.DifficultySettingCourse" ValueChanged="v => Set(x => x.DifficultySettingCourse = v)" />
            <SelectField Label="@Localizer["Star"]" Options="@Localized(GameData.StarOptions)" Value="s.DifficultySettingStar" ValueChanged="v => Set(x => x.DifficultySettingStar = v)" />
            <SelectField Label="@Localizer["Sort"]" Options="@Localized(GameData.SortOptions)" Value="s.DifficultySettingSort" ValueChanged="v => Set(x => x.DifficultySettingSort = v)" />
        </div>
    };

    private RenderFragment CostumeSection => __builder =>
    {
        var s = setting!;
        var kigurumi = s.Kigurumi != 0;
        <div class="grid gap-4 xl:grid-cols-2">
            <PartPicker Label="@Localizer["Kigurumi"]" Ids="kigurumiIds" NameOf="@(id => CostumeName("kigurumi", id))" Value="s.Kigurumi" ValueChanged="v => Set(x => x.Kigurumi = v)">
                <Hint>
                    @if (kigurumi)
                    {
                        <span class="flex items-baseline gap-2 text-xs @Css.Muted">
                            @Localizer["Replaces head, body & face paint"]
                            <button type="button" class="rounded @Css.Link" @onclick="() => Set(x => x.Kigurumi = 0)">@Localizer["Clear"]</button>
                        </span>
                    }
                </Hint>
            </PartPicker>
            <PartPicker Label="@Localizer["Head"]" Ids="headIds" NameOf="@(id => CostumeName("head", id))" Value="s.Head" ValueChanged="v => Set(x => x.Head = v)" Disabled="kigurumi" />
            <PartPicker Label="@Localizer["Body"]" Ids="bodyIds" NameOf="@(id => CostumeName("body", id))" Value="s.Body" ValueChanged="v => Set(x => x.Body = v)" Disabled="kigurumi" />
            <PartPicker Label="@Localizer["Face"]" Ids="faceIds" NameOf="@(id => CostumeName("face", id))" Value="s.Face" ValueChanged="v => Set(x => x.Face = v)" Disabled="kigurumi" />
            <PartPicker Label="@Localizer["Puchi"]" Ids="puchiIds" NameOf="@(id => CostumeName("puchi", id))" Value="s.Puchi" ValueChanged="v => Set(x => x.Puchi = v)" />
        </div>
        <div class="mt-6 space-y-2">
            <ColorRow Label="@Localizer["Body Color"]" Value="s.BodyColor" ValueChanged="v => Set(x => x.BodyColor = v)" />
            <ColorRow Label="@Localizer["Face Color"]" Value="s.FaceColor" ValueChanged="v => Set(x => x.FaceColor = v)" />
            <ColorRow Label="@Localizer["Limb Color"]" Value="s.LimbColor" ValueChanged="v => Set(x => x.LimbColor = v)" />
        </div>
    };

    private RenderFragment SongSection => __builder =>
    {
        var s = setting!;
        var random = (uint)s.PlaySetting.RandomType;
        <div class="grid gap-4 sm:grid-cols-2">
            <SelectField Label="@Localizer["Speed"]" Options="@GameData.Speeds.Select(v => $"×{v}").ToList()" Image="@GameData.SpeedIcon(s.PlaySetting.Speed)"
                         Value="s.PlaySetting.Speed" ValueChanged="v => Set(x => x.PlaySetting.Speed = v)" />
            <SelectField Label="@Localizer["Random"]" Options="@Localized(["None", "Whimsical", "Messy"])"
                         Image="@(random == 0 ? null : GameData.OptionIcon(random == 1 ? "kimagure" : "detarame"))"
                         Value="random" ValueChanged="v => Set(x => x.PlaySetting.RandomType = (RandomType)v)" />
            <SelectField Label="@Localizer["Tone"]" Options="@Localized(GameData.Tones)" Value="s.ToneId" ValueChanged="v => Set(x => x.ToneId = v)">
                @* Hidden until the tone's sound is found (hydrateAssets), i.e. when extract hasn't been run. *@
                <button type="button" hidden data-asset="@($"tone/{s.ToneId:00}_don.wav")" title="@Localizer["Play tone"]" aria-label="@Localizer["Play tone"]"
                        class="shrink-0 rounded-lg bg-zinc-100 p-2 text-zinc-700 hover:bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700"
                        @onclick='() => Js.InvokeVoidAsync("ui.playTone", s.ToneId)'>
                    <Icon Name="volume" />
                </button>
            </SelectField>
            <label class="block">
                <span class="flex items-baseline justify-between text-sm">
                    <span class="font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Notes Position"]</span>
                    <span class="text-xs tabular-nums @Css.Muted">@(s.NotesPosition > 0 ? "+" : "")@s.NotesPosition</span>
                </span>
                <span class="mt-1.5 flex items-center gap-2">
                    <img data-asset="@GameData.OptionIcon("note_pos")" alt="" class="size-8 shrink-0 rounded-lg bg-zinc-100 p-1 dark:bg-zinc-800" />
                    <input type="range" min="-5" max="5" step="1" value="@s.NotesPosition" class="w-full accent-primary-500"
                           @onchange="e => Set(x => x.NotesPosition = int.Parse(e.Value!.ToString()!))" />
                </span>
            </label>
        </div>
        <div class="mt-4 grid gap-x-6 sm:grid-cols-2">
            <Toggle Label="@Localizer["Vanish"]" Description="@Localizer["Notes disappear before the judge mark"]" Image="@GameData.OptionIcon("doron")"
                    Value="s.PlaySetting.IsVanishOn" ValueChanged="v => Set(x => x.PlaySetting.IsVanishOn = v)" />
            <Toggle Label="@Localizer["Inverse"]" Description="@Localizer["Swap don and ka"]" Image="@GameData.OptionIcon("abekobe")"
                    Value="s.PlaySetting.IsInverseOn" ValueChanged="v => Set(x => x.PlaySetting.IsInverseOn = v)" />
            <Toggle Label="@Localizer["Voice"]" Description="@Localizer["Announcer voice"]" Icon="volume" Value="s.IsVoiceOn" ValueChanged="v => Set(x => x.IsVoiceOn = v)" />
            <Toggle Label="@Localizer["Skip Song"]" Description="@Localizer["Allow skipping during play"]" Icon="skip" Value="s.IsSkipOn" ValueChanged="v => Set(x => x.IsSkipOn = v)" />
        </div>
    };

    // Achievement panel difficulty: None = the highest difficulty with crowns.
    private List<string> AchievementOptions => [Localizer["Highest with crowns"], .. GameData.Difficulties.Select(d => (string)Localizer[d.Name])];

    private List<string> Localized(IEnumerable<string> keys) => keys.Select(k => (string)Localizer[k]).ToList();
}
