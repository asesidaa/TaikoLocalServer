@page "/Users/{baid:int}/QrCode"
@attribute [Authorize]
@inject PageState Page

<PageTitle>QrCode</PageTitle>
<ComingSoon Title="@(Localizer["Show QR Code"])" IconName="qr" />

@code {
    [Parameter] public int Baid { get; set; }

    protected override void OnInitialized() => Page.Set(Localizer["Settings"], Localizer["Show QR Code"]);
}
