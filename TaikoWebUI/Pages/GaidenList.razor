@using Blazored.LocalStorage
@using TaikoWebUI.Utilities;

@inject IGameDataService GameDataService
@inject HttpClient Client
@inject AuthService AuthService
@inject ILocalStorageService LocalStorage
@inject NavigationManager NavigationManager
@inject BreadcrumbsStateContainer BreadcrumbsStateContainer
@inject IDialogService DialogService

@page "/Users/{baid:int}/Gaidens"

<MudGrid Class="my-8">
    @if (response is null)
    {
        <MudContainer Style="display:flex;margin:50px 0;align-items:center;justify-content:center;">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
        </MudContainer>
    }
    else
    {
        @if (AuthService.LoginRequired && (!AuthService.IsLoggedIn || (AuthService.GetLoggedInBaid() != Baid && !AuthService.IsAdmin)))
        {
            NavigationManager.NavigateTo(AuthService.IsLoggedIn ? "/" : "/Login");
        }
        else
        {
            <MudItem xs="12">
                <MudTable Items="danDatas" Elevation="0" RowsPerPage="25" Outlined="true" Filter="@FilterGaidens" Breakpoint=Breakpoint.None>
                    <ToolBarContent>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="12">
                                <MudTextField @bind-Value="Search"
                                              Placeholder="@Localizer["Search by Title or Artist"]"
                                              Variant="Variant.Outlined"
                                              Clearable="true"
                                              Immediate="true"
                                              Margin="Margin.Dense"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              IconSize="Size.Medium" />
                            </MudItem>
                        </MudGrid>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh Style="width: 400px">
                            <MudTableSortLabel T="DanData" SortBy="context => GetGaidenTitle(context.Title, SongNameLanguage)">
                                @Localizer["Gaiden Title"]
                            </MudTableSortLabel>
                        </MudTh>
                        @for (int i = 1; i <= 3; i++)
                        {
                            int currentStage = i;
                            <MudTh>
                                <MudText T="DanData">
                                    @Localizer["Stage"]@currentStage
                                </MudText>
                            </MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Style="text-align: initial !important;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div style="margin: 4px;">
                                    <MudIconButton Variant="Variant.Filled" OnClick="@(async () => await ShowQrCode(context.DanId, context.Title))"
                                        Icon="@Icons.Material.Filled.QrCode2" Color="@Color.Primary"
                                        Size="Size.Small" Title="Gaiden QRCode"
                                    />
                                </div>
                                <div style="width:400px">
                                    <a href="@($"/Users/{Baid}/Gaiden/{context.DanId}")">
                                        <MudText Typo="Typo.body2" Style="font-weight:bold">@GetGaidenTitle(context.Title, SongNameLanguage)</MudText>
                                        @if (SongNameLanguage != null && SongNameLanguage != "ja")
                                        {
                                            <MudText Typo="Typo.caption">@GetGaidenTitle(context.Title, "ja")</MudText>
                                        }
                                    </a>
                                </div>
                            </MudStack>
                        </MudTd>
                        @foreach (var song in context.OdaiSongList)
                        {
                            <MudTd>
                                <MudStack Style="display: inline-flex !important;" Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    @if (song.IsHiddenSongName)
                                    {
                                        <MudText Typo="Typo.body2" Style="font-weight:bold">[@GetDifficultyText(song.Level)]</MudText>
                                        <MudText Typo="Typo.body2">???</MudText>
                                    }
                                    else
                                    {
                                        <a href="@($"/Users/{Baid}/Songs/{song.SongNo}")" style="display: inline-flex !important;">
                                            <MudText Typo="Typo.body2" Style="font-weight:bold">[@GetDifficultyText(song.Level)]</MudText>
                                            <MudText Typo="Typo.body2">
                                                @GameDataService.GetMusicNameBySongId(musicDetailDictionary, song.SongNo, SongNameLanguage)
                                            </MudText>
                                        </a>
                                    }
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" />
                                    <MudText Typo="Typo.caption" Style="line-height:1;margin-top:2px;margin-right:2px;">@GameDataService.GetMusicStarLevel(musicDetailDictionary, song.SongNo, (Difficulty)song.Level)</MudText>
                                </MudStack>
                            </MudTd>
                        }
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager RowsPerPageString=@Localizer["Rows Per Page"] />
                    </PagerContent>
                </MudTable>
            </MudItem>
        }
    }
</MudGrid>