@page "/Users/{baid:int}/Songs"
@attribute [Authorize]
@inject PageState Page

<PageTitle>SongList</PageTitle>
<ComingSoon Title="@(Localizer["Song List"])" IconName="songList" />

@code {
    [Parameter] public int Baid { get; set; }

    protected override void OnInitialized() => Page.Set(Localizer["Play Data"], Localizer["Song List"]);
}
