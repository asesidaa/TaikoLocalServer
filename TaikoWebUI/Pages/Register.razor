@page "/Register"
@attribute [Authorize(Policy = WebUiAuthPolicies.RequireRealAuth)]
@inject AuthService AuthService
@inject NavigationManager Nav
@inject PageState Page

<PageTitle>@Localizer["Register"]</PageTitle>

<div class="mx-auto w-full max-w-md @Css.Card p-6 sm:p-8">
    @if (done)
    {
        <div class="pop py-6 text-center" style="--origin:center">
            <span class="mx-auto grid size-12 place-items-center rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400"><Icon Name="check" Class="size-6" /></span>
            <p class="mt-3 font-semibold">@Localizer["You're registered"]</p>
            <p class="mt-1 text-sm @Css.Muted">@Localizer["Log in with your access code and new password."]</p>
            <a href="/Login" class="@Css.PrimaryButton mt-5">@Localizer["Log In"]</a>
        </div>
    }
    else
    {
        <div class="mb-5 flex items-center justify-between">
            <h1 class="font-display text-xl">@Localizer["Register"]</h1>
            <a href="/Login" class="text-sm @Css.Link">@Localizer["Log in instead"]</a>
        </div>

        @* Progress: 24px SVG circles (a multiple of 8, so they render crisply at 125% / 150% scaling). *@
        <ol class="flex items-center gap-2" aria-label="@Localizer["Progress"]">
            @for (var i = 0; i < Steps.Count; i++)
            {
                var index = i;
                var isDone = index < step;
                var active = index == step;
                <li class="flex items-center gap-2 @(index > 0 ? "flex-1" : "")">
                    @if (index > 0)
                    {
                        <span class="h-px flex-1 @(index <= step ? "bg-primary-500" : "bg-zinc-200 dark:bg-zinc-700")"></span>
                    }
                    <span class="flex items-center gap-1.5 text-xs font-medium @(index <= step ? "text-primary-600 dark:text-primary-400" : "text-zinc-400")" aria-current="@(active ? "step" : null)">
                        <span class="relative grid size-6 shrink-0 place-items-center">
                            <svg class="absolute inset-0 size-6" viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="12" r="@(isDone ? 12 : 11)" stroke-width="@(active ? 2 : 1.5)"
                                        class="@(isDone ? "fill-primary-500" : "fill-none") @(active ? "stroke-primary-500" : isDone ? "stroke-none" : "stroke-zinc-300 dark:stroke-zinc-600")" />
                            </svg>
                            @if (isDone)
                            {
                                <span class="relative text-white"><Icon Name="check" /></span>
                            }
                            else
                            {
                                <span class="relative text-[11px] leading-none">@(index + 1)</span>
                            }
                        </span>
                        <span class="hidden sm:inline">@Steps[index].Label</span>
                    </span>
                </li>
            }
        </ol>

        <form class="mt-6" novalidate @onsubmit="Next">
            <div class="rise" @key="step">
                @switch (Steps[step].Id)
                {
                    case "card":
                        <h2 class="text-lg font-semibold">@Localizer["What's your access code?"]</h2>
                        <p class="mt-1 text-sm @Css.Muted">@Localizer["The 20 digits on your card or Banapass. Spaces are added for you."]</p>
                        <div class="mt-5"><AccessCodeField @bind-Value="code" Large="true" /></div>
                        <p class="mt-3 text-xs @Css.Muted">@(code.Length > 0 ? $"{code.Length}/20" : Localizer["Tip: paste the whole code, dashes and all."])</p>
                        break;
                    case "verify":
                        <h2 class="text-lg font-semibold">@Localizer["Prove it's your card"]</h2>
                        @if (useInvite)
                        {
                            <p class="mt-1 text-sm @Css.Muted">@Localizer["Ask an admin to generate an invite code for your card."]</p>
                            <label class="mt-5 block">
                                <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Invite code"]</span>
                                <span class="relative mt-1.5 block">
                                    <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400"><Icon Name="ticket" /></span>
                                    <input inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="000000" value="@invite"
                                           class="@Css.Input pl-9 font-mono tracking-[.3em]" @oninput="e => invite = AccessCodeField.Digits(e.Value?.ToString() ?? string.Empty)" />
                                </span>
                            </label>
                            <button type="button" class="mt-3 text-sm @Css.Link" @onclick="() => useInvite = false">@Localizer["Use your last play time instead"]</button>
                        }
                        else
                        {
                            <p class="mt-1 text-sm @Css.Muted">@Localizer["Enter when you last played with this card, to within 5 minutes."]</p>
                            <div class="mt-5 grid grid-cols-2 gap-3">
                                <label class="block"><span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Date"]</span>
                                    <input type="date" class="@Css.Input mt-1.5" @bind="playDate" /></label>
                                <label class="block"><span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Time"]</span>
                                    <input type="time" class="@Css.Input mt-1.5" @bind="playTime" /></label>
                            </div>
                            <button type="button" class="mt-3 text-sm @Css.Link" @onclick="() => useInvite = true">@Localizer["Use an invite code instead"]</button>
                        }
                        break;
                    default:
                        <h2 class="text-lg font-semibold">@Localizer["Choose a password"]</h2>
                        <p class="mt-1 text-sm @Css.Muted">@Localizer["You'll use it with your access code to log in here."]</p>
                        <div class="mt-5 space-y-4">
                            <PasswordField Label="@Localizer["New password"]" AutoComplete="new-password" @bind-Value="password" />
                            <PasswordField Label="@Localizer["Confirm password"]" AutoComplete="new-password" @bind-Value="confirm" />
                        </div>
                        break;
                }
            </div>
            <div class="mt-4"><ErrorBox Message="@error" /></div>
            <div class="mt-6 flex items-center justify-end gap-2">
                @if (step > 0)
                {
                    <button type="button" class="@Css.GhostButton" @onclick="Back">@Localizer["Back"]</button>
                }
                <button class="@Css.PrimaryButton" disabled="@busy">
                    @(IsLast ? Localizer["Register"] : Localizer["Continue"])
                    @if (!IsLast)
                    {
                        <Icon Name="chevRight" />
                    }
                </button>
            </div>
        </form>
    }
</div>

@code {
    private int step;
    private string code = "";
    private string invite = "";
    private string password = "";
    private string confirm = "";
    private bool useInvite;
    private DateOnly playDate = DateOnly.FromDateTime(DateTime.Today);
    private TimeOnly playTime = new(0, 45);
    private string? error;
    private bool busy;
    private bool done;

    // The server checks the last play time (or an invite code instead) only when RegisterWithLastPlayTime is on.
    private List<(string Id, string Label)> Steps => AuthService.RegisterWithLastPlayTime
        ? [("card", Localizer["Card"]), ("verify", Localizer["Verify"]), ("password", Localizer["Password"])]
        : [("card", Localizer["Card"]), ("password", Localizer["Password"])];

    private bool IsLast => step == Steps.Count - 1;

    protected override void OnInitialized()
    {
        if (AuthService.OnlyAdmin) Nav.NavigateTo("/Login", replace: true);
        Page.Set(Localizer["Register"]);
    }

    private void Back()
    {
        error = null;
        step--;
    }

    private async Task Next()
    {
        error = Steps[step].Id switch
        {
            "card" when code.Length != 20 => Localizer["Access codes are 20 digits."],
            "verify" when useInvite && invite.Length != 6 => Localizer["Invite codes are 6 digits."],
            "password" when password.Length == 0 => Localizer["Choose a password."],
            "password" when password != confirm => Localizer["Register Different Confirm Password Error"],
            _ => (string?)null,
        };
        if (error is not null) return;
        if (!IsLast)
        {
            step++;
            return;
        }

        busy = true;
        var result = await AuthService.Register(code, playDate.ToDateTime(playTime), password, confirm, useInvite ? invite : "");
        busy = false;
        switch (result)
        {
            case 1: done = true; break;
            case 0: error = Localizer["Register Only Admin Error"]; break;
            case 2: error = Localizer["Register Different Confirm Password Error"]; break;
            case 3: error = Localizer["Unknown Access Code Error"]; step = 0; break;
            case 4: error = Localizer["Register Already Registered Error"]; step = 0; break;
            case 5: error = Localizer["Register Wrong Last Play Time Error"]; step = Steps.FindIndex(s => s.Id == "verify"); break;
            default: error = Localizer["Unknown Error"]; break;
        }
    }
}
