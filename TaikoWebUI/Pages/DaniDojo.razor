@page "/Users/{baid:int}/DaniDojo"
@attribute [Authorize]
@inject HttpClient Client
@inject IJSRuntime Js
@inject PageState Page

<PageTitle>@Localizer["Dani Dojo"]</PageTitle>

<PlayDataPage Setting="setting" Dans="dans" DanView="true">
    @if (setting is null)
    {
        <p class="text-sm @Css.Muted">@Localizer["Loading..."]</p>
    }
    else
    {
        var top = Top;
        <div class="space-y-6">
            <div class="grid grid-cols-3 gap-3">
                @Tile(Localizer["Highest rank"], top is null ? "–" : Localizer[GameData.Dans[top.DanId - 1].Key])
                @Tile(Localizer["Ranks passed"], $"{Passed.Count} / {GameData.Dans.Length}")
                @Tile(Localizer["Gold passes"], Passed.Count(d => GameData.IsGold(d.ClearState)).ToString())
            </div>
            <section class="space-y-3">
                <h3 class="text-sm font-semibold">@Localizer["Ranks"]</h3>
                <div class="grid grid-cols-3 gap-2 sm:grid-cols-4 xl:grid-cols-5">
                    @for (var i = 0; i < GameData.Dans.Length; i++)
                    {
                        var (badge, kanji, key) = GameData.Dans[i];
                        var best = BestFor((uint)i + 1);
                        var passed = best is not null && best.ClearState != DanClearState.NotClear;
                        var gold = passed && GameData.IsGold(best!.ClearState);
                        var clear = passed ? ClearTypes[GameData.ClearType(best!.ClearState)] : null;
                        var name = (string)Localizer[key];
                        @* Badge = the game's rendered dan badge (extract), with the kanji as a fallback until extract has run. *@
                        <div title="@($"{name}: {(passed ? $"{(gold ? Localizer["Gold pass"] : Localizer["Passed"])}, {Localizer[clear!]}" : Localizer["Not passed yet"])}")"
                             class="relative isolate flex flex-col items-center gap-1 overflow-hidden rounded-xl border border-zinc-900/10 bg-zinc-900 px-2 py-3 text-center dark:border-zinc-700 dark:bg-zinc-950 @(best == top && top is not null ? "ring-2 ring-primary-500" : "")">
                            @if (passed)
                            {
                                <img data-asset="@GameData.DanStamp(best!.ClearState)" alt="" class="pointer-events-none absolute -bottom-3 -right-3 -z-10 size-20 object-contain opacity-25" />
                            }
                            <span class="grid h-8 w-16 place-items-center @(passed ? "" : "opacity-30 grayscale")">
                                <img data-asset="@($"nameplate/dan_{badge}_{(gold ? "gold" : "red")}.png")" alt="" class="peer h-8 w-16" />
                                <span class="font-display hidden text-xl peer-[[hidden]]:block @(gold ? "text-amber-300" : "text-white")">@kanji</span>
                            </span>
                            <span class="mt-0.5 whitespace-nowrap text-sm font-medium @(passed ? "text-white" : "text-zinc-400")">@name</span>
                            <span class="whitespace-nowrap text-xs @(gold ? "text-amber-300" : passed ? "text-zinc-300" : "text-zinc-400")">
                                @(passed ? Localizer[clear!] : Localizer["Not yet"])
                                @if (passed)
                                {
                                    <span class="sr-only">, @(gold ? Localizer["Gold pass"] : Localizer["Passed"])</span>
                                }
                            </span>
                        </div>
                    }
                </div>
                <p class="text-xs @Css.Muted">@Localizer["Your highest pass (outlined) is the badge on your nameplate. On this page the card shows your Dani Dojo outfit."]</p>
            </section>
        </div>
    }
</PlayDataPage>

@code {
    [Parameter] public int Baid { get; set; }

    private static readonly string[] ClearTypes = ["Clear", "Full combo", "Donderful"];

    private UserSetting? setting;
    private List<DanBestData> dans = [];

    private List<DanBestData> Passed => dans.Where(d => d.ClearState != DanClearState.NotClear && d.DanId is >= 1 and <= 19).ToList();
    private DanBestData? Top => Passed.MaxBy(d => d.DanId);
    private DanBestData? BestFor(uint danId) => dans.FirstOrDefault(d => d.DanId == danId);

    private static RenderFragment Tile(string label, string value) => __builder =>
    {
        <div class="rounded-xl border border-zinc-200 p-3 dark:border-zinc-800">
            <p class="text-xs @Css.Muted">@label</p>
            <p class="mt-1 whitespace-nowrap text-xl font-semibold">@value</p>
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        Page.Set(Localizer["Play Data"], Localizer["Dani Dojo"]);
        var settingTask = Client.GetFromJsonAsync<UserSetting>($"api/UserSettings/{Baid}");
        var dansTask = Client.GetFromJsonAsync<DanBestDataResponse>($"api/DanBestData/{Baid}");
        setting = await settingTask;
        dans = (await dansTask)?.DanBestDataList ?? [];
    }

    protected override Task OnAfterRenderAsync(bool firstRender) => Js.InvokeVoidAsync("ui.hydrateAssets").AsTask();
}
