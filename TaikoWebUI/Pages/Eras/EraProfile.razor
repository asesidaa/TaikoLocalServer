@page "/Users/{baid:int}/{Game}/Profile"
@attribute [Authorize]
@implements IDisposable
@using System.Text.Json
@using TaikoLocalServer.Contracts.AdminApi.Ac15ProfileSettings
@using TaikoWebUI.Components.Profile
@inject HttpClient Client
@inject PageState Page
@inject ToastService Toast
@inject AuthService AuthService

<PageTitle>@Localizer["Profile"]</PageTitle>
@* An older game's profile, laid out as Nijiiro's: the player card (this game's own 3D don-chan once its models are
   extracted, Server Management › Games), then the sections. What the game doesn't have is hidden, and one line names
   it. Autosave: a change saves after a short pause (the status shows in the top bar). *@
<GameLine Game="@GameName" Class="mb-4" />
@if (settings is null || form is null)
{
    <div class="@Css.Card p-5">@if (failed) { <p class="text-sm @Css.Muted">@string.Format(Localizer["No {0} profile yet: it's made the first time this card plays {0}."], GameName)</p> } else { <Skeleton /> }</div>
}
else
{
    var caps = settings.Capabilities;
    <div class="lg:grid lg:grid-cols-[320px_minmax(0,1fr)] lg:items-start lg:gap-6">
        <aside class="lg:sticky lg:top-24">
            <PlayerCard Setting="CardSetting" Game="@GameName" />
            @if (!has3D)
            {
                <p class="mt-2 text-xs @Css.Muted">@string.Format(Localizer["{0}'s don-chan models aren't extracted, so the card has no don-chan."], GameName)</p>
            }
        </aside>
        <div class="min-w-0">
            <Rail Role="tablist" Label="@Localizer["Profile"]" Class="mt-4 rounded-2xl bg-zinc-100 p-1 lg:mt-0 dark:bg-zinc-900" TrackClass="gap-1">
                @Tab(Section.Profile, Localizer["Profile"], "id")
                @if (settings.Customization is not null)
                {
                    @Tab(Section.Costume, Localizer["Costume"], "shirt")
                }
                @if (HasSongOptions(caps))
                {
                    @Tab(Section.SongOptions, Localizer["Song Options"], "drum")
                }
                @Tab(Section.Card, Localizer["Card"], "palette")
            </Rail>
            <section class="@Css.Card mt-4 p-5 sm:p-6" role="tabpanel">
                @switch (section)
                {
                    case Section.Costume: @CostumeSection break;
                    case Section.SongOptions: @SongSection break;
                    case Section.Card: <CardEditor Setting="look" Changed="CardChanged" /> break;
                    default: @ProfileSection break;
                }
            </section>
            @if (Missing(caps) is { Count: > 0 } missing)
            {
                <p class="mt-3 text-xs @Css.Muted">@string.Format(Localizer["{0} doesn't have {1}, so they aren't shown."], GameName, string.Join(", ", missing))</p>
            }
        </div>
    </div>

    @if (titlesOpen && settings.Customization?.Title is { } title)
    {
        <TitlePicker Setting="CardSetting" Titles="@TitleChoices(title)" OnPick="PickTitle" OnClose="() => titlesOpen = false" />
    }
}

@code {
    [Parameter] public int Baid { get; set; }
    [Parameter] public string Game { get; set; } = "";

    private enum Section { Profile, Costume, SongOptions, Card }

    private sealed class Form
    {
        public string Name = "";
        public uint Language, TitleId, ToneId, Body, Face, Limb, RankingDifficulty, DefaultDifficulty, FolderDan;
        public string TitleText = "";
        public Dictionary<string, uint> Slots = [];
        public bool DanOnPlate, FolderClose, SkipHowTo, AutoCostume;
    }

    private string GameName => EraPaths.Older(Game) ?? Game;
    private Ac15ProfileSettingsDto? settings;
    private Form? form;
    private Section section = Section.Profile;
    private bool failed, titlesOpen, has3D;
    private List<Costume> costumes = [];
    private Dictionary<uint, Title> titles = [];
    private Dictionary<uint, Neiro> tones = [];
    // The card's look is the player's, the same in every game (api/Users/{baid}/Card); CardEditor edits it here.
    private UserSetting look = new() { CardFade = -1 };

    // Autosave, as Nijiiro's profile: the profile and the card each save after a short pause, when they changed.
    private CancellationTokenSource? saveDelay;
    private string saved = "", savedCard = "";

    // The difficulty selects: 0 is "not set", then Easy … Ura Oni.
    private List<string> DifficultyNames => [Localizer["Not set"], .. GameData.Difficulties.Select(d => d.Name)];

    protected override async Task OnParametersSetAsync()
    {
        Page.Set(GameName, Localizer["Profile"]);
        Page.SetSave(PageState.SaveStatus.Idle);
        (settings, form, failed) = (null, null, false);
        if (EraPaths.Older(Game) is null) return;
        try
        {
            settings = await Client.GetFromJsonAsync<Ac15ProfileSettingsDto>($"api/{GameName}/Ac15ProfileSettings/{Baid}");
        }
        catch (HttpRequestException)
        {
            failed = true;
            return;
        }
        // Names are optional: only some games have a name reader.
        try { costumes = await Client.GetFromJsonAsync<List<Costume>>($"api/{GameName}/customization/costumes") ?? []; } catch (HttpRequestException) { }
        try { titles = await Client.GetFromJsonAsync<Dictionary<uint, Title>>($"api/{GameName}/customization/titles") ?? []; } catch (HttpRequestException) { }
        try { tones = await Client.GetFromJsonAsync<Dictionary<uint, Neiro>>($"api/{GameName}/customization/neiros") ?? []; } catch (HttpRequestException) { }
        try
        {
            if (await Client.GetFromJsonAsync<CardLook>($"api/Users/{Baid}/Card") is { } card)
                look = new UserSetting { CardColor = card.Color ?? 0, CardPattern = card.Pattern ?? default, CardFade = card.Fade ?? -1, CardAnimation = card.Animation ?? default };
        }
        catch (HttpRequestException) { }
        // The game's models are there when extract --era wrote its animations.
        try { has3D = (await Client.GetAsync($"api/Assets/{GameName.ToLowerInvariant()}/animation/facekeys.json")).IsSuccessStatusCode; } catch (HttpRequestException) { }
        Reset();
    }

    private RenderFragment Tab(Section s, string label, string icon) => __builder =>
    {
        var on = section == s;
        <button role="tab" aria-selected="@Css.Aria(on)" @onclick="() => section = s"
                class="flex min-w-max flex-1 shrink-0 snap-start items-center justify-center gap-2 whitespace-nowrap rounded-xl px-3 py-2 text-sm font-medium transition-colors @(on ? "bg-white shadow-sm dark:bg-zinc-800" : "text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-200")">
            <Icon Name="@icon" Class="hidden size-4 xl:block" />@label
        </button>
    };

    private RenderFragment ProfileSection => __builder =>
    {
        var f = form!;
        var caps = settings!.Capabilities;
        <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
                <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Name"]</span>
                <input maxlength="10" value="@f.Name" class="@Css.Input mt-1.5" @oninput="e => Set(x => x.Name = e.Value?.ToString() ?? string.Empty)" />
            </label>
            <SelectField Label="@Localizer["Language"]" Options="@GameData.NameLanguages.Select(l => (string)Localizer[l]).ToList()"
                         Value="f.Language" ValueChanged="v => Set(x => x.Language = v)" />
            @if (caps.SupportsTitle && settings.Customization?.Title is not null)
            {
                <label class="block sm:col-span-2">
                    <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">@Localizer["Title"]</span>
                    <button class="@Css.Input mt-1.5 flex items-center justify-between text-left" @onclick="() => titlesOpen = true">
                        <span class="font-display truncate">@(string.IsNullOrEmpty(f.TitleText) ? " " : f.TitleText)</span><Icon Name="chevDown" Class="size-4 text-zinc-400" />
                    </button>
                </label>
            }
        </div>
        <div class="mt-4 grid gap-x-6 sm:grid-cols-2">
            @if (caps.SupportsDisplayDanOnNamePlate)
            {
                <Toggle Label="@Localizer["Dan on nameplate"]" Icon="dani" Value="f.DanOnPlate" ValueChanged="v => Set(x => x.DanOnPlate = v)" />
            }
            @if (caps.SupportsFolderCloseButton)
            {
                <Toggle Label="@Localizer["Folder close button"]" Icon="list" Value="f.FolderClose" ValueChanged="v => Set(x => x.FolderClose = v)" />
            }
            @if (caps.SupportsHowToPlayTutorialFlag)
            {
                <Toggle Label="@Localizer["Skip \"how to play\""]" Icon="skip" Value="f.SkipHowTo" ValueChanged="v => Set(x => x.SkipHowTo = v)" />
            }
            @if (caps.SupportsAutoCostume)
            {
                <Toggle Label="@Localizer["Wear new costume items"]" Icon="shirt" Value="f.AutoCostume" ValueChanged="v => Set(x => x.AutoCostume = v)"
                        Description="@Localizer["A costume item won at the cabinet is put on straight away."]" />
            }
        </div>
    };

    private RenderFragment CostumeSection => __builder =>
    {
        var f = form!;
        var custom = settings!.Customization!;
        // As Nijiiro: a kigurumi replaces head, body and face paint.
        var kigurumi = f.Slots.GetValueOrDefault("kigurumi") != 0;
        <div class="grid gap-4 xl:grid-cols-2">
            @foreach (var slot in custom.CostumeSlots)
            {
                var name = slot.Slot;
                <PartPicker Label="@SlotLabel(name)" Ids="@Choices(slot.UnlockedIds, slot.CurrentId, costumes.Where(c => c.CostumeType == name).Select(c => c.CostumeId))"
                            NameOf="@(id => CostumeName(name, id))" Value="f.Slots[name]" ValueChanged="v => Set(x => x.Slots[name] = v)"
                            Disabled="@(kigurumi && name is "head" or "body" or "face")">
                    <Hint>
                        @if (name == "kigurumi" && kigurumi)
                        {
                            <span class="flex items-baseline gap-2 text-xs @Css.Muted">
                                @Localizer["Replaces head, body & face paint"]
                                <button type="button" class="rounded @Css.Link" @onclick='() => Set(x => x.Slots["kigurumi"] = 0)'>@Localizer["Clear"]</button>
                            </span>
                        }
                    </Hint>
                </PartPicker>
            }
        </div>
        @if (costumes.Count == 0)
        {
            <p class="mt-3 text-xs @Css.Muted">@string.Format(Localizer["{0}'s item names aren't on this server, so items show their number."], GameName)</p>
        }
        @if (settings.Capabilities.SupportsColors && custom.Colors is not null)
        {
            <div class="mt-6 space-y-2">
                <ColorRow Label="@Localizer["Body Color"]" Value="f.Body" ValueChanged="v => Set(x => x.Body = v)" />
                <ColorRow Label="@Localizer["Face Color"]" Value="f.Face" ValueChanged="v => Set(x => x.Face = v)" />
                <ColorRow Label="@Localizer["Limb Color"]" Value="f.Limb" ValueChanged="v => Set(x => x.Limb = v)" />
            </div>
        }
    };

    private RenderFragment SongSection => __builder =>
    {
        var f = form!;
        var caps = settings!.Capabilities;
        <div class="grid gap-4 sm:grid-cols-2">
            @if (caps.SupportsTone && settings.Customization?.Tone is { } tone)
            {
                <PartPicker Label="@Localizer["Drum sound"]" Ids="@Choices(tone.UnlockedToneIds, tone.ToneId, tones.Keys)" NameOf="ToneName"
                            Value="f.ToneId" ValueChanged="v => Set(x => x.ToneId = v)" />
            }
            @if (caps.SupportsLocalRankingDifficulty)
            {
                <SelectField Label="@Localizer["Local ranking difficulty"]" Options="@DifficultyNames" Value="f.RankingDifficulty" ValueChanged="v => Set(x => x.RankingDifficulty = v)" />
            }
            @if (caps.SupportsDefaultSelectedSelfBestDifficulty)
            {
                <SelectField Label="@Localizer["Default difficulty"]" Options="@DifficultyNames" Value="f.DefaultDifficulty" ValueChanged="v => Set(x => x.DefaultDifficulty = v)" />
            }
            @if (caps.SupportsTaikojukuFolderDan && settings.Options.Taikojuku is { } juku)
            {
                var dans = juku.SelectableFolderDans.Append(juku.FolderDan).Distinct().Order().ToList();
                <SelectField Label="@Localizer["Taikojuku folder dan"]" Options="@dans.Select(d => d.ToString()).ToList()"
                             Value="(uint)dans.IndexOf(f.FolderDan)" ValueChanged="v => Set(x => x.FolderDan = dans[(int)v])" />
            }
        </div>
    };

    private static bool HasSongOptions(Ac15ProfileCapabilitiesDto c) =>
        c.SupportsTone || c.SupportsLocalRankingDifficulty || c.SupportsDefaultSelectedSelfBestDifficulty || c.SupportsTaikojukuFolderDan;

    // What the card shows: this game's profile on the player's card look.
    private UserSetting CardSetting
    {
        get
        {
            var f = form!;
            return new UserSetting
            {
                MyDonName = f.Name, MyDonNameLanguage = f.Language, Title = f.TitleText,
                Kigurumi = f.Slots.GetValueOrDefault("kigurumi"), Head = f.Slots.GetValueOrDefault("head"), Body = f.Slots.GetValueOrDefault("body"),
                Face = f.Slots.GetValueOrDefault("face"), Puchi = f.Slots.GetValueOrDefault("puchi"),
                BodyColor = f.Body, FaceColor = f.Face, LimbColor = f.Limb,
                CardColor = look.CardColor, CardPattern = look.CardPattern, CardFade = look.CardFade, CardAnimation = look.CardAnimation,
            };
        }
    }

    private void Reset()
    {
        var s = settings!;
        var c = s.Customization;
        form = new Form
        {
            Name = s.Identity.MyDonName, Language = s.Identity.MyDonNameLanguage,
            TitleId = c?.Title?.TitleId ?? 0, TitleText = c?.Title?.TitleText ?? "", ToneId = c?.Tone?.ToneId ?? 0,
            Body = c?.Colors?.BodyColor ?? 0, Face = c?.Colors?.FaceColor ?? 0, Limb = c?.Colors?.LimbColor ?? 0,
            Slots = c?.CostumeSlots.ToDictionary(x => x.Slot, x => x.CurrentId) ?? [],
            DanOnPlate = s.Options.NamePlate?.DisplayDanOnNamePlate ?? false, FolderClose = s.Options.Folder?.ShowFolderCloseButton ?? false,
            SkipHowTo = s.Options.Tutorials?.DisableHowToPlayTutorial ?? false, AutoCostume = s.Options.CustomizationBehavior?.ApplyCostumeChangesFromPlayResults ?? false,
            RankingDifficulty = s.Options.SongSelect?.LocalRankingDifficulty ?? 0, DefaultDifficulty = s.Options.SongSelect?.DefaultSelectedAndSelfBestDifficulty ?? 0,
            FolderDan = s.Options.Taikojuku?.FolderDan ?? 0,
        };
        saved = JsonSerializer.Serialize(Update());
        savedCard = JsonSerializer.Serialize(Card());
    }

    // Only what the game has is sent. With free editing the unlocks go too, so the pick is unlocked in the game.
    private Ac15ProfileSettingsUpdateDto Update()
    {
        var s = settings!;
        var caps = s.Capabilities;
        var f = form!;
        return new(
            new Ac15ProfileIdentityDto(f.Name, f.Language),
            s.Customization is null ? null : new Ac15CustomizationUpdateDto(
                f.Slots.Select(x => new Ac15CostumeSlotUpdateDto(x.Key, x.Value, FreeEdit ? s.Customization.CostumeSlots.First(c => c.Slot == x.Key).UnlockedIds : null)).ToList(),
                caps.SupportsTitle && s.Customization.Title is not null ? new Ac15TitleSelectionUpdateDto(f.TitleText, f.TitleId, FreeEdit ? s.Customization.Title.UnlockedTitleIds : null) : null,
                caps.SupportsTone && s.Customization.Tone is not null ? new Ac15ToneSelectionUpdateDto(f.ToneId, FreeEdit ? s.Customization.Tone.UnlockedToneIds : null) : null,
                caps.SupportsColors && s.Customization.Colors is not null ? new Ac15CostumeColorsDto(f.Body, f.Face, f.Limb) : null),
            new Ac15ProfileOptionGroupsUpdateDto(
                caps.SupportsDisplayDanOnNamePlate ? new Ac15NamePlateOptionsDto(f.DanOnPlate) : null,
                caps.SupportsFolderCloseButton ? new Ac15FolderOptionsDto(f.FolderClose) : null,
                caps.SupportsLocalRankingDifficulty || caps.SupportsDefaultSelectedSelfBestDifficulty
                    ? new Ac15SongSelectOptionsDto(caps.SupportsLocalRankingDifficulty ? f.RankingDifficulty : null, caps.SupportsDefaultSelectedSelfBestDifficulty ? f.DefaultDifficulty : null)
                    : null,
                caps.SupportsTaikojukuFolderDan && s.Options.Taikojuku is not null ? new Ac15TaikojukuFolderDanUpdateDto(f.FolderDan) : null,
                caps.SupportsHowToPlayTutorialFlag ? new Ac15TutorialOptionsDto(f.SkipHowTo) : null,
                caps.SupportsAutoCostume ? new Ac15CustomizationBehaviorOptionsDto(f.AutoCostume) : null));
    }

    private CardLook Card() => new() { Color = look.CardColor, Pattern = look.CardPattern, Fade = look.CardFade, Animation = look.CardAnimation };

    private void Set(Action<Form> change)
    {
        change(form!);
        Changed();
    }

    private void CardChanged() => Changed();

    private void Changed()
    {
        Page.SetSave(PageState.SaveStatus.Saving);
        saveDelay?.Cancel();
        saveDelay = new CancellationTokenSource();
        _ = SaveSoon(saveDelay.Token);
    }

    private async Task SaveSoon(CancellationToken token)
    {
        try { await Task.Delay(700, token); }
        catch (TaskCanceledException) { return; }
        var error = await SaveChanges();
        Page.SetSave(error is null ? PageState.SaveStatus.Saved : PageState.SaveStatus.Idle);
        if (error is not null) Toast.Show(error, isError: true);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Saves the profile and the card if they changed; null when all went, else the message to show.</summary>
    private async Task<string?> SaveChanges()
    {
        try
        {
            var update = Update();
            if (JsonSerializer.Serialize(update) is var now && now != saved)
            {
                var res = await Client.PutAsJsonAsync($"api/{GameName}/Ac15ProfileSettings/{Baid}", update, CancellationToken.None);
                if (!res.IsSuccessStatusCode)
                    return await res.Content.ReadAsStringAsync() is { Length: > 0 and < 200 } m ? m : Localizer["Couldn't save your changes."];
                saved = now;
            }
            var card = Card();
            if (JsonSerializer.Serialize(card) is var nowCard && nowCard != savedCard)
            {
                var res = await Client.PutAsJsonAsync($"api/Users/{Baid}/Card", card, CancellationToken.None);
                if (!res.IsSuccessStatusCode) return Localizer["Couldn't save your changes."];
                savedCard = nowCard;
            }
            return null;
        }
        catch (HttpRequestException)
        {
            return Localizer["Couldn't save your changes."];
        }
    }

    // Leaving mid-debounce: save now rather than drop the last edit.
    public void Dispose()
    {
        if (saveDelay is null || saveDelay.IsCancellationRequested || Page.Save != PageState.SaveStatus.Saving) return;
        saveDelay.Cancel();
        _ = SaveChanges();
    }

    // As Nijiiro's profile: Free profile editing (or an admin, or Local mode) offers every piece, not only those unlocked.
    private bool FreeEdit => AuthService.AllowFreeProfileEditing || AuthService.IsAdmin || !AuthService.LoginRequired;

    private List<uint> Choices(IEnumerable<uint> unlocked, uint current, IEnumerable<uint> all) =>
        (FreeEdit ? unlocked.Concat(all) : unlocked).Append(current).Distinct().Order().ToList();

    // The title picker lists the game's titles that may be picked (every one with free editing, else the unlocked ones).
    private List<Title> TitleChoices(Ac15TitleSelectionDto title) =>
        Choices(title.UnlockedTitleIds, title.TitleId, titles.Keys).Select(id => titles.GetValueOrDefault(id)).OfType<Title>().ToList();

    private void PickTitle((string Title, Title? Picked) pick)
    {
        titlesOpen = false;
        if (pick.Picked is not { } t) return;
        Set(f => (f.TitleId, f.TitleText) = (t.TitleId, pick.Title));
    }

    private static string Name(string jp, string en) => en.Length > 0 ? en : jp;

    private string ToneName(uint id) => tones.TryGetValue(id, out var t) && Name(t.NeiroName, t.NeiroNameEN) is { Length: > 0 } n ? n : string.Format(Localizer["Drum sound {0}"], id);

    private string CostumeName(string slot, uint id) => slot == "kigurumi" && id == 0 ? Localizer["None (use head & body)"]
        : costumes.FirstOrDefault(c => c.CostumeType == slot && c.CostumeId == id) is { } c && Name(c.CostumeName, c.CostumeNameEN) is { Length: > 0 } n ? n : $"{SlotLabel(slot)} {id}";

    private string SlotLabel(string slot) => slot switch
    {
        "kigurumi" => Localizer["Kigurumi"], "head" => Localizer["Head"], "body" => Localizer["Body"], "face" => Localizer["Face paint"], "puchi" => Localizer["Puchi"], _ => slot,
    };

    private List<string> Missing(Ac15ProfileCapabilitiesDto c) =>
    [
        .. c.SupportsTitlePlate ? Array.Empty<string>() : [Localizer["title plates"]],
        .. c.SupportsTaikojukuFolderDan ? Array.Empty<string>() : [Localizer["the Taikojuku folder"]],
        .. c.SupportsFolderCloseButton ? Array.Empty<string>() : [Localizer["the folder close button"]],
        .. c.SupportsAutoCostume ? Array.Empty<string>() : [Localizer["wearing new items"]],
    ];
}
