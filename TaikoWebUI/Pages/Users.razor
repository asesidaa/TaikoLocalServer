@page "/Users"
@attribute [Authorize(Policy = AuthPolicies.Admin)]
@inject HttpClient Client
@inject PageState Page

<PageTitle>Users</PageTitle>
<ComingSoon Title="@Localizer["Users"]" IconName="users">
    @* Until Users is redesigned: a plain way to reach each user's pages. *@
    @if (users is null)
    {
        <p class="mt-6 text-sm @Css.Muted">@Localizer["Loading..."]</p>
    }
    else
    {
        <ul class="mx-auto mt-6 max-w-md divide-y divide-zinc-100 text-left dark:divide-zinc-800">
            @foreach (var user in users)
            {
                <li class="flex items-center justify-between gap-3 py-2 text-sm">
                    <span class="min-w-0 truncate"><span class="font-medium">@user.UserSetting.MyDonName</span> <span class="@Css.Muted">· Baid @user.Baid</span></span>
                    <a href="@($"/Users/{user.Baid}/Profile")" class="@Css.Link shrink-0">@Localizer["Profile"]</a>
                </li>
            }
        </ul>
    }
</ComingSoon>

@code {
    private List<User>? users;

    protected override async Task OnInitializedAsync()
    {
        Page.Set(Localizer["Users"]);
        users = (await Client.GetFromJsonAsync<UsersResponse>("api/Users?page=1&limit=200"))?.Users ?? [];
    }
}
