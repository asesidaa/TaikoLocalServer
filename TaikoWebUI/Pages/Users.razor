@page "/Users"
@attribute [Authorize(Policy = AuthPolicies.Admin)]
@using TaikoWebUI.Components.Admin
@inject HttpClient Client
@inject PageState Page
@inject AuthService AuthService

<PageTitle>User Management</PageTitle>
@* Inspector: a sticky searchable list on the left, everything about the picked user on the right.
   Phones: the list moves into a picker above the user (PhonePicker). *@
<div class="grid gap-4 lg:grid-cols-[320px_minmax(0,1fr)] lg:items-start">
    <div class="@Css.Card hidden p-3 lg:sticky lg:top-24 lg:block">@List(false)</div>
    <div class="min-w-0">
        @if (selected is { } current)
        {
            <PhonePicker @bind-Open="picking" Label="@Localizer["Find a user"]">
                <Summary>
                    <Avatar Setting="current.UserSetting" Size="36" />
                    <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-medium">@current.UserSetting.MyDonName</span>
                        <span class="block truncate text-xs @Css.Muted">@Localizer["User ID"] @current.Baid · @Localizer["tap to switch user"]</span>
                    </span>
                </Summary>
                <ChildContent>@List(true)</ChildContent>
            </PhonePicker>
        }
        <div class="@Css.Card">
            @if (selected is null)
            {
                <div class="grid place-items-center p-10 text-sm @Css.Muted">@Localizer[data is { TotalUsers: 0 } && query.Length == 0 && filter == "all" ? "No users yet. A user appears the first time a card is played." : "Pick a user"]</div>
            }
            else
            {
                <UserDetail User="selected" OnChanged="Reload" OnDeleted="OnDeleted" />
            }
        </div>
    </div>
</div>

@code {
    private bool picking;

    // The search, filters and rows: in the desktop side card, and in the phone picker (its own search box, so focus stays).
    private RenderFragment List(bool phone) => __builder =>
    {
        <label class="relative block">
            <span class="sr-only">@Localizer["Search users"]</span>
            <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400"><Icon Name="search" /></span>
            <input type="search" value="@query" placeholder="@Localizer["Name, user ID or access code"]" class="@Css.Input pl-9"
                   @oninput="e => { query = e.Value?.ToString() ?? string.Empty; return Load(1); }" />
        </label>
        if (AuthService.LoginRequired)
        {
            <div class="mt-2 flex flex-wrap gap-1" role="radiogroup" aria-label="@Localizer["Filter users"]">
                @foreach (var (key, label) in Filters)
                {
                    var on = filter == key;
                    <button role="radio" aria-checked="@Css.Aria(on)" @onclick="() => { filter = key; return Load(1); }"
                            class="rounded-full px-2.5 py-1 text-xs font-medium @Css.Pill(on)">@label</button>
                }
            </div>
        }
        <ul class="mt-2 @(phone ? "max-h-[55dvh]" : "max-h-[calc(100dvh-16rem)]") space-y-0.5 overflow-y-auto">
            @if (data is null)
            {
                <li class="px-3 py-3"><Skeleton Rows="8" /></li>
            }
            else
            {
                var list = data.Users;
                if (list.Count == 0)
                {
                    <li class="px-3 py-6 text-center text-sm @Css.Muted">@Localizer["No matches"]</li>
                }
                foreach (var u in list)
                {
                    var on = u.Baid == selected?.Baid;
                    <li>
                        <button aria-current="@(on ? "true" : null)" @onclick="() => { selected = u; picking = false; }"
                                class="flex w-full items-center gap-3 rounded-xl px-2.5 py-2 text-left @(on ? "bg-primary-500/10" : "hover:bg-zinc-100 dark:hover:bg-zinc-800/60")">
                            <Avatar Setting="u.UserSetting" Size="40" />
                            <span class="min-w-0 flex-1">
                                <span class="block truncate text-sm font-medium">@u.UserSetting.MyDonName</span>
                                <span class="block truncate text-xs @Css.Muted">@Localizer["User ID"] @u.Baid · @LastPlayed(u)</span>
                            </span>
                            @if (AuthService.LoginRequired && !u.IsRegistered)
                            {
                                <span class="size-2 rounded-full bg-amber-400" title="@Localizer["Not registered"]"></span>
                            }
                            @if (AuthService.LoginRequired && u.IsAdmin)
                            {
                                <span class="text-primary-600 dark:text-primary-400" title="@Localizer["Admin"]"><Icon Name="crown" Class="size-3.5" /></span>
                            }
                        </button>
                    </li>
                }
            }
        </ul>
        if (data is { TotalPages: > 1 })
        {
            <div class="mt-2 flex flex-wrap items-center justify-between gap-2 border-t border-zinc-100 pt-2 dark:border-zinc-800">
                <span class="text-xs tabular-nums @Css.Muted">@string.Format(Localizer["{0}–{1} of {2}"], ((data.Page - 1) * PageSize + 1).ToString("N0"), Math.Min(data.Page * PageSize, data.TotalUsers).ToString("N0"), data.TotalUsers.ToString("N0"))</span>
                <Pager Current="data.Page" Total="data.TotalPages" OnPage="Load" Label="@Localizer["User pages"]" />
            </div>
        }
    };

    private const int PageSize = 50;
    private UsersResponse? data;
    private User? selected;
    private int request;
    private string query = "";
    private string filter = "all";

    private (string Key, string Label)[] Filters =>
        [("all", Localizer["All"]), ("registered", Localizer["Registered"]), ("unregistered", Localizer["Not registered"]), ("admins", Localizer["Admins"])];

    protected override async Task OnInitializedAsync()
    {
        Page.Set(Localizer["Admin"], Localizer["User Management"]);
        await Reload();
    }

    // One page, searched and filtered on the server, so thousands of users cost one page.
    private async Task Load(int page)
    {
        var mine = ++request;
        var filterArg = AuthService.LoginRequired ? filter : "all";
        var result = await Client.GetFromJsonAsync<UsersResponse>(
            $"api/Users?page={page}&limit={PageSize}&searchTerm={Uri.EscapeDataString(query.Trim())}&filter={filterArg}");
        if (mine != request) return;
        data = result;
        selected ??= data?.Users.FirstOrDefault();
    }

    // After a change: the same page again, and the picked user fresh even when they're no longer on it.
    private async Task Reload()
    {
        await Load(data?.Page ?? 1);
        if (selected is not { } s) return;
        selected = data?.Users.FirstOrDefault(u => u.Baid == s.Baid)
                   ?? (await Client.GetFromJsonAsync<UsersResponse>($"api/Users?limit=200&searchTerm={s.Baid}"))?.Users.FirstOrDefault(u => u.Baid == s.Baid)
                   ?? s;
    }

    private async Task OnDeleted()
    {
        selected = null;
        await Load(data?.Page ?? 1);
    }

    private string LastPlayed(User u)
    {
        var t = u.UserSetting.LastPlayDateTime;
        if (t == default) return Localizer["Never"];
        var days = (int)(DateTime.Now - t).TotalDays;
        return days <= 0 ? Localizer["Today"] : days == 1 ? Localizer["Yesterday"] : days < 30 ? string.Format(Localizer["{0} days ago"], days) : t.ToString("d");
    }
}
