@page "/Users/{baid:int}/HighScores"
@attribute [Authorize]
@inject PageState Page

<PageTitle>HighScores</PageTitle>
<ComingSoon Title="@(Localizer["High Scores"])" IconName="highScores" />

@code {
    [Parameter] public int Baid { get; set; }

    protected override void OnInitialized() => Page.Set(Localizer["Play Data"], Localizer["High Scores"]);
}
