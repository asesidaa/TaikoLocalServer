@page "/Admin/Access"
@page "/Admin/Access/{Tab}"
@attribute [Authorize(Policy = AuthPolicies.Admin)]
@inject NavigationManager Nav
@inject PageState Page
@inject HttpClient Client
@inject AuthService AuthService
@inject ToastService Toast
@using TaikoWebUI.Components.Admin

<PageTitle>Access</PageTitle>
@if (!AuthService.LoginRequired)
{
    @* Local mode has no accounts, so there is nothing to control access to. *@
    <div class="@Css.Card p-6 text-sm @Css.Muted">@Localizer["Access Local Mode"]</div>
}
else
{
    <Tabs Items="tabs" Selected="@Current" SelectedChanged="Go" Label="@Localizer["Access"]"
          Columns="sm:grid-cols-3 xl:grid-cols-6" />
    <div class="mt-4" role="tabpanel">
        @if (Current == "overview")
        {
            @Overview
        }
        else if (Current == "activity")
        {
            @ActivityLog
        }
        else if (Current == "bans")
        {
            <BansTab />
        }
        else if (Current == "signins")
        {
            <SignInsTab />
        }
        else if (Current == "sessions")
        {
            <SessionsTab />
        }
        else if (Current == "tokens")
        {
            <ApiTokensTab />
        }
        else
        {
            var t = tabs.First(x => x.Id == Current);
            <ComingSoon Title="@t.Label" IconName="@t.Icon" />
        }
    </div>
}

@code {
    [Parameter] public string? Tab { get; set; }

    private IReadOnlyList<(string Id, string Label, string Icon)> tabs = [];
    private AccessRulesSettings? saved, draft;
    private bool saving;

    private string Current => tabs.Any(x => x.Id == Tab?.ToLowerInvariant()) ? Tab!.ToLowerInvariant() : "overview";

    private bool Changed => saved is not null && draft is not null &&
        (saved.OnlyAdmin, saved.SignUpMode, saved.AllowUserDelete, saved.AllowFreeProfileEditing, saved.AccessCodeLimit, saved.LockoutAttempts, saved.LockoutMinutes, saved.TwoFactor) !=
        (draft.OnlyAdmin, draft.SignUpMode, draft.AllowUserDelete, draft.AllowFreeProfileEditing, draft.AccessCodeLimit, draft.LockoutAttempts, draft.LockoutMinutes, draft.TwoFactor);

    protected override async Task OnInitializedAsync()
    {
        tabs =
        [
            ("overview", Localizer["Overview"], "shield"),
            ("bans", Localizer["Banned cards"], "ban"),
            ("signins", Localizer["Sign-ins"], "logIn"),
            ("sessions", Localizer["Sessions"], "laptop"),
            ("tokens", Localizer["API tokens"], "key"),
            ("activity", Localizer["Activity"], "list"),
        ];
        Page.Set(Localizer["Admin"], Localizer["Access"]);
        if (!AuthService.LoginRequired) return;
        saved = await Client.GetFromJsonAsync<AccessRulesSettings>("api/AccessRules");
        checklist = await Client.GetFromJsonAsync<List<ChecklistItem>>("api/Checklist");
        draft = Copy(saved);
    }

    private void Go(string id) => Nav.NavigateTo($"/Admin/Access/{id}");

    // ---- Activity: newest first, 50 at a time ----
    private List<ActivityItem>? activity;
    private long? activityNext;
    private bool activityLoading;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthService.LoginRequired && Current == "activity" && activity is null)
            await LoadActivity();
    }

    private async Task LoadActivity()
    {
        activityLoading = true;
        var page = await Client.GetFromJsonAsync<ActivityResponse>(activityNext is { } b ? $"api/Activity?before={b}" : "api/Activity");
        activity = [.. activity ?? [], .. page?.Items ?? []];
        activityNext = page?.NextBefore;
        activityLoading = false;
    }

    private string ActionText(string action) => action switch
    {
        "user.promote" => Localizer["Made admin"],
        "user.demote" => Localizer["Removed admin"],
        "score.remove" => Localizer["Removed a score"],
        "card.move" => Localizer["Moved an access code"],
        _ => action,
    };

    private string Who(uint? baid, string? name) =>
        baid is null ? Localizer["Server"] : string.IsNullOrEmpty(name) ? $"Baid {baid}" : name;

    private RenderFragment ActivityLog => __builder =>
    {
        <section class="@Css.Card p-5 sm:p-6">
            <h2 class="font-semibold">@Localizer["Activity"]</h2>
            <p class="text-sm @Css.Muted">@Localizer["Activity Hint"]</p>
            @if (activity is null)
            {
                <p class="mt-4 text-sm @Css.Muted">@Localizer["Loading..."]</p>
            }
            else if (activity.Count == 0)
            {
                <p class="mt-4 text-sm @Css.Muted">@Localizer["Nothing yet."]</p>
            }
            else
            {
                <ul class="mt-3 divide-y divide-zinc-100 dark:divide-zinc-800">
                    @foreach (var e in activity)
                    {
                        <li class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 py-2.5 text-sm">
                            <span class="font-medium">@Who(e.ActorBaid, e.ActorName)</span>
                            <span>@ActionText(e.Action)@(e.TargetBaid is null ? "" : $" · {Who(e.TargetBaid, e.TargetName)}")</span>
                            @if (e.Detail.Length > 0)
                            {
                                <span class="whitespace-nowrap @Css.Muted">@e.Detail</span>
                            }
                            <time class="ml-auto whitespace-nowrap text-xs tabular-nums @Css.Muted" datetime="@e.Time.ToString("O")">@e.Time.ToLocalTime().ToString("g")</time>
                        </li>
                    }
                </ul>
                @if (activityNext is not null)
                {
                    <div class="mt-3 text-center">
                        <button class="@Css.GhostButton" disabled="@activityLoading" @onclick="LoadActivity">@Localizer["Show older"]</button>
                    </div>
                }
            }
        </section>
    };

    private static AccessRulesSettings? Copy(AccessRulesSettings? r) => r is null ? null : new()
    {
        OnlyAdmin = r.OnlyAdmin, SignUpMode = r.SignUpMode, AllowUserDelete = r.AllowUserDelete,
        AllowFreeProfileEditing = r.AllowFreeProfileEditing, AccessCodeLimit = r.AccessCodeLimit,
        LockoutAttempts = r.LockoutAttempts, LockoutMinutes = r.LockoutMinutes, TwoFactor = r.TwoFactor,
    };

    private async Task Save()
    {
        saving = true;
        // The player rules are edited on Server Management › Settings: keep their current values.
        var current = await Client.GetFromJsonAsync<AccessRulesSettings>("api/AccessRules");
        if (current is not null)
            (draft!.AllowUserDelete, draft.AllowFreeProfileEditing, draft.AccessCodeLimit) = (current.AllowUserDelete, current.AllowFreeProfileEditing, current.AccessCodeLimit);
        var res = current is null ? null : await Client.PutAsJsonAsync("api/AccessRules", draft);
        saving = false;
        if (res is not { IsSuccessStatusCode: true })
        {
            Toast.Show(Localizer["Save Failed"], true);
            return;
        }
        saved = Copy(draft);
        checklist = await Client.GetFromJsonAsync<List<ChecklistItem>>("api/Checklist");
        Toast.Show(Localizer["Saved"]);
    }

    private (SignUpMode Mode, string Label, string Hint)[] SignUpModes =>
    [
        (SignUpMode.Open, Localizer["Open"], Localizer["Anyone with a card's access code."]),
        (SignUpMode.LastPlayTime, Localizer["Last play time"], Localizer["They prove the card with when they last played it, or an invite code."]),
        (SignUpMode.InviteOnly, Localizer["Invite code only"], Localizer["Only with an invite code from an admin (User Management)."]),
        (SignUpMode.Closed, Localizer["Closed"], Localizer["No new accounts. Admins can still help in User Management."]),
    ];

    private List<ChecklistItem>? checklist;

    private RenderFragment Overview => __builder =>
    {
        if (draft is null)
        {
            <p class="text-sm @Css.Muted">@Localizer["Loading..."]</p>
            return;
        }
        if (checklist is { Count: > 0 })
        {
            var toFix = checklist.Count(c => c.Level == ChecklistLevel.Problem);
            var warnings = checklist.Count(c => c.Level == ChecklistLevel.Warning);
            <section class="@Css.Card mb-4 p-5 sm:p-6">
                <h2 class="font-semibold">@Localizer["Checklist"]</h2>
                <p class="text-sm @Css.Muted">@(toFix + warnings == 0 ? Localizer["Nothing to fix."] : string.Format(Localizer["{0} to fix, {1} warnings"], toFix, warnings))</p>
                <ul class="mt-3 space-y-2">
                    @foreach (var c in checklist)
                    {
                        <li class="flex items-start gap-3 rounded-xl border px-3 py-2.5 text-sm @(c.Level switch { ChecklistLevel.Problem => "border-red-500/30 bg-red-500/5", ChecklistLevel.Warning => "border-amber-500/30 bg-amber-500/5", _ => "border-zinc-200 dark:border-zinc-700" })">
                            <Icon Name="@(c.Level == ChecklistLevel.Ok ? "check" : "alert")" Class="@(c.Level switch { ChecklistLevel.Problem => "mt-0.5 size-4 text-red-500", ChecklistLevel.Warning => "mt-0.5 size-4 text-amber-500", _ => "mt-0.5 size-4 text-emerald-500" })" />
                            <span class="min-w-0"><span class="block font-medium">@c.Title</span><span class="block text-xs @Css.Muted">@c.Detail</span></span>
                        </li>
                    }
                </ul>
            </section>
        }
        <section class="@Css.Card p-5 sm:p-6">
            <h2 class="font-semibold">@Localizer["Sign-up and sign-in"]</h2>
            <p class="text-sm @Css.Muted">@Localizer["Access Rules Hint"]</p>
            <p class="mt-4 text-sm font-medium">@Localizer["Who can sign up"]</p>
            <div class="mt-2 grid gap-2 sm:grid-cols-2" role="radiogroup" aria-label="@Localizer["Who can sign up"]">
                @foreach (var (mode, label, hint) in SignUpModes)
                {
                    var on = draft.SignUpMode == mode;
                    <button role="radio" aria-checked="@Css.Aria(on)" @onclick="() => draft.SignUpMode = mode"
                            class="rounded-xl border p-3 text-left transition-colors @(on ? "border-primary-500 bg-primary-500/5 ring-1 ring-primary-500" : "border-zinc-200 hover:border-zinc-300 dark:border-zinc-700 dark:hover:border-zinc-600")">
                        <span class="block text-sm font-medium">@label</span>
                        <span class="mt-0.5 block text-xs @Css.Muted">@hint</span>
                    </button>
                }
            </div>
            <div class="mt-3 divide-y divide-zinc-100 dark:divide-zinc-800">
                <Toggle Label="@Localizer["Only admins can sign in"]" Icon="lock" @bind-Value="draft.OnlyAdmin" />
                <div class="flex flex-wrap items-center gap-3 py-2">
                    <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-zinc-100 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400"><Icon Name="lock" Class="size-5" /></span>
                    <span class="min-w-0 flex-1 text-sm font-medium">@Localizer["Lock an account after failed sign-ins"]</span>
                    <select class="@Css.Input !w-auto !py-1.5" aria-label="@Localizer["Failed sign-ins"]" @bind="draft.LockoutAttempts">
                        <option value="5">@string.Format(Localizer["{0} tries"], 5)</option>
                        <option value="10">@string.Format(Localizer["{0} tries"], 10)</option>
                        <option value="20">@string.Format(Localizer["{0} tries"], 20)</option>
                    </select>
                    <select class="@Css.Input !w-auto !py-1.5" aria-label="@Localizer["Locked for"]" @bind="draft.LockoutMinutes">
                        <option value="15">@Localizer["for 15 min"]</option>
                        <option value="60">@Localizer["for 1 hour"]</option>
                        <option value="1440">@Localizer["for 1 day"]</option>
                    </select>
                </div>
                <div class="flex flex-wrap items-center gap-3 py-2">
                    <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-zinc-100 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400"><Icon Name="shield" Class="size-5" /></span>
                    <span class="min-w-0 flex-1">
                        <span class="block text-sm font-medium">@Localizer["2-step verification"]</span>
                        <span class="block text-xs @Css.Muted">@Localizer["An authenticator app code after the password. Admins who must use it get admin access once they turn it on."]</span>
                    </span>
                    <select class="@Css.Input !w-auto !py-1.5" aria-label="@Localizer["2-step verification"]" @bind="draft.TwoFactor">
                        <option value="@TwoFactorMode.Off">@Localizer["Off"]</option>
                        <option value="@TwoFactorMode.Optional">@Localizer["Optional"]</option>
                        <option value="@TwoFactorMode.RequiredForAdmins">@Localizer["Required for admins"]</option>
                    </select>
                </div>
            </div>
            <p class="mt-3 text-xs @Css.Muted">@((MarkupString)string.Format(Localizer["Player Rules Moved Hint"], $"<a class=\"underline\" href=\"/Admin/Server/settings\">{Localizer["Server Management"]} › {Localizer["Settings"]}</a>"))</p>
            <div class="mt-4 flex justify-end gap-2">
                @if (Changed)
                {
                    <button class="@Css.GhostButton" @onclick="() => draft = Copy(saved)">@Localizer["Cancel"]</button>
                }
                <button class="@Css.PrimaryButton" disabled="@(!Changed || saving)" @onclick="Save">@Localizer["Save"]</button>
            </div>
        </section>
    };
}
