@using System.Linq
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject IDialogService DialogService

@if (Catalog.Count > 0)
{
    <MudStack Spacing="2">
        <MudStack Spacing="0">
            <MudText Typo="Typo.caption" Class="picker-activator-label">@Label</MudText>
            <MudButton Variant="Variant.Outlined"
                       FullWidth="true"
                       Disabled="@ReadOnly"
                       OnClick="OpenPicker"
                       EndIcon="@Icons.Material.Filled.ArrowDropDown"
                       Class="picker-activator-button">
                @DisplayNameById(Value.CurrentId)
            </MudButton>
        </MudStack>

        @if (AllowUnlockEditing)
        {
            <MudExpansionPanels Elevation="0" Outlined="true">
                <MudExpansionPanel Text="@Localizer["Unlocked"]" Expanded="@unlockPanelExpanded" ExpandedChanged="SetUnlockPanelExpanded">
                    @if (unlockPanelExpanded)
                    {
                        <div class="picker-unlock-list" tabindex="-1">
                            <Virtualize Items="orderedCatalog" Context="costume" ItemSize="40">
                                <MudCheckBox T="bool"
                                             Value="@unlockedIds.Contains(costume.CostumeId)"
                                             ValueChanged="@(value => ToggleUnlocked(costume.CostumeId, value))"
                                             Label="@DisplayName(costume)" />
                            </Virtualize>
                        </div>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </MudStack>
}

@code {
    [Parameter] public string Era { get; set; } = string.Empty;
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<Costume> Catalog { get; set; } = [];
    [Parameter] public CostumePickerValue Value { get; set; } = new(0, []);
    [Parameter] public EventCallback<CostumePickerValue> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool AllowUnlockEditing { get; set; }

    private Costume[] orderedCatalog = [];
    private uint[] orderedIds = [];
    private Dictionary<uint, Costume> costumeById = [];
    private HashSet<uint> unlockedIds = [];
    private bool unlockPanelExpanded;

    protected override void OnParametersSet()
    {
        orderedCatalog = Catalog
            .OrderBy(costume => costume.CostumeType == "unknown" ? 1 : 0)
            .ThenBy(costume => costume.CostumeId)
            .ToArray();
        orderedIds = orderedCatalog.Select(costume => costume.CostumeId).ToArray();
        costumeById = orderedCatalog.ToDictionary(costume => costume.CostumeId);
        unlockedIds = Value.UnlockedIds.ToHashSet();
    }

    private async Task OpenPicker()
    {
        var parameters = new DialogParameters
        {
            ["Items"] = (IReadOnlyList<uint>)orderedIds,
            ["Label"] = (Func<uint, string>)DisplayNameById,
            ["SelectedId"] = Value.CurrentId
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<IdPickerDialog>(Label, parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not uint id)
        {
            return;
        }

        await SetCurrent(id);
    }

    private async Task SetCurrent(uint id)
    {
        var unlocked = unlockedIds.Contains(id)
            ? Value.UnlockedIds
            : Value.UnlockedIds.Append(id).Distinct().OrderBy(value => value).ToArray();
        await ValueChanged.InvokeAsync(Value with { CurrentId = id, UnlockedIds = unlocked });
    }

    private async Task ToggleUnlocked(uint id, bool enabled)
    {
        var unlocked = enabled
            ? Value.UnlockedIds.Append(id)
            : Value.UnlockedIds.Where(value => value != id);
        var normalized = unlocked.Append(0u).Distinct().OrderBy(value => value).ToArray();
        var current = normalized.Contains(Value.CurrentId) ? Value.CurrentId : 0;
        await ValueChanged.InvokeAsync(Value with { CurrentId = current, UnlockedIds = normalized });
    }

    private Task SetUnlockPanelExpanded(bool expanded)
    {
        unlockPanelExpanded = expanded;
        return Task.CompletedTask;
    }

    private string DisplayNameById(uint id)
        => costumeById.TryGetValue(id, out var costume) ? DisplayName(costume) : $"#{id:D3}";

    private static string DisplayName(Costume costume)
    {
        var name = string.IsNullOrWhiteSpace(costume.CostumeName)
            ? $"#{costume.CostumeId:D3}"
            : costume.CostumeName;
        return costume.CostumeType == "unknown"
            ? $"{costume.CostumeId} - {name} (Unsorted)"
            : $"{costume.CostumeId} - {name}";
    }
}
