@using System.Linq
@using Microsoft.AspNetCore.Components.Web.Virtualization

@if (Catalog.Count > 0 || !string.IsNullOrWhiteSpace(Value.Title) || Value.TitlePlateId != 0)
{
    <MudStack Spacing="3">
        <MudTextField T="string"
                      Value="Value.Title"
                      ValueChanged="SetTitle"
                      Label="@Localizer["Title"]"
                      ReadOnly="@TitleTextReadOnly" />

        <MudSelect T="uint"
                   Value="Value.TitlePlateId"
                   ValueChanged="SetPlate"
                   Label="@Localizer["Title Plate"]"
                   Disabled="@ReadOnly"
                   AnchorOrigin="Origin.BottomCenter">
            @foreach (var plate in plateIds)
            {
                <MudSelectItem Value="@plate">@FormatPlateOption(plate)</MudSelectItem>
            }
        </MudSelect>

        @if (AllowUnlockEditing)
        {
            <MudExpansionPanels Elevation="0" Outlined="true">
                <MudExpansionPanel Text="@Localizer["Player Titles"]" Expanded="@unlockPanelExpanded" ExpandedChanged="SetUnlockPanelExpanded">
                    @if (unlockPanelExpanded)
                    {
                        <div class="picker-unlock-list" tabindex="-1">
                            <Virtualize Items="orderedTitles" Context="title" ItemSize="40">
                                <MudCheckBox T="bool"
                                             Value="@unlockedTitleIds.Contains(title.TitleId)"
                                             ValueChanged="@(value => ToggleUnlocked(title.TitleId, value))"
                                             Label="@DisplayName(title)" />
                            </Virtualize>
                        </div>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </MudStack>
}

@code {
    [Parameter] public string Era { get; set; } = string.Empty;
    [Parameter] public IReadOnlyDictionary<uint, Title> Catalog { get; set; } = new Dictionary<uint, Title>();
    [Parameter] public TitlePickerValue Value { get; set; } = new(string.Empty, 0, []);
    [Parameter] public EventCallback<TitlePickerValue> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool ReadOnlyTitleText { get; set; }
    [Parameter] public bool AllowUnlockEditing { get; set; }
    [Parameter] public TitleSelectionMode SelectionMode { get; set; } = TitleSelectionMode.TitlePlate;

    private bool TitleTextReadOnly => ReadOnly || ReadOnlyTitleText;
    private bool SelectsCatalogTitle => SelectionMode == TitleSelectionMode.TitleId;

    private Title[] orderedTitles = [];
    private IReadOnlyList<uint> plateIds = [];
    private HashSet<uint> unlockedTitleIds = [];
    private bool unlockPanelExpanded;

    protected override void OnParametersSet()
    {
        orderedTitles = Catalog.Values.OrderBy(title => title.TitleId).ToArray();
        plateIds = TitlePickerCatalog.GetSelectableIds(Catalog, Value.TitlePlateId, SelectionMode);
        unlockedTitleIds = Value.UnlockedTitleIds.ToHashSet();
    }

    private Task SetTitle(string title)
        => TitleTextReadOnly
            ? Task.CompletedTask
            : ValueChanged.InvokeAsync(Value with { Title = title });

    private Task SetPlate(uint plate)
    {
        var next = Value with { TitlePlateId = plate };
        if (SelectsCatalogTitle)
        {
            next = next with
            {
                Title = TitlePickerCatalog.ResolveSelectedTitleText(Catalog, plate, Value.Title),
                UnlockedTitleIds = Value.UnlockedTitleIds
                    .Append(plate)
                    .Distinct()
                    .OrderBy(id => id)
                    .ToArray()
            };
        }

        return ValueChanged.InvokeAsync(next);
    }

    private Task ToggleUnlocked(uint id, bool enabled)
    {
        var ids = enabled
            ? Value.UnlockedTitleIds.Append(id)
            : Value.UnlockedTitleIds.Where(value => value != id);
        return ValueChanged.InvokeAsync(Value with { UnlockedTitleIds = ids.Distinct().OrderBy(value => value).ToArray() });
    }

    private Task SetUnlockPanelExpanded(bool expanded)
    {
        unlockPanelExpanded = expanded;
        return Task.CompletedTask;
    }

    private string FormatPlateOption(uint plate)
    {
        if (Catalog.TryGetValue(plate, out var title) && !string.IsNullOrWhiteSpace(title.TitleName))
        {
            return $"{plate} - {title.TitleName}";
        }

        return $"#{plate:D3}";
    }

    private static string DisplayName(Title title)
    {
        var name = string.IsNullOrWhiteSpace(title.TitleName)
            ? TitlePickerCatalog.DisplayTitleText(title)
            : title.TitleName;
        return $"{title.TitleId} - {name}";
    }
}
